{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gamedata.db"
  },
  "Jwt": {
    "Key": "YourSecretKeyForJWTTokenGenerationMustBeAtLeast32CharactersLong",
    "Issuer": "BlazorIdle.Server",
    "Audience": "BlazorIdle.Client"
  },
  "CharacterConfig": {
    "defaultMaxCharacterSlots": 3,
    "characterNameMinLength": 2,
    "characterNameMaxLength": 20
  }
}
