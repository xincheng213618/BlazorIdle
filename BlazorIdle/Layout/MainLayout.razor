@inherits LayoutComponentBase
@inject BlazorIdle.Services.BeforeUnloadService BeforeUnloadService
@implements IAsyncDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <UserBar />
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 初始化BeforeUnload服务，监听页面关闭事件
            // Initialize BeforeUnload service to listen for page close events
            await BeforeUnloadService.InitializeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // 清理BeforeUnload服务
        // Cleanup BeforeUnload service
        await BeforeUnloadService.DisposeAsync();
    }
}
