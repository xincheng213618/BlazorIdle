        {
            phase4Output += $"\n✗ 阶段四测试失败: {ex.Message}\n";
            phase4Output += $"堆栈: {ex.StackTrace}\n";
            Logger.LogError(ex, "Persistence test failed");
            phase4Status = "failed";
        }
        finally
        {
            isRunningPhase4 = false;
            StateHasChanged();
        }
    }

