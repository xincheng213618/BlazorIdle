@page "/test/dashboard"
@inject IProfessionAttributeService ProfessionAttributeService
@inject ICharacterAttributeService CharacterAttributeService
@inject ICharacterService CharacterService
@inject ILogger<TestDashboard> Logger
@using BlazorIdle.Services
@using BlazorIdle.Shared.Game
@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.Events

<PageTitle>功能测试面板</PageTitle>

<div class="test-dashboard">
    <div class="dashboard-header">
        <h2>🧪 BlazorIdle 功能测试面板</h2>
        <p>集成所有功能测试，方便统一测试各项功能</p>
    </div>

    <div class="test-sections">
        <!-- 阶段二测试：属性计算 -->
        <div class="test-section">
            <div class="section-header" @onclick="() => ToggleSection(1)">
                <h4>
                    <span class="toggle-icon">@(expandedSections.Contains(1) ? "▼" : "▶")</span>
                    阶段二：属性计算测试
                </h4>
                <span class="status-badge @(phase2Status)">@phase2Status</span>
            </div>
            
            @if (expandedSections.Contains(1))
            {
                <div class="section-content">
                    <div class="button-group">
                        <button class="btn btn-primary" @onclick="RunPhase2Tests" disabled="@isRunningPhase2">
                            @if (isRunningPhase2)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中...</span>
                            }
                            else
                            {
                                <span>运行阶段二测试</span>
                            }
                        </button>
                    </div>
                    <pre class="test-output">@phase2Output</pre>
                </div>
            }
        </div>

        <!-- 阶段三测试：触发集成 -->
        <div class="test-section">
            <div class="section-header" @onclick="() => ToggleSection(2)">
                <h4>
                    <span class="toggle-icon">@(expandedSections.Contains(2) ? "▼" : "▶")</span>
                    阶段三：触发集成测试
                </h4>
                <span class="status-badge @(phase3Status)">@phase3Status</span>
            </div>
            
            @if (expandedSections.Contains(2))
            {
                <div class="section-content">
                    <div class="button-group">
                        <button class="btn btn-success" @onclick="RunPhase3Tests" disabled="@isRunningPhase3">
                            @if (isRunningPhase3)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中...</span>
                            }
                            else
                            {
                                <span>运行阶段三测试</span>
                            }
                        </button>
                    </div>
                    <pre class="test-output">@phase3Output</pre>
                </div>
            }
        </div>

        <!-- 阶段四测试：持久化 -->
        <div class="test-section">
            <div class="section-header" @onclick="() => ToggleSection(3)">
                <h4>
                    <span class="toggle-icon">@(expandedSections.Contains(3) ? "▼" : "▶")</span>
                    阶段四：持久化测试
                </h4>
                <span class="status-badge @(phase4Status)">@phase4Status</span>
            </div>
            
            @if (expandedSections.Contains(3))
            {
                <div class="section-content">
                    <div class="button-group">
                        <button class="btn btn-info" @onclick="RunPhase4Tests" disabled="@isRunningPhase4">
                            @if (isRunningPhase4)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中...</span>
                            }
                            else
                            {
                                <span>运行阶段四测试</span>
                            }
                        </button>
                    </div>
                    <pre class="test-output">@phase4Output</pre>
                </div>
            }
        </div>

        <!-- 阶段六测试：边界条件 -->
        <div class="test-section">
            <div class="section-header" @onclick="() => ToggleSection(4)">
                <h4>
                    <span class="toggle-icon">@(expandedSections.Contains(4) ? "▼" : "▶")</span>
                    阶段六：边界条件测试
                </h4>
                <span class="status-badge @(phase6BoundaryStatus)">@phase6BoundaryStatus</span>
            </div>
            
            @if (expandedSections.Contains(4))
            {
                <div class="section-content">
                    <div class="button-group">
                        <button class="btn btn-warning" @onclick="RunPhase6BoundaryTests" disabled="@isRunningPhase6Boundary">
                            @if (isRunningPhase6Boundary)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中...</span>
                            }
                            else
                            {
                                <span>运行边界条件测试</span>
                            }
                        </button>
                    </div>
                    <pre class="test-output">@phase6BoundaryOutput</pre>
                </div>
            }
        </div>

        <!-- 阶段六测试：性能测试 -->
        <div class="test-section">
            <div class="section-header" @onclick="() => ToggleSection(5)">
                <h4>
                    <span class="toggle-icon">@(expandedSections.Contains(5) ? "▼" : "▶")</span>
                    阶段六：性能测试
                </h4>
                <span class="status-badge @(phase6PerformanceStatus)">@phase6PerformanceStatus</span>
            </div>
            
            @if (expandedSections.Contains(5))
            {
                <div class="section-content">
                    <div class="button-group">
                        <button class="btn btn-danger" @onclick="RunPhase6PerformanceTests" disabled="@isRunningPhase6Performance">
                            @if (isRunningPhase6Performance)
                            {
                                <span class="spinner-small"></span>
                                <span>测试中...</span>
                            }
                            else
                            {
                                <span>运行性能测试</span>
                            }
                        </button>
                    </div>
                    <pre class="test-output">@phase6PerformanceOutput</pre>
                </div>
            }
        </div>

        <!-- 一键运行所有测试 -->
        <div class="test-section all-tests">
            <div class="section-content">
                <button class="btn btn-warning btn-large" @onclick="RunAllTests" disabled="@isRunningAll">
                    @if (isRunningAll)
                    {
                        <span class="spinner-small"></span>
                        <span>运行所有测试中...</span>
                    }
                    else
                    {
                        <span>🚀 一键运行所有测试</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private HashSet<int> expandedSections = new HashSet<int> { 1, 2, 3 }; // 默认全部展开
    
    // 测试状态
    private bool isRunningPhase2 = false;
    private bool isRunningPhase3 = false;
    private bool isRunningPhase4 = false;
    private bool isRunningPhase6Boundary = false;
    private bool isRunningPhase6Performance = false;
    private bool isRunningAll = false;
    
    private string phase2Output = "点击按钮开始测试...";
    private string phase3Output = "点击按钮开始测试...";
    private string phase4Output = "点击按钮开始测试...";
    private string phase6BoundaryOutput = "点击按钮开始测试...";
    private string phase6PerformanceOutput = "点击按钮开始测试...";
    
    private string phase2Status = "pending";
    private string phase3Status = "pending";
    private string phase4Status = "pending";
    private string phase6BoundaryStatus = "pending";
    private string phase6PerformanceStatus = "pending";

    private void ToggleSection(int sectionId)
    {
        if (expandedSections.Contains(sectionId))
        {
            expandedSections.Remove(sectionId);
        }
        else
        {
            expandedSections.Add(sectionId);
        }
    }

    private async Task RunAllTests()
    {
        isRunningAll = true;
        StateHasChanged();
        
        try
        {
            // 展开所有区域
            expandedSections = new HashSet<int> { 1, 2, 3, 4, 5 };
            
            await RunPhase2Tests();
            await Task.Delay(500);
            
            await RunPhase3Tests();
            await Task.Delay(500);
            
            await RunPhase4Tests();
            await Task.Delay(500);
            
            await RunPhase6BoundaryTests();
            await Task.Delay(500);
            
            await RunPhase6PerformanceTests();
        }
        finally
        {
            isRunningAll = false;
            StateHasChanged();
        }
    }

    private async Task RunPhase2Tests()
    {
        isRunningPhase2 = true;
        phase2Status = "running";
        phase2Output = "开始阶段二测试（属性计算）...\n";
        StateHasChanged();
        await Task.Delay(100);

        try
        {
            // 测试1：加载配置
            phase2Output += "\n[测试1] 加载职业配置...\n";
            var configs = await ProfessionAttributeService.GetAllConfigsAsync();
            phase2Output += $"✓ 加载了 {configs.Count} 个职业配置\n";

            // 测试2：计算战士属性
            phase2Output += "\n[测试2] 计算战士属性 (Level 1-10)...\n";
            if (configs.TryGetValue("warrior", out var warriorConfig))
            {
                for (int level = 1; level <= 10; level++)
                {
                    var attrs = AttributeCalculator.Calculate(level, warriorConfig);
                    var dps = AttributeCalculator.CalculateTotalDPS(attrs);
                    
                    phase2Output += $"Lv{level}: 力量={attrs.MainStatTotal}, 耐力={attrs.StaminaTotal}, " +
                                 $"伤害={attrs.DamagePerAttack}, HP={attrs.MaxHp}, " +
                                 $"暴击={attrs.CritChancePercent:P1}, 急速={attrs.HastePercent:P1}, " +
                                 $"DPS={dps:F1}\n";
                }
                phase2Output += "✓ 战士属性计算成功\n";
            }

            // 测试3：计算法师属性
            phase2Output += "\n[测试3] 计算法师属性 (Level 1-10)...\n";
            if (configs.TryGetValue("mage", out var mageConfig))
            {
                for (int level = 1; level <= 10; level++)
                {
                    var attrs = AttributeCalculator.Calculate(level, mageConfig);
                    var dps = AttributeCalculator.CalculateTotalDPS(attrs);
                    
                    phase2Output += $"Lv{level}: 法强={attrs.MainStatTotal}, 耐力={attrs.StaminaTotal}, " +
                                 $"伤害={attrs.DamagePerAttack}, HP={attrs.MaxHp}, " +
                                 $"暴击={attrs.CritChancePercent:P1}, DPS={dps:F1}\n";
                }
                phase2Output += "✓ 法师属性计算成功\n";
            }

            // 测试4：计算游侠属性
            phase2Output += "\n[测试4] 计算游侠属性 (Level 1-10)...\n";
            if (configs.TryGetValue("ranger", out var rangerConfig))
            {
                for (int level = 1; level <= 10; level++)
                {
                    var attrs = AttributeCalculator.Calculate(level, rangerConfig);
                    var dps = AttributeCalculator.CalculateTotalDPS(attrs);
                    
                    phase2Output += $"Lv{level}: 敏捷={attrs.MainStatTotal}, 耐力={attrs.StaminaTotal}, " +
                                 $"伤害={attrs.DamagePerAttack}, HP={attrs.MaxHp}, " +
                                 $"暴击={attrs.CritChancePercent:P1}, 急速={attrs.HastePercent:P1}, " +
                                 $"DPS={dps:F1}\n";
                }
                phase2Output += "✓ 游侠属性计算成功\n";
            }

            // 测试5：性能测试
            phase2Output += "\n[测试5] 性能测试...\n";
            var sw = System.Diagnostics.Stopwatch.StartNew();
            for (int i = 0; i < 100; i++)
            {
                AttributeCalculator.Calculate(50, warriorConfig);
            }
            sw.Stop();
            phase2Output += $"✓ 100次计算耗时: {sw.ElapsedMilliseconds}ms (平均 {sw.ElapsedMilliseconds / 100.0:F2}ms)\n";

            if (sw.ElapsedMilliseconds < 100)
            {
                phase2Output += "✓ 性能满足要求 (<100ms)\n";
            }
            else
            {
                phase2Output += "✗ 性能警告: 超过100ms\n";
            }

            // 测试6：上限测试
            phase2Output += "\n[测试6] 测试属性上限...\n";
            var highLevelAttrs = AttributeCalculator.Calculate(600, rangerConfig);
            phase2Output += $"Level 600游侠: 暴击={highLevelAttrs.CritChancePercent:P1} (上限60%), 急速={highLevelAttrs.HastePercent:P1} (上限40%)\n";
            
            if (highLevelAttrs.CritChancePercent <= 0.6 && highLevelAttrs.HastePercent <= 0.4)
            {
                phase2Output += "✓ 上限约束正常工作\n";
            }
            else
            {
                phase2Output += "✗ 上限约束失败！\n";
            }

            phase2Output += "\n" + "=".PadLeft(80, '=') + "\n";
            phase2Output += "✓ 阶段二所有测试完成！\n";
            phase2Output += "=".PadLeft(80, '=') + "\n";
            
            phase2Status = "success";
        }
        catch (Exception ex)
        {
            phase2Output += $"\n✗ 阶段二测试失败: {ex.Message}\n";
            phase2Output += $"堆栈: {ex.StackTrace}\n";
            phase2Status = "failed";
        }
        finally
        {
            isRunningPhase2 = false;
            StateHasChanged();
        }
    }

    private async Task RunPhase3Tests()
    {
        isRunningPhase3 = true;
        phase3Status = "running";
        phase3Output = "开始阶段三测试（触发集成）...\n";
        StateHasChanged();
        await Task.Delay(100);

        try
        {
            // 测试P3.1：模拟角色创建并验证属性初始化
            phase3Output += "\n[P3测试1] 模拟角色创建触发...\n";
            var testCharacter = new CharacterData
            {
                Id = "test-character-" + Guid.NewGuid().ToString(),
                Name = "测试角色",
                UserId = 1,
                ProfessionId = "warrior",
                ActiveCombatProfessionId = "warrior",
                Professions = new Dictionary<string, ProfessionProgress>
                {
                    ["warrior"] = new ProfessionProgress { ProfessionId = "warrior", Level = 1, Experience = 0 }
                }
            };

            // 模拟属性计算
            await CharacterAttributeService.RecalculateAndApplyAsync(testCharacter);
            phase3Output += $"  创建角色: {testCharacter.Name}\n";
            phase3Output += $"  初始属性: 伤害={testCharacter.DamagePerAttack}, HP={testCharacter.MaxHp}\n";
            
            if (testCharacter.DamagePerAttack > 0 && testCharacter.MaxHp > 0)
            {
                phase3Output += "✓ 角色创建触发 - 属性初始化成功\n";
            }
            else
            {
                phase3Output += "✗ 角色创建触发 - 属性初始化失败\n";
            }

            // 测试P3.2：模拟升级触发
            phase3Output += "\n[P3测试2] 模拟升级触发（战士 Lv1→Lv5）...\n";
            var oldDamage = testCharacter.DamagePerAttack;
            var oldHp = testCharacter.MaxHp;
            
            // 更新等级
            testCharacter.Professions["warrior"].Level = 5;
            await CharacterAttributeService.RecalculateAndApplyAsync(testCharacter);
            
            phase3Output += $"  升级前: 伤害={oldDamage}, HP={oldHp}\n";
            phase3Output += $"  升级后: 伤害={testCharacter.DamagePerAttack}, HP={testCharacter.MaxHp}\n";
            
            if (testCharacter.DamagePerAttack > oldDamage && testCharacter.MaxHp > oldHp)
            {
                phase3Output += "✓ 升级触发 - 属性正确提升\n";
            }
            else
            {
                phase3Output += "✗ 升级触发 - 属性提升异常\n";
            }

            // 测试P3.3：模拟职业切换触发
            phase3Output += "\n[P3测试3] 模拟职业切换触发（战士→法师）...\n";
            
            // 添加法师职业
            testCharacter.Professions["mage"] = new ProfessionProgress 
            { 
                ProfessionId = "mage", 
                Level = 3, 
                Experience = 0 
            };
            
            var warriorDamage = testCharacter.DamagePerAttack;
            
            // 切换到法师
            testCharacter.ProfessionId = "mage";
            testCharacter.ActiveCombatProfessionId = "mage";
            await CharacterAttributeService.RecalculateAndApplyAsync(testCharacter);
            
            phase3Output += $"  战士属性: 伤害={warriorDamage}\n";
            phase3Output += $"  法师属性: 伤害={testCharacter.DamagePerAttack}\n";
            phase3Output += $"  当前职业: {testCharacter.ActiveCombatProfessionId}\n";
            
            if (testCharacter.DamagePerAttack != warriorDamage)
            {
                phase3Output += "✓ 职业切换触发 - 属性已重新计算\n";
            }
            else
            {
                phase3Output += "✗ 职业切换触发 - 属性未更新\n";
            }

            // 测试P3.4：模拟战斗中升级
            phase3Output += "\n[P3测试4] 模拟战斗中升级触发...\n";
            
            var combatCharacter = new CharacterData
            {
                Id = "combat-test-" + Guid.NewGuid().ToString(),
                Name = "战斗测试角色",
                UserId = 1,
                ProfessionId = "ranger",
                ActiveCombatProfessionId = "ranger",
                Professions = new Dictionary<string, ProfessionProgress>
                {
                    ["ranger"] = new ProfessionProgress { ProfessionId = "ranger", Level = 5, Experience = 0 }
                }
            };

            await CharacterAttributeService.RecalculateAndApplyAsync(combatCharacter);
            
            var beforeCombatDPS = combatCharacter.DamagePerAttack * combatCharacter.AttackRateAPS * 
                                  (1 + combatCharacter.CritChancePercent * (combatCharacter.CritMultiplier - 1));

            // 模拟战斗中升级
            combatCharacter.Professions["ranger"].Level = 6;
            await CharacterAttributeService.RecalculateAndApplyAsync(combatCharacter);
            
            var afterCombatDPS = combatCharacter.DamagePerAttack * combatCharacter.AttackRateAPS * 
                                 (1 + combatCharacter.CritChancePercent * (combatCharacter.CritMultiplier - 1));

            phase3Output += $"  战斗前DPS: {beforeCombatDPS:F1}\n";
            phase3Output += $"  升级后DPS: {afterCombatDPS:F1}\n";
            
            if (afterCombatDPS > beforeCombatDPS)
            {
                phase3Output += "✓ 战斗中升级 - DPS实时提升\n";
            }
            else
            {
                phase3Output += "✗ 战斗中升级 - DPS未更新\n";
            }

            // 测试P3.5：批量重算测试
            phase3Output += "\n[P3测试5] 批量重算触发测试...\n";
            
            var characters = new List<CharacterData>
            {
                new CharacterData
                {
                    Id = "batch-1",
                    Name = "批量角色1",
                    UserId = 1,
                    ProfessionId = "warrior",
                    ActiveCombatProfessionId = "warrior",
                    Professions = new Dictionary<string, ProfessionProgress>
                    {
                        ["warrior"] = new ProfessionProgress { ProfessionId = "warrior", Level = 3, Experience = 0 }
                    }
                },
                new CharacterData
                {
                    Id = "batch-2",
                    Name = "批量角色2",
                    UserId = 1,
                    ProfessionId = "mage",
                    ActiveCombatProfessionId = "mage",
                    Professions = new Dictionary<string, ProfessionProgress>
                    {
                        ["mage"] = new ProfessionProgress { ProfessionId = "mage", Level = 4, Experience = 0 }
                    }
                }
            };

            var sw = System.Diagnostics.Stopwatch.StartNew();
            foreach (var character in characters)
            {
                await CharacterAttributeService.RecalculateAndApplyAsync(character);
            }
            sw.Stop();

            phase3Output += $"  批量计算2个角色耗时: {sw.ElapsedMilliseconds}ms\n";
            phase3Output += $"  角色1属性: 伤害={characters[0].DamagePerAttack}, HP={characters[0].MaxHp}\n";
            phase3Output += $"  角色2属性: 伤害={characters[1].DamagePerAttack}, HP={characters[1].MaxHp}\n";
            
            if (characters.All(c => c.DamagePerAttack > 0 && c.MaxHp > 0))
            {
                phase3Output += "✓ 批量重算 - 所有角色属性已更新\n";
            }
            else
            {
                phase3Output += "✗ 批量重算 - 部分角色属性未更新\n";
            }

            // 测试P3.6：事件触发验证
            phase3Output += "\n[P3测试6] 事件系统验证...\n";
            
            bool eventTriggered = false;
            CharacterData? eventCharacter = null;

            void OnCharacterChanged(CharacterData? character)
            {
                eventTriggered = true;
                eventCharacter = character;
            }

            CharacterService.SelectedCharacterChanged += OnCharacterChanged;

            try
            {
                await CharacterService.SetSelectedCharacterAsync(testCharacter.Id);
                await Task.Delay(100);

                phase3Output += $"  事件触发状态: {(eventTriggered ? "已触发" : "未触发")}\n";
                
                if (eventTriggered)
                {
                    phase3Output += "✓ 事件系统 - SelectedCharacterChanged事件正常工作\n";
                }
                else
                {
                    phase3Output += "✗ 事件系统 - 事件未触发（可能需要实际角色数据）\n";
                }
            }
            finally
            {
                CharacterService.SelectedCharacterChanged -= OnCharacterChanged;
            }

            // 测试P3.7：性能测试（触发系统）
            phase3Output += "\n[P3测试7] 触发系统性能测试...\n";
            
            sw = System.Diagnostics.Stopwatch.StartNew();
            for (int i = 0; i < 10; i++)
            {
                var perfCharacter = new CharacterData
                {
                    Id = $"perf-{i}",
                    Name = $"性能测试{i}",
                    UserId = 1,
                    ProfessionId = "warrior",
                    ActiveCombatProfessionId = "warrior",
                    Professions = new Dictionary<string, ProfessionProgress>
                    {
                        ["warrior"] = new ProfessionProgress { ProfessionId = "warrior", Level = 10, Experience = 0 }
                    }
                };
                await CharacterAttributeService.RecalculateAndApplyAsync(perfCharacter);
            }
            sw.Stop();

            phase3Output += $"  10次完整重算耗时: {sw.ElapsedMilliseconds}ms (平均 {sw.ElapsedMilliseconds / 10.0:F1}ms)\n";
            
            if (sw.ElapsedMilliseconds < 100)
            {
                phase3Output += "✓ 触发性能 - 满足实时更新要求 (<100ms)\n";
            }
            else
            {
                phase3Output += "⚠ 触发性能 - 接近阈值，可能影响用户体验\n";
            }

            phase3Output += "\n" + "=".PadLeft(80, '=') + "\n";
            phase3Output += "✓ 阶段三所有测试完成！\n";
            phase3Output += "=".PadLeft(80, '=') + "\n";
            
            phase3Status = "success";
        }
        catch (Exception ex)
        {
            phase3Output += $"\n✗ 阶段三测试失败: {ex.Message}\n";
            phase3Output += $"堆栈: {ex.StackTrace}\n";
            phase3Status = "failed";
        }
        finally
        {
            isRunningPhase3 = false;
            StateHasChanged();
        }
    }

    private async Task RunPhase4Tests()
    {
        isRunningPhase4 = true;
        phase4Status = "running";
        phase4Output = "开始阶段四测试（持久化）...\n\n";
        StateHasChanged();

        try
        {
            await TestHeartbeatSave();
            await TestImmediateSave();
            await TestSaveRestoreAttributes();

