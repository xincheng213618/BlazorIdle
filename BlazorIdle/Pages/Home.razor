@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using BlazorIdle.Components
@using BlazorIdle.Shared.Models
@inject BlazorIdle.Services.ICharacterService CharacterService
@inject BlazorIdle.Services.IHeartbeatService HeartbeatService

<PageTitle>Home</PageTitle>

<div class="container-fluid">
    @if (isReady)
    {
        <div class="row">
            <div class="col-md-6">
                <CharacterCreation StartCollapsed="@(selectedCharacter is not null)"
                                   OnCharacterCreated="OnCharacterCreated" />
            </div>
            <div class="col-md-6">
                <CharacterSelector @ref="characterSelector"
                                   StartCollapsed="@(selectedCharacter is not null)"
                                   OnCharacterSelected="OnCharacterSelected"
                                   OnCharacterDeleted="OnCharacterDeleted" />
            </div>
        </div>

        @if (selectedCharacter != null)
        {
            <div class="row">
                <div class="col-md-6">
                    <ProfessionSelector Character="@selectedCharacter"
                                        OnProfessionSwitched="OnProfessionSwitched" />
                </div>
                <div class="col-md-6">
                    <CharacterDetail Character="@selectedCharacter" />
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <!-- 物品栏：增加外框，并单独加下间距，不影响其它 row -->
                    <div class="section-frame mb-3">
                        <InventoryPanel Inventory="@selectedCharacter.Inventory"
                                        Character="@selectedCharacter"
                                        ProfessionId="@selectedCharacter.ActiveCombatProfessionId"
                                        OnItemUsed="OnItemUsed"
                                        StartCollapsed="true" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <!-- 消耗品商店：增加外框 -->
                    <div class="section-frame mb-3">
                        <ConsumableShopPanel Character="@selectedCharacter"
                                             OnItemPurchased="OnItemPurchased"
                                             StartCollapsed="true" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <!-- 技能学习：增加外框（并避免内部卡片双重边框） -->
                    <div class="section-frame mb-3">
                        <SkillLearningPanel Character="@selectedCharacter"
                                            ProfessionId="@selectedCharacter.ActiveCombatProfessionId"
                                            StartCollapsed="true"
                                            OnSkillLearned="OnSkillLearned" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <!-- 技能装备：增加外框 -->
                    <div class="section-frame">
                        <SkillEquipmentPanel @ref="skillEquipmentPanel"
                                             Character="@selectedCharacter"
                                             ProfessionId="@selectedCharacter.ActiveCombatProfessionId"
                                             StartCollapsed="true"
                                             OnSkillEquipped="OnSkillEquipped"
                                             OnSkillUnequipped="OnSkillUnequipped" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <BattleDemo SelectedCharacter="@selectedCharacter"
                                OnCharacterDataChanged="OnCharacterDataChanged" />
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning">
                        请先创建并选择一个角色，然后开始战斗。
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-muted">加载中...</div>
    }
</div>

@code {
    private CharacterSelector? characterSelector;
    private SkillEquipmentPanel? skillEquipmentPanel;
    private CharacterData? selectedCharacter;
    private bool isReady; // 控制首渲染

    /// <summary>
    /// 组件初始化 - 加载当前选中的角色并启动心跳服务
    /// Component initialization - load currently selected character and start heartbeat service
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 获取当前选中的角色
        // Get currently selected character
        selectedCharacter = await CharacterService.GetSelectedCharacterAsync();

        // 如果有选中的角色，启动心跳服务
        // If a character is selected, start heartbeat service
        if (selectedCharacter != null)
        {
            HeartbeatService.Start(selectedCharacter);
        }

        isReady = true; // 数据已就绪，再渲染子组件，确保 StartCollapsed 生效
    }

    /// <summary>
    /// 角色创建完成回调
    /// Character creation completed callback
    /// </summary>
    private async Task OnCharacterCreated()
    {
        if (characterSelector != null)
        {
            await characterSelector.RefreshAsync();
        }
    }

    /// <summary>
    /// 角色选择变更回调 - 心跳服务会自动响应角色切换事件
    /// Character selection changed callback - heartbeat service automatically responds to character switch event
    /// </summary>
    private void OnCharacterSelected(CharacterData? character)
    {
        selectedCharacter = character;

        // 心跳服务已通过事件订阅自动处理角色切换
        // Heartbeat service automatically handles character switch through event subscription
        // 因此这里不需要手动调用 HeartbeatService.Start/Stop
        // So no need to manually call HeartbeatService.Start/Stop here

        StateHasChanged();
    }

    /// <summary>
    /// 角色删除回调
    /// Character deletion callback
    /// </summary>
    private async Task OnCharacterDeleted()
    {
        selectedCharacter = await CharacterService.GetSelectedCharacterAsync();
        StateHasChanged();
    }

    /// <summary>
    /// 职业切换回调 - 更新当前角色数据
    /// Profession switched callback - update current character data
    /// </summary>
    private void OnProfessionSwitched(CharacterData updatedCharacter)
    {
        selectedCharacter = updatedCharacter;

        // 更新心跳服务跟踪的角色数据
        // Update HeartbeatService tracked character
        HeartbeatService.UpdateCharacter(updatedCharacter);

        StateHasChanged();
    }

    /// <summary>
    /// 角色数据变更回调 - 触发UI更新（如经验/等级变化）
    /// Character data changed callback - trigger UI update (e.g., experience/level changes)
    /// </summary>
    private void OnCharacterDataChanged(CharacterData updatedCharacter)
    {
        // 更新本地引用
        // Update local reference
        selectedCharacter = updatedCharacter;

        // 更新心跳服务跟踪的角色数据，确保自动保存使用最新数据
        // Update HeartbeatService tracked character to ensure auto-save uses latest data
        HeartbeatService.UpdateCharacter(updatedCharacter);

        // 角色对象引用没变，但内容已更新，触发重新渲染
        // Character object reference unchanged, but content updated, trigger re-render
        StateHasChanged();
    }

    /// <summary>
    /// 技能学习回调 - 保存角色数据
    /// Skill learned callback - save character data
    /// </summary>
    private async Task OnSkillLearned()
    {
        if (selectedCharacter != null)
        {
            // 调试日志：保存前的技能列表
            // Debug log: skill list before save
            Console.WriteLine($"[Home] Saving character with {selectedCharacter.LearnedSkills.Count} learned skills");
            Console.WriteLine($"[Home] Learned skills: {string.Join(", ", selectedCharacter.LearnedSkills)}");

            // 保存角色数据到服务器
            // Save character data to server
            var response = await CharacterService.UpdateCharacterAsync(selectedCharacter.Id, selectedCharacter);

            // 调试日志：保存结果
            // Debug log: save result
            if (response != null && response.Success)
            {
                Console.WriteLine($"[Home] Character saved successfully");
            }
            else
            {
                Console.WriteLine($"[Home] Character save failed: {response?.Message ?? "Unknown error"}");
            }

            // 刷新技能装备面板以显示新学习的技能
            // Refresh skill equipment panel to show newly learned skills
            skillEquipmentPanel?.Refresh();

            // 触发重新渲染
            // Trigger re-render
            StateHasChanged();
        }
    }

    /// <summary>
    /// 物品购买回调 - 保存角色数据
    /// Item purchased callback - save character data
    /// </summary>
    private async Task OnItemPurchased()
    {
        if (selectedCharacter != null)
        {
            // 保存角色数据到服务器
            // Save character data to server
            await CharacterService.UpdateCharacterAsync(selectedCharacter.Id, selectedCharacter);

            // 触发重新渲染
            // Trigger re-render
            StateHasChanged();
        }
    }

    /// <summary>
    /// 物品使用回调 - 保存角色数据并刷新技能面板
    /// Item used callback - save character data and refresh skill panels
    /// </summary>
    private async Task OnItemUsed()
    {
        if (selectedCharacter != null)
        {
            // 保存角色数据到服务器
            // Save character data to server
            await CharacterService.UpdateCharacterAsync(selectedCharacter.Id, selectedCharacter);

            // 刷新技能装备面板（可能学习了新技能）
            // Refresh skill equipment panel (may have learned new skills)
            skillEquipmentPanel?.Refresh();

            // 触发重新渲染
            // Trigger re-render
            StateHasChanged();
        }
    }

    /// <summary>
    /// 技能装备回调 - 保存角色数据
    /// Skill equipped callback - save character data
    /// </summary>
    private async Task OnSkillEquipped()
    {
        if (selectedCharacter != null)
        {
            // 保存角色数据到服务器
            // Save character data to server
            await CharacterService.UpdateCharacterAsync(selectedCharacter.Id, selectedCharacter);

            // 触发重新渲染
            // Trigger re-render
            StateHasChanged();
        }
    }

    /// <summary>
    /// 技能卸载回调 - 保存角色数据
    /// Skill unequipped callback - save character data
    /// </summary>
    private async Task OnSkillUnequipped()
    {
        if (selectedCharacter != null)
        {
            // 保存角色数据到服务器
            // Save character data to server
            await CharacterService.UpdateCharacterAsync(selectedCharacter.Id, selectedCharacter);

            // 触发重新渲染
            // Trigger re-render
            StateHasChanged();
        }
    }
}

<style>
    /* 可保留你的全局按钮样式（如不需要可移除） */
    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        margin-top: 20px;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    /* 新增：本页局部的外边框容器，仅包裹 InventoryPanel 与 SkillLearningPanel */
    .section-frame {
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden; /* 让内部圆角贴合 */
        padding: 0; /* 交由内部组件自己控制内边距 */
    }

        /* 避免技能组件出现双重边框（技能面板内部已经有卡片样式） */
        .section-frame .skill-learning-card {
            border: 0;
            box-shadow: none;
            margin-bottom: 0;
        }
</style>