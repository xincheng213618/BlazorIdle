@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using BlazorIdle.Components
@using BlazorIdle.Shared.Models
@inject BlazorIdle.Services.ICharacterService CharacterService
@inject BlazorIdle.Services.IHeartbeatService HeartbeatService

<PageTitle>Home</PageTitle>

<div class="container-fluid">
    @if (isReady)
    {
        <div class="row">
            <div class="col-md-6">
                <CharacterCreation StartCollapsed="@(selectedCharacter is not null)"
                                   OnCharacterCreated="OnCharacterCreated" />
            </div>
            <div class="col-md-6">
                <CharacterSelector @ref="characterSelector"
                                   StartCollapsed="@(selectedCharacter is not null)"
                                   OnCharacterSelected="OnCharacterSelected"
                                   OnCharacterDeleted="OnCharacterDeleted" />
            </div>
        </div>

        @if (selectedCharacter != null)
        {
            <div class="row">
                <div class="col-12">
                    <InventoryPanel Inventory="@selectedCharacter.Inventory"
                                    StartCollapsed="true" />
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <BattleDemo SelectedCharacter="@selectedCharacter" />
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <MultiBattleTest />
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning">
                        请先创建并选择一个角色，然后开始战斗。
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-muted">加载中...</div>
    }
</div>

@code {
    private CharacterSelector? characterSelector;
    private CharacterData? selectedCharacter;
    private bool isReady; // 控制首渲染

    /// <summary>
    /// 组件初始化 - 加载当前选中的角色并启动心跳服务
    /// Component initialization - load currently selected character and start heartbeat service
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 获取当前选中的角色
        // Get currently selected character
        selectedCharacter = await CharacterService.GetSelectedCharacterAsync();
        
        // 如果有选中的角色，启动心跳服务
        // If a character is selected, start heartbeat service
        if (selectedCharacter != null)
        {
            HeartbeatService.Start(selectedCharacter);
        }
        
        isReady = true; // 数据已就绪，再渲染子组件，确保 StartCollapsed 生效
    }

    /// <summary>
    /// 角色创建完成回调
    /// Character creation completed callback
    /// </summary>
    private async Task OnCharacterCreated()
    {
        if (characterSelector != null)
        {
            await characterSelector.RefreshAsync();
        }
    }

    /// <summary>
    /// 角色选择变更回调 - 心跳服务会自动响应角色切换事件
    /// Character selection changed callback - heartbeat service automatically responds to character switch event
    /// </summary>
    private void OnCharacterSelected(CharacterData? character)
    {
        selectedCharacter = character;
        
        // 心跳服务已通过事件订阅自动处理角色切换
        // Heartbeat service automatically handles character switch through event subscription
        // 因此这里不需要手动调用 HeartbeatService.Start/Stop
        // So no need to manually call HeartbeatService.Start/Stop here
        
        StateHasChanged();
    }

    /// <summary>
    /// 角色删除回调
    /// Character deletion callback
    /// </summary>
    private async Task OnCharacterDeleted()
    {
        selectedCharacter = await CharacterService.GetSelectedCharacterAsync();
        StateHasChanged();
    }
}

<style>
