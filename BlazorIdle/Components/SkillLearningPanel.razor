@using BlazorIdle.Shared.Models
@using BlazorIdle.Game.Skills
@implements IDisposable

<div class="skill-learning-card">
    <div class="sl-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">📖</span>
            技能学习 (Skill Learning) - @ProfessionName
        </h5>
        <div class="d-flex align-items-center gap-3">
            @if (Character != null)
            {
                <div class="gold-balance">
                    <span class="gold-icon">🪙</span>
                    <span class="gold-amount">@GetGoldBalance().ToString("N0")</span>
                </div>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="sl-body" style="@(isCollapsed ? "display:none" : null)">
        @if (Character == null)
        {
            <div class="text-muted">请先选择角色...</div>
        }
        else
        {
            <!-- 左右分栏 -->
            <div class="sl-split">
                <!-- 左侧：技能列表（按分类切换，仅展示当前分类） -->
                <div class="sl-left">
                    <div class="skill-categories">
                        <!-- 分类 Tabs -->
                        <div class="category-tabs" role="tablist" aria-label="技能分类切换">
                            <button type="button"
                                    class="cat-tab @(currentFilter == SkillListFilter.Learnable ? "active" : null)"
                                    role="tab"
                                    aria-selected="@(currentFilter == SkillListFilter.Learnable)"
                                    @onclick="() => SetFilter(SkillListFilter.Learnable)">
                                <span class="badge bg-primary">可学习</span>
                                <span class="cat-count">@learnableCount</span>
                            </button>
                            <button type="button"
                                    class="cat-tab @(currentFilter == SkillListFilter.Learned ? "active" : null)"
                                    role="tab"
                                    aria-selected="@(currentFilter == SkillListFilter.Learned)"
                                    @onclick="() => SetFilter(SkillListFilter.Learned)">
                                <span class="badge bg-success">已学习</span>
                                <span class="cat-count">@learnedCount</span>
                            </button>
                            <button type="button"
                                    class="cat-tab @(currentFilter == SkillListFilter.Locked ? "active" : null)"
                                    role="tab"
                                    aria-selected="@(currentFilter == SkillListFilter.Locked)"
                                    @onclick="() => SetFilter(SkillListFilter.Locked)">
                                <span class="badge bg-secondary">未解锁</span>
                                <span class="cat-count">@lockedCount</span>
                            </button>
                        </div>

                        @{
                            var filtered = GetFilteredList().ToList();
                        }

                        @if (filtered.Count > 0)
                        {
                            <div class="skill-section mb-3">
                                <h6 class="section-title">
                                    <span class="badge @GetFilterBadgeClass()">@GetFilterText()</span>
                                    <span class="ms-2">共 @filtered.Count 个技能</span>
                                </h6>
                                <ul class="skill-item-list">
                                    @foreach (var skill in filtered)
                                    {
                                        <li class="skill-item @GetItemStateClass(skill.Id) @(IsSelected(skill.Id) ? "selected" : null)"
                                            role="button"
                                            @onclick="@(() => SelectSkill(skill.Id))"
                                            aria-selected="@(IsSelected(skill.Id))">
                                            <div class="skill-item-icon">@GetSkillIcon(skill)</div>
                                            <div class="skill-item-main">
                                                <div class="skill-item-name">@skill.Name</div>
                                                <div>
                                                    <span class="skill-type-badge @GetSkillTypeCssClass(skill)">
                                                        @GetSkillTypeText(skill)
                                                    </span>
                                                    @if (skill.Unlock != null && skill.Unlock.MinLevel > 0)
                                                    {
                                                        var needLv = skill.Unlock.MinLevel;
                                                        if (currentFilter == SkillListFilter.Locked)
                                                        {
                                                            <span class="ms-2 text-danger small">需要 Lv.@needLv</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="ms-2 text-muted small">Lv.@needLv</span>
                                                        }
                                                    }
                                                    @if (currentFilter == SkillListFilter.Learned && skill.CooldownSec > 0)
                                                    {
                                                        <span class="ms-2 text-muted small">CD: @skill.CooldownSec s</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="skill-item-status">
                                                @if (currentFilter == SkillListFilter.Learnable)
                                                {
                                                    <span class="badge bg-primary">可学习</span>
                                                }
                                                else if (currentFilter == SkillListFilter.Learned)
                                                {
                                                    <span class="badge bg-success">已学会</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">已锁定</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info my-2">
                                <i class="bi bi-info-circle"></i>
                                当前分类下暂无技能。
                            </div>
                        }
                    </div>
                </div>

                <!-- 右侧：技能详情 -->
                <div class="sl-right">
                    @if (SelectedSkill is null)
                    {
                        <div class="skill-detail-placeholder text-muted">
                            <div class="display-6">🛈</div>
                            <div class="mt-2">请选择左侧的技能查看详情</div>
                        </div>
                    }
                    else
                    {
                        var s = SelectedSkill;
                        var isLearnedNow = IsInList(learnedSkills, s.Id);
                        var isLearnableNow = IsInList(learnableSkills, s.Id);
                        var isLockedNow = IsInList(lockedSkills, s.Id);

                        <div class="skill-detail-card">
                            <div class="detail-header d-flex align-items-center">
                                <div class="detail-icon">@GetSkillIcon(s)</div>
                                <div class="flex-grow-1">
                                    <div class="detail-name">@s.Name</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="skill-type-badge @GetSkillTypeCssClass(s)">
                                            @GetSkillTypeText(s)
                                        </span>
                                        @if (isLearnedNow)
                                        {
                                            <span class="badge bg-success">已学会</span>
                                        }
                                        else if (isLearnableNow)
                                        {
                                            <span class="badge bg-primary">可学习</span>
                                        }
                                        else if (isLockedNow)
                                        {
                                            <span class="badge bg-secondary">未解锁</span>
                                        }
                                    </div>
                                </div>

                                @if (isLearnableNow)
                                {
                                    var canAfford = CanAffordSkill(s);
                                    var finalPrice = GetSkillFinalPrice(s);
                                    var isPaidSkill = s.Purchase?.Enabled == true;
                                    
                                    @if (isPaidSkill)
                                    {
                                        <div class="d-flex flex-column align-items-end gap-2">
                                            <div class="skill-price-display">
                                                <span class="price-icon">🪙</span>
                                                @if (s.Purchase!.DiscountPercent > 0)
                                                {
                                                    <span class="original-price">@s.Purchase.BasePrice</span>
                                                    <span class="final-price text-success">@finalPrice</span>
                                                    <span class="discount-badge">-@s.Purchase.DiscountPercent.ToString("F0")%</span>
                                                }
                                                else
                                                {
                                                    <span class="final-price">@finalPrice</span>
                                                }
                                            </div>
                                            <button class="btn @(canAfford ? "btn-success" : "btn-secondary")"
                                                    disabled="@(!canAfford || isLearning)"
                                                    @onclick="() => LearnSkill(s.Id)">
                                                @if (isLearning && currentSkillId == s.Id)
                                                {
                                                    <span>学习中...</span>
                                                }
                                                else if (!canAfford)
                                                {
                                                    <span>金币不足</span>
                                                }
                                                else
                                                {
                                                    <span>购买学习</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success"
                                                disabled="@isLearning"
                                                @onclick="() => LearnSkill(s.Id)">
                                            @if (isLearning && currentSkillId == s.Id)
                                            {
                                                <span>学习中...</span>
                                            }
                                            else
                                            {
                                                <span>学习</span>
                                            }
                                        </button>
                                    }
                                }
                            </div>

                            <div class="detail-body mt-3">
                                <!-- 技能描述 -->
                                <div class="skill-description mb-3 p-2 bg-light rounded">
                                    <div class="text-muted small mb-1">技能描述</div>
                                    <div>@GetSkillDescription(s)</div>
                                </div>

                                <!-- 技能属性网格 -->
                                <div class="skill-properties">
                                    <!-- 基础属性 -->
                                    <div class="property-section mb-3">
                                        <h6 class="property-title">基础属性</h6>
                                        <div class="property-grid">
                                            <div class="property-item">
                                                <span class="property-label">类型:</span>
                                                <span class="property-value">
                                                    <span class="badge @(s.Type == "passive" ? "bg-info" : "bg-primary")">
                                                        @(s.Type == "passive" ? "被动" : "主动")
                                                    </span>
                                                </span>
                                            </div>
                                            <div class="property-item">
                                                <span class="property-label">释放方式:</span>
                                                <span class="property-value">
                                                    <span class="badge @(s.ReleaseType == "cast" ? "bg-warning" : "bg-secondary")">
                                                        @(s.ReleaseType == "cast" ? "施法" : "瞬发")
                                                    </span>
                                                </span>
                                            </div>
                                            @if (s.ReleaseType == "cast" && s.CastTimeSec > 0)
                                            {
                                                <div class="property-item">
                                                    <span class="property-label">施法时间:</span>
                                                    <span class="property-value">@s.CastTimeSec.ToString("F1") 秒</span>
                                                </div>
                                            }
                                            @if (s.CooldownSec > 0)
                                            {
                                                <div class="property-item">
                                                    <span class="property-label">冷却时间:</span>
                                                    <span class="property-value text-primary">@FormatNumber(s.CooldownSec) 秒</span>
                                                </div>
                                            }
                                            <div class="property-item">
                                                <span class="property-label">GCD:</span>
                                                <span class="property-value">@(s.IsGcd ? "是" : "否")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(s.TargetPolicy))
                                            {
                                                <div class="property-item">
                                                    <span class="property-label">目标:</span>
                                                    <span class="property-value">
                                                        @GetTargetPolicyText(s.TargetPolicy)
                                                        @if (IsAoESkill(s.TargetPolicy))
                                                        {
                                                            <span class="badge bg-danger ms-1">AOE</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- 解锁要求 -->
                                    @if (s.Unlock != null && s.Unlock.MinLevel > 0)
                                    {
                                        var curLv = GetCharacterLevel();
                                        <div class="property-section mb-3">
                                            <h6 class="property-title">解锁要求</h6>
                                            <div class="property-grid">
                                                <div class="property-item">
                                                    <span class="property-label">需要等级:</span>
                                                    <span class="property-value @(curLv < s.Unlock.MinLevel ? "text-danger" : "text-success")">
                                                        Lv.@s.Unlock.MinLevel @(curLv >= s.Unlock.MinLevel ? "✓" : $"(当前 Lv.{curLv})")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- 资源消耗与获得 -->
                                    @if ((s.Costs != null && s.Costs.Count > 0) || (s.Gains != null && s.Gains.Count > 0))
                                    {
                                        <div class="property-section mb-3">
                                            <h6 class="property-title">资源</h6>
                                            <div class="property-grid">
                                                @if (s.Costs != null && s.Costs.Count > 0)
                                                {
                                                    <div class="property-item">
                                                        <span class="property-label">消耗:</span>
                                                        <span class="property-value text-danger">
                                                            @foreach (var cost in s.Costs)
                                                            {
                                                                <span class="me-2">-@FormatNumber(cost.Amount) @GetResourceName(cost.BucketId)</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                                @if (s.Gains != null && s.Gains.Count > 0)
                                                {
                                                    <div class="property-item">
                                                        <span class="property-label">获得:</span>
                                                        <span class="property-value text-success">
                                                            @foreach (var gain in s.Gains)
                                                            {
                                                                <span class="me-2">+@FormatNumber(gain.Amount) @GetResourceName(gain.BucketId)</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- 伤害与治疗 -->
                                    @if (s.Damage != null || s.InstantHeal > 0)
                                    {
                                        <div class="property-section mb-3">
                                            <h6 class="property-title">效果</h6>
                                            <div class="property-grid">
                                                @if (s.Damage != null)
                                                {
                                                    <div class="property-item">
                                                        <span class="property-label">伤害:</span>
                                                        <span class="property-value text-danger">
                                                            @if (s.Damage.CoefAtk > 0)
                                                            {
                                                                <span>@FormatPercentage(s.Damage.CoefAtk) 攻击力</span>
                                                            }
                                                            @if (s.Damage.Flat > 0)
                                                            {
                                                                <span>@(s.Damage.CoefAtk > 0 ? "+ " : "")@FormatNumber(s.Damage.Flat) 固定伤害</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                                @if (s.InstantHeal > 0)
                                                {
                                                    <div class="property-item">
                                                        <span class="property-label">治疗:</span>
                                                        <span class="property-value text-success">+@FormatNumber(s.InstantHeal) HP</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Buff效果 -->
                                    @if ((s.OnCastBuffs != null && s.OnCastBuffs.Count > 0) || (s.OnHitBuffs != null && s.OnHitBuffs.Count > 0))
                                    {
                                        <div class="property-section mb-3">
                                            <h6 class="property-title">Buff效果</h6>
                                            <div class="buff-list">
                                                @if (s.OnCastBuffs != null && s.OnCastBuffs.Count > 0)
                                                {
                                                    <div class="small text-muted mb-1">施法时:</div>
                                                    @foreach (var buff in s.OnCastBuffs)
                                                    {
                                                        <div class="buff-item">
                                                            <span class="badge bg-info me-1">@GetBuffOpText(buff.Type)</span>
                                                            <span>@(buff.BuffConfigId ?? buff.BuffIdToRemove ?? "Buff")</span>
                                                            <span class="text-muted small">→ @buff.Target</span>
                                                        </div>
                                                    }
                                                }
                                                @if (s.OnHitBuffs != null && s.OnHitBuffs.Count > 0)
                                                {
                                                    <div class="small text-muted mb-1 mt-2">命中时:</div>
                                                    @foreach (var buff in s.OnHitBuffs)
                                                    {
                                                        <div class="buff-item">
                                                            <span class="badge bg-warning me-1">@GetBuffOpText(buff.Type)</span>
                                                            <span>@(buff.BuffConfigId ?? buff.BuffIdToRemove ?? "Buff")</span>
                                                            <span class="text-muted small">→ @buff.Target</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- 触发器 -->
                                    @if (s.Triggers != null && s.Triggers.Count > 0)
                                    {
                                        <div class="property-section mb-3">
                                            <h6 class="property-title">触发效果</h6>
                                            <div class="trigger-list">
                                                @foreach (var trigger in s.Triggers)
                                                {
                                                    <div class="trigger-item small">
                                                        <span class="badge bg-secondary me-1">@GetTriggerWhenText(trigger.When)</span>
                                                        @if (trigger.ProcChance < 1.0)
                                                        {
                                                            <span class="text-warning">@((trigger.ProcChance * 100).ToString("F0"))% 概率</span>
                                                        }
                                                        <span>触发 @trigger.FireSkillId</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- 技能ID (调试信息) -->
                                    <div class="property-section">
                                        <div class="text-muted small">
                                            <span class="property-label">技能ID:</span>
                                            <code class="text-muted">@s.Id</code>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-footer mt-3">
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="alert alert-danger py-2 mb-2">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        @errorMessage
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(successMessage))
                                {
                                    <div class="alert alert-success py-2 mb-0">
                                        <i class="bi bi-check-circle"></i>
                                        @successMessage
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public CharacterData? Character { get; set; }

    [Parameter]
    public string ProfessionId { get; set; } = "warrior";

    [Parameter]
    public bool StartCollapsed { get; set; }

    [Parameter]
    public EventCallback OnSkillLearned { get; set; }

    private bool isCollapsed;
    private bool isLearning = false;
    private string? currentSkillId;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private readonly SkillRepository _skillRepository = new SkillRepository();
    private SkillLearningManager? _learningManager;
    private List<SkillDef> learnableSkills = new();
    private List<SkillDef> learnedSkills = new();
    private List<SkillDef> lockedSkills = new();

    // 跟踪上一次的职业ID，用于检测职业切换
    private string _previousProfessionId = "";
    
    // CancellationToken for cleanup
    private CancellationTokenSource? _cancellationTokenSource;
    
    // Cache for character data to avoid redundant refreshes
    private CharacterData? _previousCharacter;
    private int _previousCharacterLevel = -1;

    // 列表分类过滤
    private enum SkillListFilter { Learnable, Learned, Locked }
    private SkillListFilter currentFilter = SkillListFilter.Learnable;

    // 当前选中技能
    private string? selectedSkillId;
    private SkillDef? SelectedSkill => GetSkillFromLists(selectedSkillId);

    private int learnableCount => learnableSkills.Count;
    private int learnedCount => learnedSkills.Count;
    private int lockedCount => lockedSkills.Count;

    private string ProfessionName => GetProfessionName(ProfessionId);

    protected override void OnInitialized()
    {
        isCollapsed = StartCollapsed;
        _learningManager = new SkillLearningManager(_skillRepository);
        // 初始化购买服务（如果角色数据可用）
        if (Character != null)
        {
            _learningManager.InitializePurchaseService(Character.PurchaseState);
        }
        _previousProfessionId = ProfessionId;
        _cancellationTokenSource = new CancellationTokenSource();
    }

    protected override void OnParametersSet()
    {
        var professionChanged = _previousProfessionId != ProfessionId;
        var characterChanged = _previousCharacter != Character;
        var currentLevel = GetCharacterLevel();
        var levelChanged = _previousCharacterLevel != currentLevel;
        
        // 初始化购买服务（当角色数据可用时）
        if (Character != null && _learningManager != null)
        {
            _learningManager.InitializePurchaseService(Character.PurchaseState);
        }
        
        // 检测职业是否切换
        if (professionChanged)
        {
#if DEBUG
            Console.WriteLine($"[SkillLearningPanel] Profession changed from {_previousProfessionId} to {ProfessionId}");
#endif
            _previousProfessionId = ProfessionId;

            // 切换职业时清除消息与当前选中
            errorMessage = string.Empty;
            successMessage = string.Empty;
            selectedSkillId = null;
            currentFilter = SkillListFilter.Learnable;
        }

        // Only refresh if data actually changed
        if (professionChanged || characterChanged || levelChanged)
        {
            RefreshSkillLists();
            _previousCharacter = Character;
            _previousCharacterLevel = currentLevel;
        }
        
        EnsureSelection();
        EnsureSelectionForFilter();
    }

    private void RefreshSkillLists()
    {
        if (Character == null || _learningManager == null)
        {
            learnableSkills.Clear();
            learnedSkills.Clear();
            lockedSkills.Clear();
            return;
        }

        var characterLevel = GetCharacterLevel();

        // 只显示可学习技能（排除触发技能）
        var learnableOnlySkills = _skillRepository.GetSkillsByProfession(ProfessionId)
            .Where(s => !s.Fixed && s.Unlock != null)
            .ToList();

        // 固定技能（职业自带技能），排除怪物技能
        var fixedSkills = _skillRepository.GetSkillsByProfession(ProfessionId)
            .Where(s => s.Fixed &&
                        s.AllowedProfessions != null &&
                        s.AllowedProfessions.Count > 0 &&
                        s.AllowedProfessions.Contains(ProfessionId))
            .ToList();

        // 分类技能
        learnableSkills = learnableOnlySkills
            .Where(s => !Character.LearnedSkills.Contains(s.Id) &&
                        _learningManager.CanLearnSkill(Character, s.Id, characterLevel, ProfessionId))
            .ToList();

        // 已学习 = 已学会的可学习技能 + 固定技能
        learnedSkills = learnableOnlySkills
            .Where(s => Character.LearnedSkills.Contains(s.Id))
            .Concat(fixedSkills)
            .ToList();

        lockedSkills = learnableOnlySkills
            .Where(s => !Character.LearnedSkills.Contains(s.Id) &&
                        !_learningManager.CanLearnSkill(Character, s.Id, characterLevel, ProfessionId))
            .ToList();
    }

    private async Task LearnSkill(string skillId)
    {
        if (Character == null || _learningManager == null || isLearning)
            return;

        errorMessage = string.Empty;
        successMessage = string.Empty;
        isLearning = true;
        currentSkillId = skillId;

        try
        {
            var characterLevel = GetCharacterLevel();
            // 使用新的购买方法（支持免费和付费学习）
            var (success, message) = _learningManager.LearnSkillWithPurchase(
                Character, skillId, characterLevel, ProfessionId);

            if (success)
            {
                successMessage = message;

#if DEBUG
                Console.WriteLine($"[SkillLearningPanel] Skill learned: {skillId}");
                Console.WriteLine($"[SkillLearningPanel] Total learned skills: {Character.LearnedSkills.Count}");
                Console.WriteLine($"[SkillLearningPanel] Learned skills: {string.Join(", ", Character.LearnedSkills)}");
#endif

                RefreshSkillLists();

                // 学习后保持选中与当前分类
                selectedSkillId = skillId;
                EnsureSelectionForFilter();

                if (OnSkillLearned.HasDelegate)
                {
#if DEBUG
                    Console.WriteLine($"[SkillLearningPanel] Invoking OnSkillLearned callback...");
#endif
                    await OnSkillLearned.InvokeAsync();
#if DEBUG
                    Console.WriteLine($"[SkillLearningPanel] OnSkillLearned callback completed");
#endif
                }

                // 2秒后清除成功消息，使用CancellationToken避免内存泄漏
                _ = Task.Delay(2000, _cancellationTokenSource?.Token ?? CancellationToken.None)
                    .ContinueWith(async _ =>
                    {
                        if (!(_cancellationTokenSource?.IsCancellationRequested ?? true))
                        {
                            successMessage = string.Empty;
                            await InvokeAsync(StateHasChanged);
                        }
                    }, TaskScheduler.Default);
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"学习技能失败: {ex.Message}";
        }
        finally
        {
            isLearning = false;
            currentSkillId = null;
        }
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;

    private int GetCharacterLevel()
    {
        if (Character == null)
            return 1;

        if (Character.Professions.TryGetValue(ProfessionId, out var profession))
        {
            return profession.Level;
        }

        return 1;
    }

    private string GetSkillIcon(SkillDef skill)
    {
        if (skill.ReleaseType == "cast")
            return "🔮";
        else if (skill.SlotType == "passive")
            return "⚡";
        else if (skill.TargetPolicy == "enemies_all" || skill.TargetPolicy == "allies_all")
            return "💥";
        else
            return "⚔️";
    }

    private string GetSkillTypeText(SkillDef skill)
    {
        if (skill.SlotType == "passive")
            return "被动";
        else if (skill.ReleaseType == "cast")
            return "施法";
        else
            return "瞬发";
    }

    private string GetSkillTypeCssClass(SkillDef skill)
    {
        if (skill.SlotType == "passive")
            return "badge-passive";
        else if (skill.ReleaseType == "cast")
            return "badge-cast";
        else
            return "badge-instant";
    }

    private string GetSkillDescription(SkillDef skill)
    {
        if (!string.IsNullOrEmpty(skill.Description))
            return skill.Description;

        if (skill.Damage != null)
        {
            var dmgText = $"{skill.Damage.CoefAtk:P0} 攻击力";
            if (skill.Damage.Flat > 0)
                dmgText += $" + {skill.Damage.Flat}";
            if (skill.TargetPolicy == "enemies_all" || "allies_all" == skill.TargetPolicy)
                dmgText += " (AOE)";
            return $"造成 {dmgText} 伤害";
        }

        return skill.Type == "passive" ? "被动效果" : "特殊技能";
    }

    private string GetResourceName(string bucketId)
    {
        return bucketId switch
        {
            "rage" => "怒气",
            "mana" => "法力",
            "energy" => "能量",
            _ => bucketId
        };
    }

    private string GetProfessionName(string professionId)
    {
        return professionId switch
        {
            "warrior" => "战士",
            "mage" => "法师",
            "ranger" => "游侠",
            "rogue" => "盗贼",
            _ => professionId
        };
    }

    // 过滤与选择
    private IEnumerable<SkillDef> GetFilteredList() => currentFilter switch
    {
        SkillListFilter.Learnable => learnableSkills,
        SkillListFilter.Learned => learnedSkills,
        SkillListFilter.Locked => lockedSkills,
        _ => learnableSkills
    };

    private void SetFilter(SkillListFilter filter)
    {
        if (currentFilter == filter) return;
        currentFilter = filter;
        // 切换分类时清空消息，保持选中在当前分类内
        errorMessage = string.Empty;
        successMessage = string.Empty;
        EnsureSelectionForFilter();
    }

    private void EnsureSelection()
    {
        var allIds = learnableSkills.Select(s => s.Id)
            .Concat(learnedSkills.Select(s => s.Id))
            .Concat(lockedSkills.Select(s => s.Id))
            .ToList();

        if (selectedSkillId == null || !allIds.Contains(selectedSkillId))
        {
            selectedSkillId = allIds.FirstOrDefault();
        }
    }

    private void EnsureSelectionForFilter()
    {
        var ids = GetFilteredList().Select(s => s.Id).ToList();
        if (ids.Count == 0)
        {
            selectedSkillId = null;
            return;
        }

        if (selectedSkillId == null || !ids.Contains(selectedSkillId))
        {
            selectedSkillId = ids.FirstOrDefault();
        }
    }

    private void SelectSkill(string skillId)
    {
        selectedSkillId = skillId;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private bool IsSelected(string skillId) => selectedSkillId == skillId;
    private bool IsInList(List<SkillDef> list, string skillId) => list.Any(s => s.Id == skillId);

    private SkillDef? GetSkillFromLists(string? skillId)
        => skillId is null
            ? null
            : learnableSkills.FirstOrDefault(s => s.Id == skillId)
              ?? learnedSkills.FirstOrDefault(s => s.Id == skillId)
              ?? lockedSkills.FirstOrDefault(s => s.Id == skillId);

    private string GetItemStateClass(string skillId)
    {
        if (learnableSkills.Any(s => s.Id == skillId)) return "learnable";
        if (learnedSkills.Any(s => s.Id == skillId)) return "learned";
        if (lockedSkills.Any(s => s.Id == skillId)) return "locked";
        return string.Empty;
    }

