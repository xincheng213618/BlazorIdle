        _ => targetPolicy
    };

    private bool IsAoESkill(string targetPolicy) =>
        targetPolicy == "enemies_all" || targetPolicy == "allies_all";

    private string GetBuffOpText(BlazorIdle.Game.Skills.BuffOperationType opType) => opType switch
    {
        BlazorIdle.Game.Skills.BuffOperationType.Apply => "施加",
        BlazorIdle.Game.Skills.BuffOperationType.Remove => "移除",
        _ => opType.ToString()
    };

