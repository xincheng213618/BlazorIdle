    }

    .badge-instant {
        background: #ffc107;
        color: #212529;
    }

    .learn-btn {
        margin-top: 0;
        padding: 6px 16px;
        font-weight: 500;
    }

    .skill-details {
        padding-left: 60px;
    }

    .skill-description {
        color: #666;
        font-size: 0.95rem;
