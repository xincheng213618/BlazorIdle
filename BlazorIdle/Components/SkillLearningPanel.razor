    {
        "OnAttackHit" => "攻击命中",
        "OnCastComplete" => "施法完成",
        "OnDamageTaken" => "受到伤害",
        "OnHeal" => "治疗时",
        "OnKill" => "击杀时",
        "OnBuffApplied" => "Buff施加",
        "OnBuffExpired" => "Buff过期",
        _ => when
    };

    // 数值格式化辅助方法
    // Number formatting helper methods
    
    /// <summary>
    /// 格式化数值，处理浮点精度问题
    /// Format number, handling floating point precision issues
    /// </summary>
    private string FormatNumber(double value)
    {
        // 如果是整数或接近整数，显示为整数
        if (Math.Abs(value - Math.Round(value)) < 0.001)
            return Math.Round(value).ToString("F0");
        
        // 否则保留1位小数
        return value.ToString("F1");
    }

    /// <summary>
    /// 格式化数值（整数重载）
    /// Format number (integer overload)
    /// </summary>
    private string FormatNumber(int value)
    {
        return value.ToString();
    }

    /// <summary>
    /// 格式化百分比（系数转百分比）
    /// Format percentage (coefficient to percentage)
    /// </summary>
    private string FormatPercentage(double coefficient)
    {
        var percentage = coefficient * 100;
        
        // 如果是整数或接近整数，显示为整数
        if (Math.Abs(percentage - Math.Round(percentage)) < 0.01)
            return $"{Math.Round(percentage):F0}%";
        
        // 否则保留1位小数
        return $"{percentage:F1}%";
    }

    // ========== Step 4: 购买系统相关方法 ==========

    /// <summary>
    /// 检查是否可以负担技能价格
    /// Check if can afford skill price
    /// </summary>
    private bool CanAffordSkill(SkillDef skill)
    {
        if (Character == null || _learningManager == null)
            return false;
        return _learningManager.CanAffordSkill(Character, skill);
    }

    /// <summary>
    /// 获取技能最终价格
    /// Get skill final price
    /// </summary>
    private int GetSkillFinalPrice(SkillDef skill)
    {
        if (_learningManager == null)
            return 0;
        return _learningManager.GetSkillFinalPrice(skill);
    }

    /// <summary>
    /// 获取剩余可购买次数
    /// Get remaining purchase count
    /// </summary>
    private int GetRemainingPurchases(string skillId)
    {
        if (Character == null || _learningManager == null)
            return -1;
        return _learningManager.GetRemainingPurchases(Character, skillId);
    }

    /// <summary>
    /// 获取金币余额
    /// Get gold balance
    /// </summary>
    private int GetGoldBalance()
    {
        if (Character == null)
            return 0;
        return Character.Inventory.GetItemQuantity("gold_coin");
    }

    /// <summary>
    /// Dispose pattern implementation to prevent memory leaks
    /// 实现Dispose模式以防止内存泄漏
    /// </summary>
    public void Dispose()
    {
        // Cancel any pending tasks
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
    }
}

