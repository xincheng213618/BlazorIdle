@using BlazorIdle.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Components
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameConfigService GameConfig

<div class="battle-card">
    <h3>战斗演示（持续战斗：复活/刷新由配置驱动）</h3>

    <!-- 职业 / 怪物选择 -->
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label">职业</label>
            <InputSelect class="form-control" @bind-Value="selectedProfessionId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                @foreach (var p in professions)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-6">
            <label class="form-label">怪物</label>
            <InputSelect class="form-control" @bind-Value="selectedMonsterId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                @foreach (var m in monsters)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="small text-muted mb-3">
        预估玩家输出 DPS：@($"{theoreticalDps:N1}") · 配置版本：@configVersion
        @if (!configReady)
        {
            <span class="text-warning ms-2">(配置加载中...)</span>
        }
        <span class="float-end" title="@($"{snapshot.ElapsedMs / 1000.0:0.00}s")">用时: @FormatDuration(snapshot.ElapsedMs)</span>
    </div>

    <!-- 角色/怪物 面板 -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <CharacterPanel Title="玩家"
                            Subtitle="@currentProfession?.Name"
                            Tag="@selectedProfessionId"
                            StatusText="@PlayerStatusText"
                            Hp="@snapshot.PlayerHp"
                            MaxHp="@snapshot.PlayerMaxHp"
                            AttackProgress01="@attackProgress01"
                            AttackRemainMs="@attackRemainMs"
                            SpecialProgress01="@specialProgress01"
                            SpecialRemainMs="@specialRemainMs" />
        </div>

        <div class="col-12 col-lg-6">
            <MonsterPanel Title="@currentMonster?.Name"
                          Level="@(currentMonster?.Level)"
                          Tag="@selectedMonsterId"
                          StatusText="@EnemyStatusText"
                          Hp="@snapshot.EnemyHp"
                          MaxHp="@snapshot.EnemyMaxHp"
                          EnemyAttackProgress01="@enemyProgress01"
                          EnemyAttackRemainMs="@enemyRemainMs" />
        </div>
    </div>

    <!-- 控制按钮 -->
    <div class="btn-group mb-3">
        <button class="btn btn-success" @onclick="StartBattle" disabled="@(!configReady || isRunning)">开始战斗</button>
        <button class="btn btn-warning" @onclick="StopBattle" disabled="@(isRunning == false)">停止</button>
        <button class="btn btn-secondary" @onclick="ResetBattle" disabled="@isRunning">重置</button>
    </div>

    <!-- 日志组件 -->
    <LogPanel Title="战斗日志"
              Lines="@logs"
              OnClear="@ClearLogs"
              AutoScroll="true"
              AutoScrollTolerancePx="30"
              AutoScrollSmooth="false" />
</div>

@code {
    private const int TickMs = 100;

    // 配置选择
    private List<ProfessionDef> professions = new();
    private List<MonsterDef> monsters = new();
    private string? selectedProfessionId;
    private string? selectedMonsterId;
    private ProfessionDef? currentProfession => professions.FirstOrDefault(p => p.Id == selectedProfessionId);
    private MonsterDef? currentMonster => monsters.FirstOrDefault(m => m.Id == selectedMonsterId);
    private string configVersion = "loading";
    private bool configReady = false;

    private BattleInstance? battle;
    private BattleSnapshot snapshot = new BattleSnapshot { EnemyHp = 0, EnemyMaxHp = 1, PlayerHp = 0, PlayerMaxHp = 1, ElapsedMs = 0, Outcome = BattleOutcome.Ongoing, LoopState = LoopState.Fighting };
    private BattleDigest? digest;
    private bool isRunning = false;

    private double theoreticalDps => battle?.TheoreticalDps() ?? 0.0;

    // 状态文本
    private string PlayerStatusText => snapshot.WaitingPlayerRevive ? $"等待复活 {(snapshot.TimeToResumeMs / 1000.0):0.00}s" : "战斗中";
    private string EnemyStatusText => snapshot.WaitingEnemyRespawn ? $"等待刷新 {(snapshot.TimeToResumeMs / 1000.0):0.00}s" : "战斗中";

    // 进度（0..1）与剩余毫秒（从战斗实例读取）
    private double attackProgress01 => battle?.AttackProgress01 ?? 0.0;
    private double specialProgress01 => battle?.SpecialProgress01 ?? 0.0;
    private double enemyProgress01 => battle?.EnemyProgress01 ?? 0.0;
    private double attackRemainMs => battle?.AttackTimeToNextMs ?? 0.0;
    private double specialRemainMs => battle?.SpecialTimeToNextMs ?? 0.0;
    private double enemyRemainMs => battle?.EnemyTimeToNextMs ?? 0.0;

    // 日志
    private const int MaxLogEntries = 200;
    private readonly List<string> logs = new();

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        professions = GameConfig.Professions.ToList();
        monsters = GameConfig.Monsters.ToList();
        configVersion = GameConfig.Version;

        selectedProfessionId = professions.FirstOrDefault()?.Id;
        selectedMonsterId = monsters.FirstOrDefault()?.Id;

        configReady = professions.Count > 0 && monsters.Count > 0;

        ResetBattle();
    }

    private void OnSelectionChanged(ChangeEventArgs _)
    {
        if (!isRunning) ResetBattle();
    }

    private void BuildBattle()
    {
        if (battle is not null) battle.CombatEventFired -= OnCombatEvent;

        var p = currentProfession ?? professions.First();
        var m = currentMonster ?? monsters.First();

        var clock = new SimClock();
        int seed = HashSeed(p.Id, m.Id, configVersion);
        var rng = new RngContext(seed);

        var character = new Character
        {
            MaxHp = Math.Max(1, p.MaxHp),
            Hp = Math.Max(1, p.MaxHp),
            AttackRateAPS = p.AttackRateAPS,
            DamagePerAttack = p.DamagePerAttack,
            HastePercent = p.HastePercent,
            SpecialIntervalSec = p.SpecialIntervalSec,
            SpecialDamage = p.SpecialDamage,
            CritChancePercent = p.CritChancePercent,
            CritMultiplier = p.CritMultiplier,
            VariancePct = p.VariancePct,
            ReviveMs = (int)Math.Round(Math.Max(0, p.ReviveSec) * 1000.0)
        };

        var enemy = new Enemy
        {
            MaxHp = Math.Max(1, m.MaxHp),
            Hp = Math.Max(1, m.MaxHp),
            AttackIntervalSec = Math.Max(0.1, m.AttackIntervalSec),
            DamagePerHit = Math.Max(1, m.DamagePerHit),
            VariancePct = m.VariancePct,
            RespawnMs = (int)Math.Round(Math.Max(0, m.RespawnSec) * 1000.0)
        };

        battle = new BattleInstance(clock, rng, character, enemy);
        battle.CombatEventFired += OnCombatEvent;
        digest = null;
    }

    private int HashSeed(params object[] arr)
    {
        unchecked
        {
            int h = 17;
            foreach (var o in arr) h = h * 31 + (o?.GetHashCode() ?? 0);
            return h == 0 ? 1234567 : h;
        }
    }

    private void StartBattle()
    {
        if (!configReady || isRunning) return;

        BuildBattle();
        battle!.Start();
        snapshot = battle!.GetSnapshot();
        digest = null;
        isRunning = true;

        logs.Clear();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = RunLoopAsync(_cts.Token);
    }

    private void StopBattle()
    {
        if (!isRunning) return;
        isRunning = false;
        battle?.Stop();
        _cts?.Cancel();
        snapshot = battle!.GetSnapshot();
        digest ??= battle!.BuildDigest();
        StateHasChanged();
    }

    private void ResetBattle()
    {
        StopBattle();
        BuildBattle();
        snapshot = battle!.GetSnapshot();
        StateHasChanged();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && isRunning)
            {
                await Task.Delay(TickMs, token);
                battle!.AdvanceTick(TickMs);
                snapshot = battle!.GetSnapshot();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void OnCombatEvent(CombatEvent ev)
    {
        var sec = ev.TimeMs / 1000.0;
        var who = ev.Attacker == ActorType.Player ? "玩家" : "敌人";
        var target = ev.Defender == ActorType.Player ? "玩家" : "敌人";
        var src = ev.Source switch
        {
            EventSource.Attack => "Attack",
            EventSource.Special => "Special",
            EventSource.EnemyAttack => "EnemyAtk",
            _ => "Unknown"
        };

        var line = $"[{sec:0.00}s] {who}-{src} 命中，伤害 {ev.Damage}，{target}HP→ {ev.DefenderHpAfter}，RNGidx={ev.RngIndexAfter}";
        logs.Add(line);
        if (logs.Count > MaxLogEntries) logs.RemoveRange(0, logs.Count - MaxLogEntries);

        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearLogs()
    {
        logs.Clear();
        StateHasChanged();
    }

    // 友好显示用时：<1h 显示 mm:ss.cc；>=1h 显示 hh:mm:ss
    private static string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalHours >= 1)
        {
            return $"{(int)ts.TotalHours:00}:{ts.Minutes:00}:{ts.Seconds:00}";
        }
        return $"{ts.Minutes:00}:{ts.Seconds:00}.{ts.Milliseconds / 10:00}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (battle is not null) battle.CombatEventFired -= OnCombatEvent;
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}

<style>
    .battle-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }
</style>