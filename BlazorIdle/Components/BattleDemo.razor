@using BlazorIdle.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Components
@using BlazorIdle.Shared.Models
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameConfigService GameConfig

<div class="battle-card">
    @if (SelectedCharacter == null)
    {
        <div class="alert alert-info">
            请先在上方创建并选择一个角色
        </div>
    }
    else
    {
        <!-- 角色信息展示 -->
        <div class="character-info mb-3">
            <h5>当前角色: @SelectedCharacter.Name</h5>
            <p class="text-muted mb-0">职业: @(GetProfessionName(SelectedCharacter.ProfessionId))</p>
        </div>

        <!-- 怪物选择 -->
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label">怪物</label>
                <InputSelect class="form-control" @bind-Value="selectedMonsterId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                    @foreach (var m in monsters)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="small text-muted mb-3">
            预估玩家输出 DPS：@($"{theoreticalDps:N1}") · 配置版本：@configVersion
            @if (!configReady)
            {
                <span class="text-warning ms-2">(配置加载中...)</span>
            }
            <span class="float-end" title="@($"{snapshot.ElapsedMs / 1000.0:0.00}s")">用时: @FormatDuration(snapshot.ElapsedMs)</span>
        </div>

        <!-- 角色/怪物 面板 -->
        <div class="row g-3 mb-3">
            <div class="col-12 col-lg-6">
                <CharacterPanel Title="@SelectedCharacter.Name"
                                Subtitle="@GetProfessionName(SelectedCharacter.ProfessionId)"
                                Tag="@SelectedCharacter.Id"
                                StatusText="@PlayerStatusText"
                                Hp="@GetPlayerHp()"
                                MaxHp="@GetPlayerMaxHp()"
                                AttackProgress01="@attackProgress01"
                                AttackRemainMs="@attackRemainMs"
                                SpecialProgress01="@specialProgress01"
                                SpecialRemainMs="@specialRemainMs" />
            </div>

            <div class="col-12 col-lg-6">
                <MonsterPanel Title="@currentMonster?.Name"
                              Level="@(currentMonster?.Level)"
                              Tag="@selectedMonsterId"
                              StatusText="@EnemyStatusText"
                              Hp="@GetEnemyHp()"
                              MaxHp="@GetEnemyMaxHp()"
                              EnemyAttackProgress01="@enemyProgress01"
                              EnemyAttackRemainMs="@enemyRemainMs" />
            </div>
        </div>

        <!-- 控制按钮 -->
        <div class="btn-group mb-3">
            <button class="btn btn-success" @onclick="StartBattle" disabled="@(!configReady || isRunning)">开始战斗</button>
            <button class="btn btn-warning" @onclick="StopBattle" disabled="@(isRunning == false)">停止</button>
            <button class="btn btn-secondary" @onclick="ResetBattle" disabled="@isRunning">重置</button>
        </div>

        <!-- 日志组件 -->
        <LogPanel Title="战斗日志"
                  Lines="@logs"
                  OnClear="@ClearLogs"
                  AutoScroll="true"
                  AutoScrollTolerancePx="30"
                  AutoScrollSmooth="false" />
    }
</div>

@code {
    // 战斗循环间隔（毫秒）- 控制游戏更新频率
    // Battle loop interval (ms) - controls game update frequency
    private const int TickMs = 100;

    [Parameter]
    public CharacterData? SelectedCharacter { get; set; }

    // 配置选择
    // Configuration selection
    private List<ProfessionDef> professions = new();
    private List<MonsterDef> monsters = new();
    private string? selectedMonsterId;
    private MonsterDef? currentMonster => monsters.FirstOrDefault(m => m.Id == selectedMonsterId);
    private string configVersion = "loading";
    private bool configReady = false;

    // 多单位战斗系统（用于1v1战斗）
    // Multi-unit battle system (used for 1v1 battle)
    private MultiBattleInstance? battle;
    private MultiBattleSnapshot snapshot = new MultiBattleSnapshot();
    
    // 战斗队伍 - 包装单个角色和怪物
    // Battle teams - wrapping single character and monster
    private BattleTeam<Character>? playerTeam;
    private BattleTeam<Enemy>? enemyTeam;
    
    private BattleDigest? digest;
    private bool isRunning = false;

    // 理论DPS计算（基于角色属性）
    // Theoretical DPS calculation (based on character attributes)
    private double theoreticalDps
    {
        get
        {
            if (SelectedCharacter == null) return 0.0;
            
            var hasteFactor = 1.0 + SelectedCharacter.HastePercent / 100.0;
            var attackDps = SelectedCharacter.DamagePerAttack * SelectedCharacter.AttackRateAPS * hasteFactor;
            var specialDps = SelectedCharacter.SpecialDamage / Math.Max(0.1, SelectedCharacter.SpecialIntervalSec);
            return attackDps + specialDps;
        }
    }

    // 状态文本 - 根据战斗状态显示不同的提示信息
    // Status text - displays different prompt messages based on battle state
    private string PlayerStatusText
    {
        get
        {
            if (snapshot.State == MultiBattleState.PlayerTeamDeadCooldown)
                return $"等待复活 {(snapshot.TimeToResumeMs / 1000.0):0.00}s";
            return "战斗中";
        }
    }
    
    private string EnemyStatusText
    {
        get
        {
            if (snapshot.State == MultiBattleState.EnemyTeamDeadCooldown)
                return $"等待刷新 {(snapshot.TimeToResumeMs / 1000.0):0.00}s";
            return "战斗中";
        }
    }

    // 从战斗实例获取角色攻击进度
    // Get character attack progress from battle instance
    private double attackProgress01
    {
        get
        {
            if (battle == null || SelectedCharacter == null) return 0.0;
            return battle.GetCharacterAttackProgress(SelectedCharacter.Id);
        }
    }
    
    // 获取角色特殊技能进度
    // Get character special skill progress
    private double specialProgress01
    {
        get
        {
            if (battle == null || SelectedCharacter == null) return 0.0;
            return battle.GetCharacterSpecialProgress(SelectedCharacter.Id);
        }
    }
    
    // 获取敌人攻击进度
    // Get enemy attack progress
    private double enemyProgress01
    {
        get
        {
            if (battle == null || currentMonster == null) return 0.0;
            return battle.GetEnemyAttackProgress(currentMonster.Id);
        }
    }
    
    // 获取角色攻击剩余时间
    // Get character attack time remaining
    private double attackRemainMs
    {
        get
        {
            if (battle == null || SelectedCharacter == null) return 0.0;
            return battle.GetCharacterAttackTimeRemaining(SelectedCharacter.Id);
        }
    }
    
    // 获取角色特殊技能剩余时间
    // Get character special skill time remaining
    private double specialRemainMs
    {
        get
        {
            if (battle == null || SelectedCharacter == null) return 0.0;
            return battle.GetCharacterSpecialTimeRemaining(SelectedCharacter.Id);
        }
    }
    
    // 获取敌人攻击剩余时间
    // Get enemy attack time remaining
    private double enemyRemainMs
    {
        get
        {
            if (battle == null || currentMonster == null) return 0.0;
            return battle.GetEnemyAttackTimeRemaining(currentMonster.Id);
        }
    }

    // 日志
    private const int MaxLogEntries = 200;
    private readonly List<string> logs = new();

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        professions = GameConfig.Professions.ToList();
        monsters = GameConfig.Monsters.ToList();
        configVersion = GameConfig.Version;

        selectedMonsterId = monsters.FirstOrDefault()?.Id;

        configReady = monsters.Count > 0;

        if (SelectedCharacter != null)
        {
            ResetBattle();
        }
    }

    protected override void OnParametersSet()
    {
        if (SelectedCharacter != null && configReady && battle == null)
        {
            ResetBattle();
        }
    }

    private void OnSelectionChanged(ChangeEventArgs _)
    {
        if (!isRunning) ResetBattle();
    }

    private string GetProfessionName(string professionId)
    {
        return professions.FirstOrDefault(p => p.Id == professionId)?.Name ?? professionId;
    }

    /// <summary>
    /// 构建战斗实例 - 创建1v1战斗（使用多单位战斗系统）
    /// Build battle instance - creates 1v1 battle (using multi-unit battle system)
    /// </summary>
    private void BuildBattle()
    {
        if (SelectedCharacter == null) return;

        // 取消订阅旧战斗实例的事件
        // Unsubscribe from old battle instance events
        if (battle is not null)
        {
            battle.CombatEventFired -= OnCombatEvent;
            battle.LootDropped -= OnLootDropped;
        }

        var m = currentMonster ?? monsters.First();

        // 创建时钟和随机数生成器
        // Create clock and random number generator
        var clock = new SimClock();
        int seed = HashSeed(SelectedCharacter.Id, m.Id, configVersion);
        var rng = new RngContext(seed);

        // 创建角色实体（从SelectedCharacter复制属性）
        // Create character entity (copy properties from SelectedCharacter)
        var character = new Character
        {
            MaxHp = Math.Max(1, SelectedCharacter.MaxHp),
            Hp = Math.Max(1, SelectedCharacter.MaxHp),
            AttackRateAPS = SelectedCharacter.AttackRateAPS,
            DamagePerAttack = SelectedCharacter.DamagePerAttack,
            HastePercent = SelectedCharacter.HastePercent,
            SpecialIntervalSec = SelectedCharacter.SpecialIntervalSec,
            SpecialDamage = SelectedCharacter.SpecialDamage,
            CritChancePercent = SelectedCharacter.CritChancePercent,
            CritMultiplier = SelectedCharacter.CritMultiplier,
            VariancePct = SelectedCharacter.VariancePct,
            ReviveMs = (int)Math.Round(Math.Max(0, SelectedCharacter.ReviveSec) * 1000.0)
        };

        // 创建敌人实体（从怪物定义复制属性）
        // Create enemy entity (copy properties from monster definition)
        var enemy = new Enemy
        {
            MaxHp = Math.Max(1, m.MaxHp),
            Hp = Math.Max(1, m.MaxHp),
            AttackIntervalSec = Math.Max(0.1, m.AttackIntervalSec),
            DamagePerHit = Math.Max(1, m.DamagePerHit),
            VariancePct = m.VariancePct,
            RespawnMs = (int)Math.Round(Math.Max(0, m.RespawnSec) * 1000.0),
            LootDrops = m.LootDrops?.ToList() ?? new List<Game.Config.LootDrop>()
        };

        // 创建玩家队伍（单成员）
        // Create player team (single member)
        playerTeam = new BattleTeam<Character>("player_team", "玩家队伍", TeamType.Player);
        playerTeam.AddMember(SelectedCharacter.Id, character, character.MaxHp);

        // 创建敌人队伍（单成员）
        // Create enemy team (single member)
        enemyTeam = new BattleTeam<Enemy>("enemy_team", m.Name, TeamType.Enemy);
        enemyTeam.AddMember(m.Id, enemy, enemy.MaxHp);

        // 配置多单位战斗参数（从角色和怪物属性中获取）
        // Configure multi-battle parameters (from character and monster attributes)
        var config = new MultiBattleConfig
        {
            // 目标选择策略（1v1时无影响，但保持一致性）
            // Target selection strategy (no effect in 1v1, but keeps consistency)
            PlayerTargetStrategy = TargetStrategy.Random,
            EnemyTargetStrategy = TargetStrategy.Random,
            
            // 特殊技能为单体攻击（1v1场景）
            // Special skill is single-target (1v1 scenario)
            SpecialIsAoe = false,
            AoeDamageMultiplier = 1.0,
            
            // 允许玩家复活和敌人刷新（持续战斗模式）
            // Allow player revival and enemy respawn (continuous battle mode)
            AllowPlayerRevive = true,
            AllowEnemyRespawn = true,
            
            // 使用角色和怪物配置的复活/刷新时间
            // Use character and monster configured revival/respawn times
            PlayerReviveCooldownMs = character.ReviveMs,
            EnemyRespawnCooldownMs = enemy.RespawnMs,
            
            // 复活时满血
            // Revive with full HP
            ReviveWithFullHp = true
        };

        // 创建多单位战斗实例
        // Create multi-unit battle instance
        battle = new MultiBattleInstance(clock, rng, playerTeam, enemyTeam, config);
        
        // 订阅战斗事件
        // Subscribe to battle events
        battle.CombatEventFired += OnCombatEvent;
        battle.LootDropped += OnLootDropped;
        
        digest = null;
    }

    private int HashSeed(params object[] arr)
    {
        unchecked
        {
            int h = 17;
            foreach (var o in arr) h = h * 31 + (o?.GetHashCode() ?? 0);
            return h == 0 ? 1234567 : h;
        }
    }

    private void StartBattle()
    {
        if (!configReady || isRunning) return;

        BuildBattle();
        battle!.Start();
        snapshot = battle!.GetSnapshot();
        digest = null;
        isRunning = true;

        logs.Clear();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = RunLoopAsync(_cts.Token);
    }

    private void StopBattle()
    {
        if (!isRunning) return;
        isRunning = false;
        battle?.Stop();
        _cts?.Cancel();
        snapshot = battle!.GetSnapshot();
        digest ??= battle!.BuildDigest();
        StateHasChanged();
    }

    /// <summary>
    /// 重置战斗 - 停止当前战斗并重新构建
    /// Reset battle - stop current battle and rebuild
    /// </summary>
    private void ResetBattle()
    {
        StopBattle();
        BuildBattle();
        if (battle != null)
        {
            snapshot = battle.GetSnapshot();
        }
        StateHasChanged();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && isRunning)
            {
                await Task.Delay(TickMs, token);
                battle!.AdvanceTick(TickMs);
                snapshot = battle!.GetSnapshot();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    /// <summary>
    /// 战斗事件处理 - 处理战斗中的伤害事件并记录日志
    /// Combat event handler - handles damage events in battle and logs them
    /// </summary>
    private void OnCombatEvent(MultiCombatEvent ev)
    {
        // 转换时间为秒数
        // Convert time to seconds
        var sec = ev.TimeMs / 1000.0;

        // 获取攻击者和防御者的显示名称
        // Get attacker and defender display names
        var charName = string.IsNullOrWhiteSpace(SelectedCharacter?.Name) ? "未知角色" : SelectedCharacter!.Name;
        var monsterName = currentMonster?.Name
                          ?? monsters.FirstOrDefault(m => m.Id == selectedMonsterId)?.Name
                          ?? selectedMonsterId
                          ?? "未知怪物";

        // 动作来源标识
        // Action source identifier
        var src = ev.Source switch
        {
            EventSource.Attack => "Attack",
            EventSource.Special => "Special",
            EventSource.EnemyAttack => "EnemyAtk",
            _ => "Unknown"
        };

        // 确定攻击者和防御者的身份标签
        // Determine attacker and defender identity labels
        var attackerSide = ev.Attacker == ActorType.Player ? "玩家" : "怪物";
        var attackerName = ev.Attacker == ActorType.Player ? charName : monsterName;

        var defenderSide = ev.Defender == ActorType.Player ? "玩家" : "怪物";
        var defenderName = ev.Defender == ActorType.Player ? charName : monsterName;

        // 构建日志行（格式：时间 攻击者 动作 → 防御者，伤害，结果HP，RNG索引）
        // Build log line (format: time attacker action → defender, damage, result HP, RNG index)
        var line =
            $"[{sec:0.00}s] {attackerSide}:{attackerName} {src} 命中→{defenderSide}:{defenderName}，伤害 {ev.Damage}，{defenderSide}HP→ {ev.DefenderHpAfter}，RNGidx={ev.RngIndexAfter}";

        // 添加到日志列表，保持最大条目数限制
        // Add to log list, maintain max entries limit
        logs.Add(line);
        if (logs.Count > MaxLogEntries) logs.RemoveRange(0, logs.Count - MaxLogEntries);

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 清空战斗日志
    /// Clear combat logs
    /// </summary>
    private void ClearLogs()
    {
        logs.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// 获取玩家当前生命值 - 从玩家队伍中获取
    /// Get player current HP - retrieved from player team
    /// </summary>
    private int GetPlayerHp()
    {
        if (playerTeam == null || SelectedCharacter == null) return 0;
        var member = playerTeam.GetMember(SelectedCharacter.Id);
        return member?.CurrentHp ?? 0;
    }

    /// <summary>
    /// 获取玩家最大生命值 - 从玩家队伍中获取
    /// Get player max HP - retrieved from player team
    /// </summary>
    private int GetPlayerMaxHp()
    {
        if (playerTeam == null || SelectedCharacter == null) return 1;
        var member = playerTeam.GetMember(SelectedCharacter.Id);
        return member?.MaxHp ?? 1;
    }

    /// <summary>
    /// 获取敌人当前生命值 - 从敌人队伍中获取
    /// Get enemy current HP - retrieved from enemy team
    /// </summary>
    private int GetEnemyHp()
    {
        if (enemyTeam == null || currentMonster == null) return 0;
        var member = enemyTeam.GetMember(currentMonster.Id);
        return member?.CurrentHp ?? 0;
    }

    /// <summary>
    /// 获取敌人最大生命值 - 从敌人队伍中获取
    /// Get enemy max HP - retrieved from enemy team
    /// </summary>
    private int GetEnemyMaxHp()
    {
        if (enemyTeam == null || currentMonster == null) return 1;
        var member = enemyTeam.GetMember(currentMonster.Id);
        return member?.MaxHp ?? 1;
    }

    /// <summary>
    /// 处理掉落物事件 - 将掉落物添加到角色库存并记录统一风格的日志
    /// </summary>
    private void OnLootDropped(LootDropEvent lootEvent)
    {
        if (SelectedCharacter == null) return;

        // 更新库存
        SelectedCharacter.Inventory.AddItem(lootEvent.ItemId, lootEvent.Quantity);

        // 统一命名与 OnCombatEvent 一致的上下文取值
        var sec = lootEvent.TimeMs / 1000.0;
        var charName = string.IsNullOrWhiteSpace(SelectedCharacter?.Name) ? "未知角色" : SelectedCharacter!.Name;
        var monsterName = currentMonster?.Name ?? "未知怪物";
        var itemDef = GameConfig.GetItem(lootEvent.ItemId);
        var itemName = itemDef?.Name ?? lootEvent.ItemId;

        // 与 OnCombatEvent 风格统一：玩家:角色名 动作 内容
        var logLine = $"[{sec:0.00}s] 怪物:{monsterName} 掉落物品→玩家:{charName} 获得 {itemName} x{lootEvent.Quantity}";

        logs.Add(logLine);
        if (logs.Count > MaxLogEntries) logs.RemoveRange(0, logs.Count - MaxLogEntries);

        _ = InvokeAsync(StateHasChanged);
    }

    // 友好显示用时：<1h 显示 mm:ss.cc；>=1h 显示 hh:mm:ss
    private static string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalHours >= 1)
        {
            return $"{(int)ts.TotalHours:00}:{ts.Minutes:00}:{ts.Seconds:00}";
        }
        return $"{ts.Minutes:00}:{ts.Seconds:00}.{ts.Milliseconds / 10:00}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (battle is not null)
        {
            battle.CombatEventFired -= OnCombatEvent;
            battle.LootDropped -= OnLootDropped; // 取消订阅掉落物事件
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}

<style>
    .battle-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .character-info {
        background: #f8f9fa;
        border-left: 4px solid #0d6efd;
        padding: 15px;
        border-radius: 4px;
    }

    .character-info h5 {
        margin-bottom: 5px;
        color: #212529;
    }
</style>