@using BlazorIdle.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Components
@using BlazorIdle.Shared.Models
@using BlazorIdle.Services
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameConfigService GameConfig
@inject ILogger<BattleDemo> Logger

<div class="battle-card">
    @if (SelectedCharacter == null)
    {
        <div class="alert alert-info">
            请先在上方创建并选择一个角色
        </div>
    }
    else
    {
        <!-- 角色信息展示 -->
        <div class="character-info mb-3">
            <h5>当前角色: @SelectedCharacter.Name</h5>
            <p class="text-muted mb-0">职业: @(GetProfessionName(SelectedCharacter.ProfessionId))</p>
        </div>

        <!-- 战斗模式选择 - 普通战斗或副本战斗 -->
        <div class="row g-2 mb-3">
            <div class="col-12">
                <label class="form-label">战斗模式</label>
                <div class="btn-group w-100 battle-mode-group" role="group">
                    <input type="radio" class="btn-check" name="battleMode" id="normalMode" checked
                           @onchange="@(() => OnBattleModeChanged(BattleMode.Normal))" disabled="@isRunning">
                    <label class="btn btn-outline-primary" for="normalMode">普通战斗</label>

                    <input type="radio" class="btn-check" name="battleMode" id="dungeonMode"
                           @onchange="@(() => OnBattleModeChanged(BattleMode.Dungeon))" disabled="@isRunning">
                    <label class="btn btn-outline-primary" for="dungeonMode">副本战斗</label>
                </div>
            </div>
        </div>

        @if (currentBattleMode == BattleMode.Normal)
        {
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <label class="form-label">战斗场景</label>
                    <InputSelect class="form-control" @bind-Value="selectedScenarioId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                        @foreach (var scenario in battleScenarios)
                        {
                            <option value="@scenario.Id">@scenario.Name - @scenario.Description</option>
                        }
                    </InputSelect>
                </div>
            </div>
        }
        else
        {
            <!-- 副本战斗选择 -->
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <label class="form-label">副本选择</label>
                    <InputSelect class="form-control" @bind-Value="selectedDungeonId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                        @foreach (var dungeon in dungeons)
                        {
                            <option value="@dungeon.Id">
                                @dungeon.Name
                                @if (dungeon.DungeonType == DungeonType.Elite)
                                {
                                    <text>(精英)</text>
                                }
                                - Lv.@dungeon.RecommendedLevel
                            </option>
                        }
                    </InputSelect>
                </div>
            </div>

            @if (currentDungeon != null)
            {
                <DungeonInfo Dungeon="currentDungeon"
                             Snapshot="dungeonSnapshot"
                             IsRunning="isRunning" />
            }
        }

        <!-- 新属性系统配置 / New Attribute System Configuration -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>⚔️ 新伤害系统 - 职业属性+装备</span>
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="useAutoCalculatedStats" 
                               @bind="useAutoCalculatedStats" disabled="@(!useNewDamageSystem || isRunning)">
                        <label class="form-check-label small" for="useAutoCalculatedStats">自动计算</label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="useNewDamageSystem" 
                               @bind="useNewDamageSystem" disabled="@isRunning">
                        <label class="form-check-label" for="useNewDamageSystem">启用</label>
                    </div>
                </div>
            </div>
            @if (useNewDamageSystem)
            {
                <div class="card-body">
                    @if (useAutoCalculatedStats)
                    {
                        <div class="alert alert-info small mb-2 py-2">
                            <strong>生产模式</strong>：战斗属性 = 职业基础属性 + 装备属性（当前暂无装备）+ 下方额外加成
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning small mb-2 py-2">
                            <strong>测试模式</strong>：直接使用下方输入值作为战斗属性
                        </div>
                    }
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外攻击力" : "基础攻击力")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testAttackFinal" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外攻击%" : "攻击力加成%")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testAttackPercent" step="0.1" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外HP" : "最大HP")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testMaxHp" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">玩家元素</label>
                            <select class="form-select form-select-sm" @bind="testPlayerElement" disabled="@isRunning">
                                <option value="neutral">无属性</option>
                                <option value="fire">火</option>
                                <option value="water">水</option>
                                <option value="wind">风</option>
                                <option value="earth">地</option>
                                <option value="light">光</option>
                                <option value="dark">暗</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外暴击率%" : "暴击率%")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testCritChancePercent" step="0.1" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外暴伤%" : "暴击伤害加成%")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testCritDamageBonusPercent" step="0.1" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外盛体%" : "盛体态势上限%")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testFortifyMaxPercent" step="0.1" disabled="@isRunning" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">@(useAutoCalculatedStats ? "额外背水%" : "背水态势上限%")</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="testBackwaterMaxPercent" step="0.1" disabled="@isRunning" />
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        💡 @(useAutoCalculatedStats 
                            ? "生产模式：战斗属性从职业+装备自动计算，上方输入为额外加成（用于调试）。" 
                            : "测试模式：直接使用上方输入值作为战斗属性。")
                        怪物属性从 monsters.json 读取（baseAttack, element, damageReductionPercent）。
                    </div>
                </div>
            }
        </div>

        <div class="small text-muted mb-3">
            预估玩家输出 DPS：@($"{theoreticalDps:N1}") · 配置版本：@configVersion
            @if (!configReady)
            {
                <span class="text-warning ms-2">(配置加载中...)</span>
            }
            <span class="float-end" title="@($"{snapshot.ElapsedMs / 1000.0:0.00}s")">用时: @FormatDuration(snapshot.ElapsedMs)</span>
        </div>

        @* 仅在战斗实例存在时显示面板（动态创建模式）/ Only show panels when battle instance exists (dynamic creation mode) *@
        @if (battle != null && playerTeam != null && enemyTeam != null)
        {
            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-6">
                    <CharacterPanel Title="@SelectedCharacter.Name"
                                    Subtitle="@GetProfessionName(SelectedCharacter.ProfessionId)"
                                    Tag="@SelectedCharacter.Id"
                                    StatusText="@PlayerStatusText"
                                    Hp="@GetPlayerHp()"
                                    MaxHp="@GetPlayerMaxHp()"
                                    Resources="@playerResources"
                                    ResourceConfig="@playerResourceConfig"
                                    Buffs="@playerBuffs"
                                    EquippedSkills="@playerEquippedSkills"
                                    EquippedConsumables="@playerEquippedConsumables"
                                    IsCasting="@isCasting"
                                    CastingProgress01="@castingProgress01"
                                    CastingRemainMs="@castingRemainMs"
                                    CastingSkillName="@castingSkillName"
                                    AttackProgress01="@attackProgress01"
                                    AttackRemainMs="@attackRemainMs"
                                    SpecialProgress01="@specialProgress01"
                                    SpecialRemainMs="@specialRemainMs" />
                </div>

                <div class="col-12 col-lg-6">
                    <EnemyTeamPanel Title="敌人队伍"
                                    Team="@enemyTeam"
                                    Battle="@battle"
                                    NameResolver="@GetEnemyDisplayName" />
                </div>
            </div>
        }
        else
        {
            @* 战斗未开始时的占位提示 / Placeholder when battle not started *@
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <div class="alert alert-secondary text-center">
                        <i class="bi bi-info-circle me-2"></i>
                        点击"开始战斗"以创建战斗面板
                    </div>
                </div>
            </div>
        }

        <div class="btn-group mb-3">
            <button class="btn btn-success" @onclick="StartBattle" disabled="@(!configReady || isRunning)">开始战斗</button>
            <button class="btn btn-warning" @onclick="StopBattle" disabled="@(isRunning == false)">停止</button>
            <button class="btn btn-secondary" @onclick="ResetBattle" disabled="@isRunning">重置</button>
        </div>

        <LogPanel Title="战斗日志"
                  Lines="@logs"
                  OnClear="@ClearLogs"
                  AutoScroll="true"
                  AutoScrollTolerancePx="30"
                  AutoScrollSmooth="false" />
    }
</div>

<!-- 消耗品使用提示 / Consumable usage toast -->
<ConsumableUsedToast @ref="consumableToast" />