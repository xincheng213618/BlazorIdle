@using BlazorIdle.Game
@using BlazorIdle.Game.Config
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameConfigService GameConfig

<div class="battle-card">
    <h3>战斗演示（配置驱动：职业 + 怪物）</h3>

    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label">职业</label>
            <InputSelect class="form-control" @bind-Value="selectedProfessionId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                @foreach (var p in professions)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </InputSelect>
            @if (currentProfession is not null)
            {
                <small class="text-muted">HP=@currentProfession.MaxHp · APS=@currentProfession.AttackRateAPS · Atk=@currentProfession.DamagePerAttack · Haste=@currentProfession.HastePercent% · SpSec=@currentProfession.SpecialIntervalSec · SpDmg=@currentProfession.SpecialDamage · Crit=@currentProfession.CritChancePercent% x@currentProfession.CritMultiplier</small>
            }
        </div>

        <div class="col-6">
            <label class="form-label">怪物</label>
            <InputSelect class="form-control" @bind-Value="selectedMonsterId" disabled="@(!configReady || isRunning)" @onchange="OnSelectionChanged">
                @foreach (var m in monsters)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </InputSelect>
            @if (currentMonster is not null)
            {
                <small class="text-muted">Lv.@currentMonster.Level · HP=@currentMonster.MaxHp · Interval=@currentMonster.AttackIntervalSec s · Dmg=@currentMonster.DamagePerHit</small>
            }
        </div>
    </div>

    <div class="small text-muted mb-2">
        预估玩家输出 DPS：@theoreticalDps:0.0 · 配置版本：@configVersion
        @if (!configReady)
        {
            <span class="text-warning ms-2">(配置加载中...)</span>
        }
    </div>

    <!-- 双方 HP 条 -->
    <div class="mb-2">
        <div class="d-flex justify-content-between">
            <small class="text-muted">玩家 HP: @snapshot.PlayerHp / @snapshot.PlayerMaxHp</small>
            <small class="text-muted">用时: @(snapshot.ElapsedMs / 1000.0):0.0s</small>
        </div>
        <div class="progress">
            <div class="progress-bar bg-success" style="width:@($"{PlayerHpPercent}%")"></div>
        </div>
    </div>

    <div class="mb-2">
        <div class="d-flex justify-content-between">
            <small class="text-muted">敌人 HP: @snapshot.EnemyHp / @snapshot.EnemyMaxHp</small>
            <small class="text-muted">状态: @OutcomeText</small>
        </div>
        <div class="progress">
            <div class="progress-bar bg-danger" style="width:@($"{EnemyHpPercent}%")"></div>
        </div>
    </div>

    <!-- 轨道实时进度条 -->
    <div class="mb-2">
        <div class="d-flex justify-content-between small text-muted">
            <span>Attack 进度</span>
            <span>@(attackProgress01 * 100):0 % · 下次 @((attackRemainMs / 1000.0)):0.00s</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-primary" style="width:@($"{attackProgress01 * 100:0}%")"></div>
        </div>
    </div>

    <div class="mb-2">
        <div class="d-flex justify-content-between small text-muted">
            <span>Special 进度</span>
            <span>@(specialProgress01 * 100):0 % · 下次 @((specialRemainMs / 1000.0)):0.00s</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-info" style="width:@($"{specialProgress01 * 100:0}%")"></div>
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between small text-muted">
            <span>Enemy Attack 进度</span>
            <span>@(enemyProgress01 * 100):0 % · 下次 @((enemyRemainMs / 1000.0)):0.00s</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-secondary" style="width:@($"{enemyProgress01 * 100:0}%")"></div>
        </div>
    </div>

    <div class="btn-group mb-2">
        <button class="btn btn-success" @onclick="StartBattle" disabled="@(!configReady || isRunning)">开始战斗</button>
        <button class="btn btn-warning" @onclick="StopBattle" disabled="@(isRunning == false)">停止</button>
        <button class="btn btn-secondary" @onclick="ResetBattle" disabled="@isRunning">重置</button>
    </div>

    <!-- 日志区域与底部自动滚动代码保持不变 -->
    <div class="log-header d-flex justify-content-between align-items-center">
        <h5 class="mb-1">战斗日志</h5>
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="CopyLogs">复制</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ClearLogs">清空</button>
        </div>
    </div>
    <div class="log-panel" @ref="logPanelRef">
        @if (logs.Count == 0)
        {
            <div class="text-muted small">暂无日志</div>
        }
        else
        {
            @foreach (var line in logs)
            {
                <div class="log-line">@line</div>
            }
        }
    </div>

    @if (!_initial && snapshot.Finished)
    {
        <div class="alert alert-info py-2 mb-2">
            @(snapshot.Outcome == BattleOutcome.Victory ? "胜利！" : "失败！")
            用时 @(snapshot.ElapsedMs / 1000.0):0.0s，
            我方输出总伤害 @snapshot.TotalDamage
        </div>
    }
</div>

@code {
    private const int TickMs = 100;

    // 自动滚动容差与是否平滑滚动
    private const int AutoScrollTolerancePx = 12;
    private const bool AutoScrollSmooth = false;

    // 配置选择
    private List<ProfessionDef> professions = new();
    private List<MonsterDef> monsters = new();
    private string? selectedProfessionId;
    private string? selectedMonsterId;
    private ProfessionDef? currentProfession => professions.FirstOrDefault(p => p.Id == selectedProfessionId);
    private MonsterDef? currentMonster => monsters.FirstOrDefault(m => m.Id == selectedMonsterId);
    private string configVersion = "loading";
    private bool configReady = false;

    private BattleInstance? battle;
    private BattleSnapshot snapshot = new BattleSnapshot { EnemyHp = 0, EnemyMaxHp = 1, PlayerHp = 0, PlayerMaxHp = 1, ElapsedMs = 0, Outcome = BattleOutcome.Ongoing };
    private BattleDigest? digest;
    private bool isRunning = false;
    private bool _initial = true;

    private double theoreticalDps => battle?.TheoreticalDps() ?? 0.0;
    private int EnemyHpPercent => snapshot.EnemyMaxHp <= 0 ? 0 : (int)Math.Round(100.0 * snapshot.EnemyHp / Math.Max(1, snapshot.EnemyMaxHp));
    private int PlayerHpPercent => snapshot.PlayerMaxHp <= 0 ? 0 : (int)Math.Round(100.0 * snapshot.PlayerHp / Math.Max(1, snapshot.PlayerMaxHp));
    private string OutcomeText => snapshot.Outcome switch { BattleOutcome.Ongoing => "战斗中", BattleOutcome.Victory => "敌人已被击败", BattleOutcome.Defeat => "玩家已阵亡", _ => "未知" };

    // 轨道进度计算（0..1）和剩余毫秒
    private double attackProgress01 => battle?.AttackProgress01 ?? 0.0;
    private double specialProgress01 => battle?.SpecialProgress01 ?? 0.0;
    private double enemyProgress01 => battle?.EnemyProgress01 ?? 0.0;
    private double attackRemainMs => battle?.AttackTimeToNextMs ?? 0.0;
    private double specialRemainMs => battle?.SpecialTimeToNextMs ?? 0.0;
    private double enemyRemainMs => battle?.EnemyTimeToNextMs ?? 0.0;

    // 日志
    private const int MaxLogEntries = 200;
    private readonly List<string> logs = new();

    // JS 模块 & 元素引用（自动滚动）
    private ElementReference logPanelRef;
    private IJSObjectReference? _jsModule;
    private bool _shouldScrollToBottom;

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        professions = GameConfig.Professions.ToList();
        monsters = GameConfig.Monsters.ToList();
        configVersion = GameConfig.Version;

        // 默认选择第一个（一定存在：服务已做兜底）
        selectedProfessionId = professions.First().Id;
        selectedMonsterId = monsters.First().Id;

        configReady = GameConfig.IsLoaded && professions.Count > 0 && monsters.Count > 0;

        ResetBattle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/battleDemo.js"); } catch { }
        }

        if (_shouldScrollToBottom && _jsModule is not null)
        {
            _shouldScrollToBottom = false;
            try { await _jsModule.InvokeVoidAsync("scrollToBottomIfNear", logPanelRef, AutoScrollTolerancePx, AutoScrollSmooth); } catch { }
        }
    }

    private void OnSelectionChanged(ChangeEventArgs _)
    {
        if (!isRunning) ResetBattle();
    }

    private void BuildBattle()
    {
        if (battle is not null)
        {
            battle.CombatEventFired -= OnCombatEvent;
        }

        // 兜底：即使列表为空也能启动（极端情况下）
        var p = currentProfession ?? professions.FirstOrDefault() ?? new ProfessionDef { Id = "fallbackP", Name = "Fallback", MaxHp = 200, AttackRateAPS = 2.0, DamagePerAttack = 15, SpecialIntervalSec = 5, SpecialDamage = 120, CritChancePercent = 10, CritMultiplier = 1.5, VariancePct = 0.05 };
        var m = currentMonster ?? monsters.FirstOrDefault() ?? new MonsterDef { Id = "fallbackM", Name = "Fallback", Level = 1, MaxHp = 220, AttackIntervalSec = 2.0, DamagePerHit = 8, VariancePct = 0.05 };

        var clock = new SimClock();
        int seed = HashSeed(p.Id, m.Id, configVersion);
        var rng = new RngContext(seed);

        var character = new Character
        {
            MaxHp = Math.Max(1, p.MaxHp),
            Hp = Math.Max(1, p.MaxHp),
            AttackRateAPS = p.AttackRateAPS,
            DamagePerAttack = p.DamagePerAttack,
            HastePercent = p.HastePercent,
            SpecialIntervalSec = p.SpecialIntervalSec,
            SpecialDamage = p.SpecialDamage,
            CritChancePercent = p.CritChancePercent,
            CritMultiplier = p.CritMultiplier,
            VariancePct = p.VariancePct
        };

        var enemy = new Enemy
        {
            MaxHp = Math.Max(1, m.MaxHp),
            Hp = Math.Max(1, m.MaxHp),
            AttackIntervalSec = Math.Max(0.1, m.AttackIntervalSec),
            DamagePerHit = Math.Max(1, m.DamagePerHit),
            VariancePct = m.VariancePct
        };

        battle = new BattleInstance(clock, rng, character, enemy);
        battle.CombatEventFired += OnCombatEvent;
        digest = null;
    }

    private int HashSeed(params object[] arr)
    {
        unchecked
        {
            int h = 17;
            foreach (var o in arr) h = h * 31 + (o?.GetHashCode() ?? 0);
            return h == 0 ? 1234567 : h;
        }
    }

    private void StartBattle()
    {
        if (!configReady || isRunning) return;

        BuildBattle();
        battle!.Start();
        snapshot = battle!.GetSnapshot();
        digest = null;
        isRunning = true;
        _initial = false;

        logs.Clear();
        _shouldScrollToBottom = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = RunLoopAsync(_cts.Token);
    }

    private void StopBattle()
    {
        if (!isRunning) return;
        isRunning = false;
        battle?.Stop();
        _cts?.Cancel();
        snapshot = battle!.GetSnapshot();
        digest ??= battle!.BuildDigest();
        StateHasChanged();
    }

    private void ResetBattle()
    {
        StopBattle();
        BuildBattle();
        snapshot = battle!.GetSnapshot();
        StateHasChanged();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && isRunning)
            {
                await Task.Delay(TickMs, token);
                battle!.AdvanceTick(TickMs);
                snapshot = battle!.GetSnapshot();
                if (snapshot.Finished)
                {
                    isRunning = false;
                    digest = battle!.BuildDigest();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void OnCombatEvent(CombatEvent ev)
    {
        var sec = ev.TimeMs / 1000.0;
        var who = ev.Attacker == ActorType.Player ? "玩家" : "敌人";
        var target = ev.Defender == ActorType.Player ? "玩家" : "敌人";
        var src = ev.Source switch
        {
            EventSource.Attack => "Attack",
            EventSource.Special => "Special",
            EventSource.EnemyAttack => "EnemyAtk",
            _ => "Unknown"
        };

        var line = $"[{sec:0.00}s] {who}-{src} 命中，伤害 {ev.Damage}，{target}HP→ {ev.DefenderHpAfter}，RNGidx={ev.RngIndexAfter}";
        logs.Add(line);
        if (logs.Count > MaxLogEntries)
        {
            logs.RemoveRange(0, logs.Count - MaxLogEntries);
        }

        _shouldScrollToBottom = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearLogs()
    {
        logs.Clear();
        _shouldScrollToBottom = true;
    }

    private async Task CopyLogs()
    {
        var text = string.Join(Environment.NewLine, logs);
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (battle is not null) battle.CombatEventFired -= OnCombatEvent;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null) { try { await _jsModule.DisposeAsync(); } catch { } }
    }
}
<style>
    .battle-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .log-header {
        margin-top: 8px;
        margin-bottom: 6px;
    }

    .log-panel {
        height: 180px;
        overflow-y: auto;
        background: #0f172a;
        color: #e2e8f0;
        border: 1px solid #1e293b;
        border-radius: 6px;
        padding: 8px 10px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 12px;
        line-height: 1.4;
    }

    .log-line {
        white-space: pre-wrap;
    }
</style>