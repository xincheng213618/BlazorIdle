@using BlazorIdle.Game
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="battle-card">
    <h3>战斗演示（双轨 + Segment/Digest + 实时进度 + 日志）</h3>

    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label">怪物最大生命值</label>
            <InputNumber @bind-Value="enemyMaxHp" class="form-control" disabled="@isRunning" />
        </div>
        <div class="col-6">
            <label class="form-label">每击伤害（Attack）</label>
            <InputNumber @bind-Value="damagePerAttack" class="form-control" disabled="@isRunning" />
        </div>
        <div class="col-6">
            <label class="form-label">攻击速度 APS（次/秒）</label>
            <InputNumber @bind-Value="attackRateAPS" class="form-control" disabled="@isRunning" />
        </div>
        <div class="col-6">
            <label class="form-label">急速（%）仅影响 Attack</label>
            <InputNumber @bind-Value="hastePercent" class="form-control" disabled="@isRunning" />
        </div>
        <div class="col-6">
            <label class="form-label">Special 冷却（秒）</label>
            <InputNumber @bind-Value="specialIntervalSec" class="form-control" disabled="@isRunning" />
        </div>
        <div class="col-6">
            <label class="form-label">Special 伤害（点）</label>
            <InputNumber @bind-Value="specialDamage" class="form-control" disabled="@isRunning" />
        </div>
    </div>

    <div class="small text-muted mb-2">
        预估 DPS：@theoreticalDps:0.0（含急速与 Special）
    </div>

    <div class="mb-2">
        <div class="d-flex justify-content-between">
            <small class="text-muted">HP: @snapshot.EnemyHp / @snapshot.EnemyMaxHp</small>
            <small class="text-muted">用时: @(snapshot.ElapsedMs / 1000.0):0.0s</small>
        </div>
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@HpPercent">
            <div class="progress-bar bg-danger" style="width:@($"{HpPercent}%")"></div>
        </div>
    </div>

    <!-- 轨道实时进度条 -->
    <div class="mb-2">
        <div class="d-flex justify-content-between small text-muted">
            <span>Attack 进度</span>
            <span>@(attackProgress01 * 100):0 % · 下次 @((attackRemainMs / 1000.0)):0.00s</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-primary" style="width:@($"{attackProgress01 * 100:0}%")"></div>
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between small text-muted">
            <span>Special 进度</span>
            <span>@(specialProgress01 * 100):0 % · 下次 @((specialRemainMs / 1000.0)):0.00s</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-info" style="width:@($"{specialProgress01 * 100:0}%")"></div>
        </div>
    </div>

    <div class="btn-group mb-2">
        <button class="btn btn-success" @onclick="StartBattle" disabled="@isRunning">开始战斗</button>
        <button class="btn btn-warning" @onclick="StopBattle" disabled="@(isRunning == false)">停止</button>
        <button class="btn btn-secondary" @onclick="ResetBattle" disabled="@isRunning">重置</button>
    </div>

    <!-- 日志区域 -->
    <div class="log-header d-flex justify-content-between align-items-center">
        <h5 class="mb-1">战斗日志</h5>
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="CopyLogs">复制</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ClearLogs">清空</button>
        </div>
    </div>
    <div class="log-panel" @ref="logPanelRef">
        @if (logs.Count == 0)
        {
            <div class="text-muted small">暂无日志</div>
        }
        else
        {
            @foreach (var line in logs)
            {
                <div class="log-line">@line</div>
            }
        }
    </div>

    @if (!_initial && snapshot.Finished)
    {
        <div class="alert alert-info py-2 mb-2">
            胜利！用时 @(snapshot.ElapsedMs / 1000.0):0.0s，总伤害 @snapshot.TotalDamage
        </div>

        @if (digest is not null)
        {
            <div class="digest-card">
                <h5>BattleDigest（审计摘要）</h5>
                <ul class="mb-1">
                    <li>段数：@digest.SegmentCount</li>
                    <li>总事件：@digest.TotalEvents</li>
                    <li>总伤害：@digest.TotalDamage</li>
                    <li>平均 DPS：@digest.AverageDps:0.0</li>
                    <li>RNG 消耗区间：@digest.RngIndexStart - @digest.RngIndexEnd（Seed=@digest.Seed）</li>
                </ul>
                <div>
                    <strong>按来源伤害：</strong>
                    <ul class="mb-0">
                        <li>Attack：@(digest.DamageBySource.TryGetValue(nameof(EventSource.Attack), out var a) ? a : 0)</li>
                        <li>Special：@(digest.DamageBySource.TryGetValue(nameof(EventSource.Special), out var s) ? s : 0)</li>
                    </ul>
                </div>
            </div>
        }
    }
</div>

@code {
    private const int TickMs = 100;

    // 自动滚动容差与是否平滑滚动
    private const int AutoScrollTolerancePx = 12;
    private const bool AutoScrollSmooth = false;

    // 可编辑参数
    private int enemyMaxHp = 300;
    private int damagePerAttack = 15;
    private double attackRateAPS = 2.0;
    private double hastePercent = 0.0;
    private double specialIntervalSec = 5.0;
    private int specialDamage = 120;

    private BattleInstance? battle;
    private BattleSnapshot snapshot = new BattleSnapshot { EnemyHp = 0, EnemyMaxHp = 1, ElapsedMs = 0, Finished = true };
    private BattleDigest? digest;
    private bool isRunning = false;
    private bool _initial = true;

    private double theoreticalDps => battle?.TheoreticalDps() ?? 0.0;
    private int HpPercent => snapshot.EnemyMaxHp <= 0 ? 0 : (int)Math.Round(100.0 * snapshot.EnemyHp / Math.Max(1, snapshot.EnemyMaxHp));

    // 轨道进度计算（0..1）和剩余毫秒
    private double attackProgress01 => battle?.AttackProgress01 ?? 0.0;
    private double specialProgress01 => battle?.SpecialProgress01 ?? 0.0;
    private double attackRemainMs => battle?.AttackTimeToNextMs ?? 0.0;
    private double specialRemainMs => battle?.SpecialTimeToNextMs ?? 0.0;

    // 日志
    private const int MaxLogEntries = 200;
    private readonly List<string> logs = new();

    // JS 模块 & 元素引用
    private ElementReference logPanelRef;
    private IJSObjectReference? _jsModule;
    private bool _shouldScrollToBottom;

    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        ResetBattle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/battleDemo.js");
            }
            catch
            {
                // 模块加载失败时，仅失去自动滚动功能
            }
        }

        if (_shouldScrollToBottom && _jsModule is not null)
        {
            _shouldScrollToBottom = false;
            try
            {
                await _jsModule.InvokeVoidAsync(
                    "scrollToBottomIfNear",
                    logPanelRef,
                    AutoScrollTolerancePx,
                    AutoScrollSmooth
                );
            }
            catch
            {
                // 忽略：滚动失败不影响主流程
            }
        }
    }

    private void BuildBattle()
    {
        if (battle is not null)
        {
            battle.CombatEventFired -= OnCombatEvent;
        }

        var clock = new SimClock();
        int seed = HashSeed(enemyMaxHp, damagePerAttack, attackRateAPS, hastePercent, specialIntervalSec, specialDamage);
        var rng = new RngContext(seed);

        var player = new PlayerConfig
        {
            AttackRateAPS = attackRateAPS,
            DamagePerAttack = damagePerAttack,
            HastePercent = hastePercent,
            SpecialIntervalSec = specialIntervalSec,
            SpecialDamage = specialDamage,
            VariancePct = 0.05
        };

        var enemy = new EnemyState
        {
            MaxHp = Math.Max(1, enemyMaxHp),
            Hp = Math.Max(1, enemyMaxHp)
        };

        battle = new BattleInstance(clock, rng, player, enemy);
        battle.CombatEventFired += OnCombatEvent;
        digest = null;
    }

    private int HashSeed(params object[] arr)
    {
        unchecked
        {
            int h = 17;
            foreach (var o in arr)
            {
                h = h * 31 + (o?.GetHashCode() ?? 0);
            }
            return h == 0 ? 1234567 : h;
        }
    }

    private void StartBattle()
    {
        if (isRunning) return;

        BuildBattle();
        battle!.Start();
        snapshot = battle!.GetSnapshot();
        digest = null;
        isRunning = true;
        _initial = false;

        logs.Clear();
        _shouldScrollToBottom = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = RunLoopAsync(_cts.Token);
    }

    private void StopBattle()
    {
        if (!isRunning) return;
        isRunning = false;
        battle?.Stop();
        _cts?.Cancel();
        snapshot = battle!.GetSnapshot();
        digest ??= battle!.BuildDigest();
        StateHasChanged();
    }

    private void ResetBattle()
    {
        StopBattle();
        BuildBattle();
        snapshot = battle!.GetSnapshot();
        StateHasChanged();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && isRunning)
            {
                await Task.Delay(TickMs, token);
                battle!.AdvanceTick(TickMs);
                snapshot = battle!.GetSnapshot();
                if (snapshot.Finished)
                {
                    isRunning = false;
                    digest = battle!.BuildDigest();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // ignore
        }
    }

    private void OnCombatEvent(CombatEvent ev)
    {
        var sec = ev.TimeMs / 1000.0;
        var src = ev.Source == EventSource.Attack ? "Attack" : "Special";
        var line = $"[{sec:0.00}s] {src} 命中，伤害 {ev.Damage}，敌方HP→ {ev.EnemyHpAfter}，RNGidx={ev.RngIndexAfter}";
        logs.Add(line);
        if (logs.Count > MaxLogEntries)
        {
            logs.RemoveRange(0, logs.Count - MaxLogEntries);
        }

        _shouldScrollToBottom = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearLogs()
    {
        logs.Clear();
        _shouldScrollToBottom = true;
    }

    private async Task CopyLogs()
    {
        var text = string.Join(Environment.NewLine, logs);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // 忽略复制失败
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (battle is not null)
        {
            battle.CombatEventFired -= OnCombatEvent;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); } catch { }
        }
    }
}

<style>
    .battle-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .digest-card {
        background: #f8f9fa;
        border: 1px dashed #c8ced6;
        padding: 12px;
        border-radius: 6px;
    }

    .log-header {
        margin-top: 8px;
        margin-bottom: 6px;
    }

    .log-panel {
        height: 180px;
        overflow-y: auto;
        background: #0f172a;
        color: #e2e8f0;
        border: 1px solid #1e293b;
        border-radius: 6px;
        padding: 8px 10px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 12px;
        line-height: 1.4;
    }

    .log-line {
        white-space: pre-wrap;
    }
</style>