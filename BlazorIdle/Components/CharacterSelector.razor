@using BlazorIdle.Shared.Models
@using BlazorIdle.Services
@using BlazorIdle.Game.Config
@using BlazorIdle.Shared.DTOs
@inject ICharacterService CharacterService
@inject IGameConfigService GameConfig
@inject IJSRuntime JSRuntime

<div class="character-selector-card">
    <div class="cs-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">🎯</span>
            选择角色 (Select Character)
        </h5>
        <div class="d-flex align-items-center gap-2">
            @if (characterListResponse?.Characters is { Count: > 0 })
            {
                <small class="text-white-50 d-none d-sm-inline">共 @characterListResponse.Characters.Count 个角色</small>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="cs-body" style="@(isCollapsed ? "display:none" : null)">
        @if (isLoading)
        {
            <div class="text-muted">加载中...</div>
        }
        else if (characterListResponse == null || characterListResponse.Characters.Count == 0)
        {
            <div class="alert alert-info">
                暂无角色，请先创建一个角色。
            </div>
        }
        else
        {
            <div class="character-list">
                @foreach (var character in characterListResponse.Characters)
                {
                    var profession = GetProfession(character.ProfessionId);
                    var isSelected = selectedCharacterId == character.Id;

                    <div class="character-card @(isSelected ? "selected" : "")" @onclick="() => SelectCharacter(character.Id)">
                        <div class="character-header">
                            <div>
                                <div class="character-name">@character.Name</div>
                                <div class="character-profession">@(profession?.Name ?? character.ProfessionId)</div>
                            </div>
                            @if (isSelected)
                            {
                                <span class="badge bg-success">已选中</span>
                            }
                        </div>

                        <div class="character-stats">
                            <div class="stat-row">
                                <span>生命值: @character.MaxHp</span>
                                <span>攻速: @character.AttackRateAPS.ToString("F1")/s</span>
                            </div>
                            <div class="stat-row text-muted small">
                                <span>创建时间: @character.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>

                        <div class="character-actions">
                            <button class="btn btn-sm btn-danger"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => DeleteCharacter(character.Id)">
                                删除
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// 角色选择变更事件
    /// </summary>
    [Parameter]
    public EventCallback<CharacterData?> OnCharacterSelected { get; set; }

    /// <summary>
    /// 角色删除事件
    /// </summary>
    [Parameter]
    public EventCallback OnCharacterDeleted { get; set; }

    /// <summary>
    /// 初始是否折叠（默认不折叠）
    /// </summary>
    [Parameter]
    public bool StartCollapsed { get; set; }

    // 角色列表响应
    private CharacterListResponse? characterListResponse;
    // 当前选中的角色ID
    private string? selectedCharacterId;
    // 加载状态
    private bool isLoading = true;
    // 职业列表
    private List<ProfessionDef> professions = new();
    // 折叠状态
    private bool isCollapsed;

    protected override async Task OnInitializedAsync()
    {
        isCollapsed = StartCollapsed;
        await LoadData();
    }

    public async Task RefreshAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await GameConfig.EnsureLoadedAsync();
            professions = GameConfig.Professions.ToList();

            characterListResponse = await CharacterService.GetCharactersAsync();

            var selected = await CharacterService.GetSelectedCharacterAsync();
            selectedCharacterId = selected?.Id;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectCharacter(string characterId)
    {
        if (selectedCharacterId == characterId)
        {
            selectedCharacterId = null;
            await CharacterService.SetSelectedCharacterAsync(null);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(null);
            }
        }
        else
        {
            selectedCharacterId = characterId;
            await CharacterService.SetSelectedCharacterAsync(characterId);

            var character = characterListResponse?.Characters.FirstOrDefault(c => c.Id == characterId);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(character);
            }
        }
    }

    private async Task DeleteCharacter(string characterId)
    {
        var character = characterListResponse?.Characters.FirstOrDefault(c => c.Id == characterId);
        if (character == null) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除角色 '{character.Name}' 吗？此操作无法撤销。");
        if (!confirmed) return;

        try
        {
            var response = await CharacterService.DeleteCharacterAsync(characterId);
            if (response != null && response.Success)
            {
                await LoadData();

                if (OnCharacterDeleted.HasDelegate)
                {
                    await OnCharacterDeleted.InvokeAsync();
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "删除角色失败");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"删除角色失败: {ex.Message}");
        }
    }

    private ProfessionDef? GetProfession(string professionId)
        => professions.FirstOrDefault(p => p.Id == professionId);

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
}

<style>
    .character-selector-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
        /* 原来卡片有 padding，这里改为由 .cs-body 控制内边距 */
        padding: 0;
    }

    .cs-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .cs-header .btn {
            margin-top: 0; /* 覆盖全局 .btn 的 20px 上边距，保证与标题对齐 */
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .cs-body {
        padding: 20px;
    }

    .character-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
    }

    .character-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
    }

        .character-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .character-card.selected {
            border-color: #198754;
            background: #f0fdf4;
        }

    .character-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .character-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #212529;
    }

    .character-profession {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .character-stats {
        margin: 10px 0;
        padding: 10px 0;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9rem;
    }

    .character-actions {
        margin-top: 10px;
        display: flex;
        justify-content: flex-end;
    }

        .character-actions button {
            opacity: 0.7;
        }

            .character-actions button:hover {
                opacity: 1;
            }
</style>