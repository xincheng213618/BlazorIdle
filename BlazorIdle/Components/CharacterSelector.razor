@using BlazorIdle.Shared.Models
@using BlazorIdle.Services
@using BlazorIdle.Game.Config
@using BlazorIdle.Shared.DTOs
@inject ICharacterService CharacterService
@inject IGameConfigService GameConfig
@inject IJSRuntime JSRuntime

<div class="character-selector-card">
    <h4>选择角色 (Select Character)</h4>

    @if (isLoading)
    {
        <div class="text-muted">加载中...</div>
    }
    else if (characterListResponse == null || characterListResponse.Characters.Count == 0)
    {
        <div class="alert alert-info">
            暂无角色，请先创建一个角色。
        </div>
    }
    else
    {
        <div class="character-list">
            @foreach (var character in characterListResponse.Characters)
            {
                var profession = GetProfession(character.ProfessionId);
                var isSelected = selectedCharacterId == character.Id;

                <div class="character-card @(isSelected ? "selected" : "")" @onclick="() => SelectCharacter(character.Id)">
                    <div class="character-header">
                        <div>
                            <div class="character-name">@character.Name</div>
                            <div class="character-profession">@(profession?.Name ?? character.ProfessionId)</div>
                        </div>
                        @if (isSelected)
                        {
                            <span class="badge bg-success">已选中</span>
                        }
                    </div>

                    <div class="character-stats">
                        <div class="stat-row">
                            <span>生命值: @character.MaxHp</span>
                            <span>攻击: @character.DamagePerAttack</span>
                        </div>
                        <div class="stat-row text-muted small">
                            <span>创建时间: @character.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>

                    <div class="character-actions">
                        <button class="btn btn-sm btn-danger" 
                                @onclick:stopPropagation="true"
                                @onclick="() => DeleteCharacter(character.Id)">
                            删除
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// 角色选择变更事件
    /// Character selection change event
    /// </summary>
    [Parameter]
    public EventCallback<CharacterData?> OnCharacterSelected { get; set; }

    /// <summary>
    /// 角色删除事件
    /// Character deletion event
    /// </summary>
    [Parameter]
    public EventCallback OnCharacterDeleted { get; set; }

    // 角色列表响应 Character list response
    private CharacterListResponse? characterListResponse;
    
    // 当前选中的角色ID Currently selected character ID
    private string? selectedCharacterId;
    
    // 加载状态 Loading state
    private bool isLoading = true;
    
    // 职业列表 Profession list
    private List<ProfessionDef> professions = new();

    /// <summary>
    /// 组件初始化时加载数据
    /// Load data on component initialization
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// 刷新角色列表（供父组件调用）
    /// Refresh character list (called by parent component)
    /// </summary>
    public async Task RefreshAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// 加载角色和职业数据
    /// Load character and profession data
    /// </summary>
    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // 加载职业配置 Load profession configuration
            await GameConfig.EnsureLoadedAsync();
            professions = GameConfig.Professions.ToList();

            // 加载角色列表 Load character list
            characterListResponse = await CharacterService.GetCharactersAsync();
            
            // 获取当前选中的角色 Get currently selected character
            var selected = await CharacterService.GetSelectedCharacterAsync();
            selectedCharacterId = selected?.Id;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// 选择或取消选择角色
    /// Select or deselect a character
    /// </summary>
    private async Task SelectCharacter(string characterId)
    {
        if (selectedCharacterId == characterId)
        {
            // 取消选中 Deselect
            selectedCharacterId = null;
            await CharacterService.SetSelectedCharacterAsync(null);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(null);
            }
        }
        else
        {
            // 选中新角色 Select new character
            selectedCharacterId = characterId;
            await CharacterService.SetSelectedCharacterAsync(characterId);
            
            var character = characterListResponse?.Characters.FirstOrDefault(c => c.Id == characterId);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(character);
            }
        }
    }

    /// <summary>
    /// 删除角色
    /// Delete a character
    /// </summary>
    private async Task DeleteCharacter(string characterId)
    {
        var character = characterListResponse?.Characters.FirstOrDefault(c => c.Id == characterId);
        if (character == null) return;

        // 请求用户确认删除 Ask for user confirmation before deleting
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除角色 '{character.Name}' 吗？此操作无法撤销。");
        if (!confirmed) return;

        try
        {
            var response = await CharacterService.DeleteCharacterAsync(characterId);
            
            if (response != null && response.Success)
            {
                // 重新加载数据 Reload data
                await LoadData();
                
                // 通知父组件 Notify parent component
                if (OnCharacterDeleted.HasDelegate)
                {
                    await OnCharacterDeleted.InvokeAsync();
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "删除角色失败");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"删除角色失败: {ex.Message}");
        }
    }

    /// <summary>
    /// 根据职业ID获取职业信息
    /// Get profession info by profession ID
    /// </summary>
    private ProfessionDef? GetProfession(string professionId)
    {
        return professions.FirstOrDefault(p => p.Id == professionId);
    }
}

<style>
    .character-selector-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .character-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
    }

    .character-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
    }

    .character-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .character-card.selected {
        border-color: #198754;
        background: #f0fdf4;
    }

    .character-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .character-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #212529;
    }

    .character-profession {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .character-stats {
        margin: 10px 0;
        padding: 10px 0;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9rem;
    }

    .character-actions {
        margin-top: 10px;
        display: flex;
        justify-content: flex-end;
    }

    .character-actions button {
        opacity: 0.7;
    }

    .character-actions button:hover {
        opacity: 1;
    }
</style>
