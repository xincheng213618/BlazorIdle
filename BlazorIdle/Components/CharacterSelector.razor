@using BlazorIdle.Shared.Models
@using BlazorIdle.Services
@using BlazorIdle.Game.Config
@inject ICharacterService CharacterService
@inject IGameConfigService GameConfig

<div class="character-selector-card">
    <h4>选择角色 (Select Character)</h4>

    @if (isLoading)
    {
        <div class="text-muted">加载中...</div>
    }
    else if (characters.Count == 0)
    {
        <div class="alert alert-info">
            暂无角色，请先创建一个角色。
        </div>
    }
    else
    {
        <div class="character-list">
            @foreach (var character in characters)
            {
                var profession = GetProfession(character.ProfessionId);
                var isSelected = selectedCharacterId == character.Id;

                <div class="character-card @(isSelected ? "selected" : "")" @onclick="() => SelectCharacter(character.Id)">
                    <div class="character-header">
                        <div>
                            <div class="character-name">@character.Name</div>
                            <div class="character-profession">@(profession?.Name ?? character.ProfessionId)</div>
                        </div>
                        @if (isSelected)
                        {
                            <span class="badge bg-success">已选中</span>
                        }
                    </div>

                    <div class="character-stats">
                        <div class="stat-row">
                            <span>生命值: @character.MaxHp</span>
                            <span>攻击: @character.DamagePerAttack</span>
                        </div>
                        <div class="stat-row text-muted small">
                            <span>创建时间: @character.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>

                    <div class="character-actions">
                        <button class="btn btn-sm btn-danger" 
                                @onclick:stopPropagation="true"
                                @onclick="() => DeleteCharacter(character.Id)">
                            删除
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<CharacterData?> OnCharacterSelected { get; set; }

    [Parameter]
    public EventCallback OnCharacterDeleted { get; set; }

    private List<CharacterData> characters = new();
    private string? selectedCharacterId;
    private bool isLoading = true;
    private List<ProfessionDef> professions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    public async Task RefreshAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await GameConfig.EnsureLoadedAsync();
            professions = GameConfig.Professions.ToList();

            characters = await CharacterService.GetCharactersAsync();
            var selected = await CharacterService.GetSelectedCharacterAsync();
            selectedCharacterId = selected?.Id;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectCharacter(string characterId)
    {
        if (selectedCharacterId == characterId)
        {
            // 取消选中
            selectedCharacterId = null;
            await CharacterService.SetSelectedCharacterAsync(null);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(null);
            }
        }
        else
        {
            // 选中新角色
            selectedCharacterId = characterId;
            await CharacterService.SetSelectedCharacterAsync(characterId);
            var character = characters.FirstOrDefault(c => c.Id == characterId);
            if (OnCharacterSelected.HasDelegate)
            {
                await OnCharacterSelected.InvokeAsync(character);
            }
        }
    }

    private async Task DeleteCharacter(string characterId)
    {
        // Simple confirmation - in production this should be a nicer modal
        await CharacterService.DeleteCharacterAsync(characterId);
        await LoadData();
        
        if (OnCharacterDeleted.HasDelegate)
        {
            await OnCharacterDeleted.InvokeAsync();
        }
    }

    private ProfessionDef? GetProfession(string professionId)
    {
        return professions.FirstOrDefault(p => p.Id == professionId);
    }
}

<style>
    .character-selector-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .character-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
    }

    .character-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
    }

    .character-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .character-card.selected {
        border-color: #198754;
        background: #f0fdf4;
    }

    .character-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .character-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #212529;
    }

    .character-profession {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .character-stats {
        margin: 10px 0;
        padding: 10px 0;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9rem;
    }

    .character-actions {
        margin-top: 10px;
        display: flex;
        justify-content: flex-end;
    }

    .character-actions button {
        opacity: 0.7;
    }

    .character-actions button:hover {
        opacity: 1;
    }
</style>
