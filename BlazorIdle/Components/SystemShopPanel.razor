@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.DTOs
@using BlazorIdle.Services
@inject IUserService UserService

<div class="system-shop-panel">
    <div class="shop-header"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0">
            <span class="icon">🏛️</span>
            系统商店 (System Shop)
        </h5>

        <div class="d-flex align-items-center gap-3">
            @if (Character != null)
            {
                <div class="gold-balance-display">
                    <span class="gold-icon">🪙</span>
                    <span class="gold-amount">@GetGoldBalance().ToString("N0")</span>
                </div>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="shop-body" style="@(isCollapsed ? "display:none" : null)">
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mb-3">@successMessage</div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-3">@errorMessage</div>
        }

        @if (Character == null)
        {
            <div class="empty-state">
                <p class="text-muted mb-0">请先选择角色...</p>
            </div>
        }
        else if (isLoading)
        {
            <div class="text-center p-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">加载中...</span>
                </div>
            </div>
        }
        else
        {
            <div class="shop-items-grid">
                @* 角色槽位商品 *@
                <div class="shop-item @(shopInfo == null || !shopInfo.CanPurchase ? "sold-out" : "") @(!CanAffordSlot() ? "cannot-afford" : "")">
                    <div class="item-icon">👤</div>
                    <div class="item-info">
                        <div class="item-name">角色槽位 +1</div>
                        <div class="item-desc">增加一个可创建角色的槽位</div>
                        <div class="item-meta">
                            <span class="price">
                                <span class="gold-icon">🪙</span>
                                @(shopInfo?.Price.ToString("N0") ?? "5,000")
                            </span>
                            @if (shopInfo != null)
                            {
                                <span class="limit">
                                    @if (shopInfo.CanPurchase)
                                    {
                                        <span class="remaining">剩余 @(shopInfo.MaxPurchases - shopInfo.PurchasedCount) 次</span>
                                    }
                                    else
                                    {
                                        <span class="exhausted">已售罄</span>
                                    }
                                </span>
                            }
                        </div>
                        <div class="item-current-slots">
                            当前槽位: @(shopInfo?.CurrentSlots ?? 1)
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm purchase-btn"
                            disabled="@(isPurchasing || shopInfo == null || !shopInfo.CanPurchase || !CanAffordSlot())"
                            @onclick="PurchaseCharacterSlot">
                        @if (isPurchasing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else if (shopInfo != null && !shopInfo.CanPurchase)
                        {
                            <span>已购买</span>
                        }
                        else if (!CanAffordSlot())
                        {
                            <span>金币不足</span>
                        }
                        else
                        {
                            <span>购买</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .system-shop-panel {
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%);
        border-radius: 12px;
        margin-bottom: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .system-shop-panel .shop-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #4a1d6e 0%, #6b2d8e 100%);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .system-shop-panel .shop-header:hover {
        background: linear-gradient(135deg, #5a2d7e 0%, #7b3d9e 100%);
    }

    .system-shop-panel .shop-header h5 {
        color: #fff;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .system-shop-panel .shop-header .icon {
        font-size: 1.3rem;
    }

    .system-shop-panel .gold-balance-display {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(255, 215, 0, 0.15);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
    }

    .system-shop-panel .gold-icon {
        font-size: 1rem;
    }

    .system-shop-panel .gold-amount {
        color: #ffd700;
        font-weight: 600;
    }

    .system-shop-panel .shop-body {
        padding: 1rem;
    }

    .system-shop-panel .shop-items-grid {
        display: grid;
        gap: 0.75rem;
    }

    .system-shop-panel .shop-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.2s ease;
    }

    .system-shop-panel .shop-item:hover:not(.sold-out):not(.cannot-afford) {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(138, 43, 226, 0.5);
    }

    .system-shop-panel .shop-item.sold-out {
        opacity: 0.6;
    }

    .system-shop-panel .shop-item.cannot-afford {
        opacity: 0.7;
    }

    .system-shop-panel .item-icon {
        font-size: 2.5rem;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #6b2d8e 0%, #8b4dae 100%);
        border-radius: 8px;
    }

    .system-shop-panel .item-info {
        flex: 1;
    }

    .system-shop-panel .item-name {
        font-weight: 600;
        color: #fff;
        font-size: 1rem;
    }

    .system-shop-panel .item-desc {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .system-shop-panel .item-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .system-shop-panel .price {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: #ffd700;
        font-weight: 500;
    }

    .system-shop-panel .limit {
        font-size: 0.8rem;
    }

    .system-shop-panel .remaining {
        color: #4ade80;
    }

    .system-shop-panel .exhausted {
        color: #f87171;
    }

    .system-shop-panel .item-current-slots {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        margin-top: 0.25rem;
    }

    .system-shop-panel .purchase-btn {
        min-width: 80px;
    }

    .system-shop-panel .empty-state {
        text-align: center;
        padding: 2rem;
    }
</style>

@code {
    [Parameter]
    public CharacterData? Character { get; set; }

    [Parameter]
    public EventCallback OnSlotPurchased { get; set; }

    [Parameter]
    public bool StartCollapsed { get; set; }

    private bool isCollapsed;
    private bool isLoading = true;
    private bool isPurchasing = false;
    private string? errorMessage = null;
    private string? successMessage = null;

    private CharacterSlotShopInfo? shopInfo;

    protected override async Task OnInitializedAsync()
    {
        isCollapsed = StartCollapsed;
        await LoadShopInfoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Character != null && shopInfo == null)
        {
            await LoadShopInfoAsync();
        }
    }

    private async Task LoadShopInfoAsync()
    {
        isLoading = true;
        try
        {
            shopInfo = await UserService.GetCharacterSlotShopInfoAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;

    private int GetGoldBalance()
    {
        if (Character == null) return 0;
        return Character.Inventory?.GetItemQuantity("gold_coin") ?? 0;
    }

    private bool CanAffordSlot()
    {
        if (shopInfo == null) return false;
        return GetGoldBalance() >= shopInfo.Price;
    }

    private async Task PurchaseCharacterSlot()
    {
        if (Character == null || isPurchasing || shopInfo == null || !shopInfo.CanPurchase)
            return;

        if (!CanAffordSlot())
        {
            errorMessage = $"金币不足，需要 {shopInfo.Price:N0} 金币";
            return;
        }

        errorMessage = null;
        successMessage = null;
        isPurchasing = true;

        try
        {
            var result = await UserService.PurchaseCharacterSlotAsync(Character.Id);

            if (result?.Success == true)
            {
                successMessage = result.Message;
                
                // 扣除本地金币显示
                Character.Inventory?.RemoveItem("gold_coin", shopInfo.Price);
                
                // 重新加载商店信息
                await LoadShopInfoAsync();

                // 触发回调
                if (OnSlotPurchased.HasDelegate)
                {
                    await OnSlotPurchased.InvokeAsync();
                }

                // 3秒后清除成功消息
                _ = Task.Delay(3000).ContinueWith(async _ =>
                {
                    successMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
            else
            {
                errorMessage = result?.Message ?? "购买失败";

                // 3秒后清除错误消息
                _ = Task.Delay(3000).ContinueWith(async _ =>
                {
                    errorMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
        }
        finally
        {
            isPurchasing = false;
            StateHasChanged();
        }
    }
}
