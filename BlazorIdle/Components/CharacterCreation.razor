@using BlazorIdle.Shared.Models
@using BlazorIdle.Game.Config
@using BlazorIdle.Services
@using BlazorIdle.Shared.DTOs
@inject ICharacterService CharacterService
@inject IGameConfigService GameConfig

<div class="character-creation-card">
    <div class="cc-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">🧙</span>
            创建角色 (Create Character)
        </h5>
        <button class="btn btn-sm btn-outline-light"
                @onclick:stopPropagation="true"
                @onclick="ToggleCollapse">
            @(isCollapsed ? "展开" : "收起")
        </button>
    </div>

    <div class="cc-body" style="@(isCollapsed ? "display:none" : null)">
        @if (!configReady)
        {
            <div class="text-muted">加载配置中...</div>
        }
        else
        {
            <!-- 角色槽位信息显示 Character slot information display -->
            @if (characterSlotInfo != null)
            {
                <div class="character-slots-info mb-3">
                    <div class="slots-progress">
                        <div class="slots-label">
                            <span>角色槽位 (Character Slots):</span>
                            <span class="slots-count @(characterSlotInfo.CanCreateMore ? "text-success" : "text-danger")">
                                @characterSlotInfo.UsedSlots / @characterSlotInfo.MaxSlots
                            </span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar @(characterSlotInfo.CanCreateMore ? "bg-success" : "bg-danger")"
                                 role="progressbar"
                                 style="width: @((characterSlotInfo.UsedSlots * 100.0 / characterSlotInfo.MaxSlots))%"
                                 aria-valuenow="@characterSlotInfo.UsedSlots"
                                 aria-valuemin="0"
                                 aria-valuemax="@characterSlotInfo.MaxSlots">
                            </div>
                        </div>
                    </div>
                    @if (!characterSlotInfo.CanCreateMore)
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            已达到最大角色数量限制！您可以删除现有角色以腾出槽位。
                        </div>
                    }
                </div>
            }

            @if (showSuccessMessage)
            {
                <div class="alert alert-success">
                    角色 <strong>@createdCharacterName</strong> 创建成功！
                </div>
                <button class="btn btn-primary" @onclick="ResetForm">继续创建新角色</button>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">角色名称 (Character Name)</label>
                    <input type="text"
                           class="form-control"
                           @bind="characterName"
                           @bind:event="oninput"
                           placeholder="请输入角色名称"
                           maxlength="20"
                           disabled="@(!characterSlotInfo?.CanCreateMore ?? false)" />
                    @if (!string.IsNullOrWhiteSpace(nameError))
                    {
                        <div class="text-danger small mt-1">@nameError</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">选择职业 (Select Profession)</label>
                    <select class="form-select"
                            @bind="selectedProfessionId"
                            disabled="@(!characterSlotInfo?.CanCreateMore ?? false)">
                        <option value="">-- 请选择职业 --</option>
                        @foreach (var profession in professions)
                        {
                            <option value="@profession.Id">@profession.Name - @profession.Desc</option>
                        }
                    </select>
                    @if (!string.IsNullOrWhiteSpace(professionError))
                    {
                        <div class="text-danger small mt-1">@professionError</div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(selectedProfessionId))
                {
                    var profession = professions.FirstOrDefault(p => p.Id == selectedProfessionId);
                    if (profession != null)
                    {
                        <div class="profession-preview mb-3">
                            <h6>职业属性预览 (Profession Stats Preview)</h6>
                            <div class="stats-grid">
                                <div class="stat-item">
                                    <span class="stat-label">最大生命值:</span>
                                    <span class="stat-value">@profession.MaxHp</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">攻击速度:</span>
                                    <span class="stat-value">@profession.AttackRateAPS 次/秒</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">攻击伤害:</span>
                                    <span class="stat-value">@profession.DamagePerAttack</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">急速:</span>
                                    <span class="stat-value">@profession.HastePercent%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">特殊技能间隔:</span>
                                    <span class="stat-value">@profession.SpecialIntervalSec 秒</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">特殊技能伤害:</span>
                                    <span class="stat-value">@profession.SpecialDamage</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">暴击率:</span>
                                    <span class="stat-value">@profession.CritChancePercent%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">暴击倍率:</span>
                                    <span class="stat-value">@profession.CritMultiplier x</span>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="d-flex gap-2">
                    <button class="btn btn-success"
                            @onclick="CreateCharacter"
                            disabled="@(!configReady || isCreating || !(characterSlotInfo?.CanCreateMore ?? false))">
                        @if (isCreating)
                        {
                            <span>创建中...</span>
                        }
                        else
                        {
                            <span>创建角色</span>
                        }
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetForm">重置</button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnCharacterCreated { get; set; }

    // 新增：默认是否折叠（父可控制）
    [Parameter]
    public bool StartCollapsed { get; set; }

    private bool isCollapsed;

    // 职业列表
    private List<ProfessionDef> professions = new();
    private CharacterListResponse? characterSlotInfo;

    // 表单字段
    private string characterName = string.Empty;
    private string selectedProfessionId = string.Empty;

    // 错误信息
    private string nameError = string.Empty;
    private string professionError = string.Empty;

    // 状态标志
    private bool configReady = false;
    private bool isCreating = false;
    private bool showSuccessMessage = false;
    private string createdCharacterName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        professions = GameConfig.Professions.ToList();
        configReady = professions.Count > 0;

        // 折叠默认值
        isCollapsed = StartCollapsed;

        await LoadCharacterSlotInfo();
    }

    private async Task LoadCharacterSlotInfo()
    {
        try
        {
            characterSlotInfo = await CharacterService.GetCharactersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading character slot info: {ex.Message}");
        }
    }

    private bool ValidateInput()
    {
        nameError = string.Empty;
        professionError = string.Empty;
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(characterName))
        {
            nameError = "角色名称不能为空";
            isValid = false;
        }
        else if (characterName.Length < 2)
        {
            nameError = "角色名称至少需要2个字符";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(selectedProfessionId))
        {
            professionError = "请选择一个职业";
            isValid = false;
        }

        return isValid;
    }

    private async Task CreateCharacter()
    {
        if (!ValidateInput())
        {
            return;
        }

        if (characterSlotInfo != null && !characterSlotInfo.CanCreateMore)
        {
            nameError = "已达到最大角色数量限制";
            return;
        }

        isCreating = true;
        try
        {
            var profession = professions.FirstOrDefault(p => p.Id == selectedProfessionId);
            if (profession == null)
            {
                professionError = "无效的职业选择";
                return;
            }

            var response = await CharacterService.CreateCharacterAsync(characterName.Trim(), profession);

            if (response != null && response.Success && response.Character != null)
            {
                createdCharacterName = response.Character.Name;
                showSuccessMessage = true;

                await LoadCharacterSlotInfo();

                if (OnCharacterCreated.HasDelegate)
                {
                    await OnCharacterCreated.InvokeAsync();
                }
            }
            else
            {
                nameError = response?.Message ?? "创建失败";
            }
        }
        catch (Exception ex)
        {
            nameError = $"创建失败: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private void ResetForm()
    {
        characterName = string.Empty;
        selectedProfessionId = string.Empty;
        nameError = string.Empty;
        professionError = string.Empty;
        showSuccessMessage = false;
        createdCharacterName = string.Empty;
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
}

<style>
    .character-creation-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .cc-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .cc-header .btn {
            margin-top: 0; /* 覆盖全局 .btn 20px 上边距，保证对齐 */
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .cc-body {
        padding: 20px;
    }

    .character-slots-info {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
    }

    .slots-progress {
        margin-bottom: 10px;
    }

    .slots-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .slots-count {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .profession-preview {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
    }

        .profession-preview h6 {
            margin-bottom: 10px;
            color: #495057;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .stat-value {
        font-weight: 600;
        color: #212529;
    }
</style>