@using BlazorIdle.Services
@using BlazorIdle.Shared.Models
@inject ICharacterService CharacterService
@inject ILogger<SaveButton> Logger

<div class="save-button-container">
    <button 
        class="btn btn-save @(isSaving ? "saving" : "") @(GetStatusClass())" 
        @onclick="OnSaveClicked"
        disabled="@(isSaving || SelectedCharacter == null)">
        
        @if (isSaving)
        {
            <span class="spinner"></span>
            <span>保存中...</span>
        }
        else if (lastSaveSuccess.HasValue)
        {
            if (lastSaveSuccess.Value)
            {
                <span class="icon-success">✓</span>
                <span>已保存</span>
            }
            else
            {
                <span class="icon-error">✗</span>
                <span>保存失败</span>
            }
        }
        else
        {
            <span class="icon-save">💾</span>
            <span>手动保存</span>
        }
    </button>

    @if (lastSaveTime.HasValue)
    {
        <div class="save-time">
            上次保存: @lastSaveTime.Value.ToString("HH:mm:ss")
        </div>
    }
</div>

@code {
    [Parameter]
    public CharacterData? SelectedCharacter { get; set; }

    private bool isSaving = false;
    private bool? lastSaveSuccess = null;
    private DateTime? lastSaveTime = null;
    private System.Threading.Timer? clearStatusTimer;

    private async Task OnSaveClicked()
    {
        if (SelectedCharacter == null)
        {
            Logger.LogWarning("No character selected for manual save");
            return;
        }

        if (isSaving)
        {
            Logger.LogDebug("Save already in progress, ignoring click");
            return;
        }

        try
        {
            isSaving = true;
            lastSaveSuccess = null;
            StateHasChanged();

            Logger.LogInformation(
                "Manual save initiated for character {CharacterId}",
                SelectedCharacter.Id);

            // 执行保存
            var success = await CharacterService.SaveImmediatelyAsync(
                SelectedCharacter, 
                "手动保存");

            lastSaveSuccess = success;
            lastSaveTime = DateTime.Now;

            // 3秒后清除状态提示
            clearStatusTimer?.Dispose();
            clearStatusTimer = new System.Threading.Timer(_ =>
            {
                lastSaveSuccess = null;
                InvokeAsync(() => StateHasChanged());
            }, null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during manual save");
            lastSaveSuccess = false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private string GetStatusClass()
    {
        if (lastSaveSuccess.HasValue)
        {
            return lastSaveSuccess.Value ? "success" : "error";
        }
        return "";
    }

    public void Dispose()
    {
        clearStatusTimer?.Dispose();
    }
}

<style>
    .save-button-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin: 10px 0;
    }

    .btn-save {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border: 2px solid #4CAF50;
        background: #4CAF50;
        color: white;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.3s;
        min-width: 150px;
        justify-content: center;
    }

    .btn-save:hover:not(:disabled) {
        background: #45a049;
        border-color: #45a049;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(76, 175, 80, 0.3);
    }

    .btn-save:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .btn-save.saving {
        border-color: #2196F3;
        background: #2196F3;
    }

    .btn-save.success {
        border-color: #4CAF50;
        background: #4CAF50;
    }

    .btn-save.error {
        border-color: #f44336;
        background: #f44336;
    }

    .spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .save-time {
        font-size: 12px;
        color: #666;
    }

    .icon-success {
        color: white;
        font-weight: bold;
        font-size: 16px;
    }

    .icon-error {
        color: white;
        font-weight: bold;
        font-size: 16px;
    }

    .icon-save {
        font-size: 16px;
    }
</style>
