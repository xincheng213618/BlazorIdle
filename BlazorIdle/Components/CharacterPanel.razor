@namespace BlazorIdle.Components

<div class="card p-3 character-panel">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="me-2">
            <div class="fw-semibold">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="text-muted small">@Subtitle</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Tag))
        {
            <span class="badge rounded-pill text-bg-primary">@Tag</span>
        }
    </div>

    <!-- HP 条 -->
    <div class="mb-2">
        <div class="d-flex justify-content-between">
            <small class="text-muted">HP: @Hp / @MaxHp</small>
            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <small class="text-muted">@StatusText</small>
            }
        </div>
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@HpPercent">
            <div class="progress-bar bg-success" style="width:@($"{HpPercent}%")"></div>
        </div>
    </div>

    <!-- Phase 2.5/2.7: 资源条 (动态资源) / Resource bars (dynamic resources) -->
    @if (Resources != null && ResourceConfig != null)
    {
        foreach (var (resourceId, currentValue) in Resources)
        {
            var maxValue = ResourceConfig.Max;
            var resourceName = ResourceConfig.Name;
            var resourcePercent = (int)Math.Round(100.0 * currentValue / Math.Max(1, maxValue));
            <div class="mb-2">
                <div class="d-flex justify-content-between">
                    <small class="text-muted">@resourceName: @currentValue / @maxValue</small>
                </div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@resourcePercent">
                    <div class="progress-bar bg-danger" style="width:@($"{resourcePercent}%")"></div>
                </div>
            </div>
        }
    }

    <!-- Phase 9: Buff/Debuff 图标 / Buff/Debuff icons -->
    @if (Buffs != null && Buffs.Count > 0)
    {
        <div class="mb-2">
            <div class="buff-container">
                @foreach (var buff in Buffs)
                {
                    <BuffIcon Buff="@buff" />
                }
            </div>
        </div>
    }

    <!-- Phase 10.3: 战斗技能图标 / Battle skill icons -->
    @if (EquippedSkills != null && EquippedSkills.Count > 0)
    {
        <div class="mb-2">
            <div class="skill-container">
                @foreach (var skillData in EquippedSkills)
                {
                    <SkillIcon Skill="@skillData.Skill"
                               SlotId="@skillData.SlotId"
                               RemainingCooldown="@skillData.RemainingCooldown"
                               IsResourceInsufficient="@skillData.IsResourceInsufficient"
                               IsConditionNotMet="@skillData.IsConditionNotMet"
                               JustTriggered="@skillData.JustTriggered" />
                }
            </div>
        </div>
    }

    <!-- Phase 8: Attack 进度 / 施法进度 -->
    <div class="mb-2">
        @if (IsCasting)
        {
            <!-- 施法条 / Casting bar -->
            <div class="d-flex justify-content-between small text-muted">
                <span>施法中 Casting</span>
                <span>@($"{CastingProgress01 * 100:0}% · 剩余 {CastingRemainMs / 1000.0:0.00}s")</span>
            </div>
            <div class="progress">
                <div class="progress-bar bg-warning" style="width:@($"{CastingProgress01 * 100:0}%")">
                    @if (!string.IsNullOrEmpty(CastingSkillName))
                    {
                        <small class="casting-skill-name">@CastingSkillName</small>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- 普通攻击进度 / Normal attack progress -->
            <div class="d-flex justify-content-between small text-muted">
                <span>Attack</span>
                <span>@($"{AttackProgress01 * 100:0}% · 下次 {AttackRemainMs / 1000.0:0.00}s")</span>
            </div>
            <div class="progress">
                <div class="progress-bar bg-primary @(attackWrap ? "no-transition" : "")"
                     style="width:@($"{AttackProgress01 * 100:0}%")"></div>
            </div>
        }
    </div>

    <!-- Special 进度 -->
    <div>
        <div class="d-flex justify-content-between small text-muted">
            <span>Special</span>
            <span>@($"{SpecialProgress01 * 100:0}% · 下次 {SpecialRemainMs / 1000.0:0.00}s")</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-info @(specialWrap ? "no-transition" : "")"
                 style="width:@($"{SpecialProgress01 * 100:0}%")"></div>
        </div>
    </div>
</div>

@code {
    // 标题/副标题/标签（可选）
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Tag { get; set; }
    [Parameter] public string? StatusText { get; set; }

    // HP
    [Parameter] public int Hp { get; set; }
    [Parameter] public int MaxHp { get; set; }

    private int HpPercent => MaxHp <= 0 ? 0 : (int)Math.Round(100.0 * Hp / Math.Max(1, MaxHp));

    // Phase 2.5/2.7: 资源信息（可选）/ Resource information (optional)
    [Parameter] public Dictionary<string, int>? Resources { get; set; }
    
    // Phase 2.7: 资源配置（用于显示资源名称和上限）/ Resource configuration (for displaying resource name and max)
    [Parameter] public BlazorIdle.Shared.Models.ProfessionResourceConfig? ResourceConfig { get; set; }

    // Phase 9: Buff/Debuff 列表（用于显示状态效果）/ Buff/Debuff list (for displaying status effects)
    [Parameter] public List<BlazorIdle.Game.Buffs.BuffInstance>? Buffs { get; set; }

    // Phase 10.3: 装备的技能列表（用于显示技能图标）/ Equipped skills list (for displaying skill icons)
    [Parameter] public List<EquippedSkillData>? EquippedSkills { get; set; }

    // Phase 8: 施法状态 / Casting state
    [Parameter] public bool IsCasting { get; set; }
    [Parameter] public double CastingProgress01 { get; set; }
    [Parameter] public double CastingRemainMs { get; set; }
    [Parameter] public string? CastingSkillName { get; set; }

    // 进度（0..1）与剩余毫秒
    [Parameter] public double AttackProgress01 { get; set; }
    [Parameter] public double AttackRemainMs { get; set; }
    [Parameter] public double SpecialProgress01 { get; set; }
    [Parameter] public double SpecialRemainMs { get; set; }

    // 用于检测进度“回环”（从大到小跳变），回环时禁用过渡，瞬间归零
    private double _lastAttackProgress;
    private double _lastSpecialProgress;
    private bool attackWrap;
    private bool specialWrap;

    protected override void OnParametersSet()
    {
        // 容忍极小抖动
        attackWrap = AttackProgress01 + 0.0001 < _lastAttackProgress;
        specialWrap = SpecialProgress01 + 0.0001 < _lastSpecialProgress;

        _lastAttackProgress = AttackProgress01;
        _lastSpecialProgress = SpecialProgress01;
    }
    
    /// <summary>
    /// Phase 10.3: 装备技能数据结构（用于传递技能显示信息）
    /// Phase 10.3: Equipped skill data structure (for passing skill display information)
    /// </summary>
    public class EquippedSkillData
    {
        public BlazorIdle.Game.Skills.SkillDef? Skill { get; set; }
        public string SlotId { get; set; } = "";
        public double RemainingCooldown { get; set; }
        public bool IsResourceInsufficient { get; set; }
        public bool IsConditionNotMet { get; set; }
        public bool JustTriggered { get; set; }
    }
}

<style>
    .character-panel .progress {
        height: 10px;
    }

    /* 覆盖 Bootstrap 默认的 .6s 过渡，常规前进更灵敏 */
    .character-panel .progress-bar {
        transition: width 120ms linear;
    }

    /* 回环时禁用过渡，确保视觉上瞬间归零到最左侧 */
    .character-panel .no-transition {
        transition: none !important;
    }

    /* Phase 9: Buff 容器样式 */
    .character-panel .buff-container {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
        min-height: 36px;
        align-items: flex-start;
    }

    /* Phase 10.3: Skill 容器样式 / Skill container styles */
    .character-panel .skill-container {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        min-height: 44px;
        align-items: flex-start;
        padding: 4px;
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 6px;
    }

    /* Phase 8: 施法条样式 / Casting bar styles */
    .character-panel .progress-bar.bg-warning {
        background-color: #ffc107 !important;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .character-panel .casting-skill-name {
        color: #000;
        font-weight: 600;
        font-size: 10px;
        position: absolute;
        white-space: nowrap;
        text-shadow: 0 0 2px rgba(255, 255, 255, 0.8);
    }
</style>