@using BlazorIdle.Shared.Models
@using BlazorIdle.Game.Config
@using BlazorIdle.Services
@inject ICharacterService CharacterService
@inject IGameConfigService GameConfig

<div class="profession-selector-card">
    <div class="ps-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">⚔️</span>
            职业选择 (Profession Selector)
        </h5>
        <button class="btn btn-sm btn-outline-light"
                @onclick:stopPropagation="true"
                @onclick="ToggleCollapse">
            @(isCollapsed ? "展开" : "收起")
        </button>
    </div>

    <div class="ps-body" style="@(isCollapsed ? "display:none" : null)">
        @if (character == null)
        {
            <div class="text-muted">请先选择一个角色...</div>
        }
        else if (!configReady)
        {
            <div class="text-muted">加载配置中...</div>
        }
        else
        {
            <div class="section">
                <h6 class="section-title">战斗职业 (Combat)</h6>
                <div class="profession-grid">
                    @foreach (var prof in combatProfessions)
                    {
                        var progress = character.Professions.GetValueOrDefault(prof.Id);
                        var isActive = character.ActiveCombatProfessionId == prof.Id;

                        <div class="profession-card @(isActive ? "active" : "")"
                             @onclick="() => SelectProfession(prof.Id)">
                            <div class="profession-header">
                                <strong>@prof.Name</strong>
                                @if (isActive)
                                {
                                    <span class="badge bg-success ms-2">激活</span>
                                }
                            </div>

                            @if (progress != null)
                            {
                                <div class="profession-level">
                                    等级: @progress.Level <small class="text-muted">(Max: @GameConfig.MaxProfessionLevel)</small>
                                </div>
                                <div class="profession-exp">
                                    <div class="exp-bar">
                                        <div class="exp-fill" style="width:@(GetExpPercentage(progress))%"></div>
                                    </div>
                                    <div class="exp-text">
                                        @progress.Experience / @progress.ExperienceToNext
                                    </div>
                                </div>
                            }

                            <div class="profession-stats-preview">
                                <small class="text-muted">
                                    HP: @prof.MaxHp | ATK: @prof.DamagePerAttack | APS: @prof.AttackRateAPS
                                </small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">非战斗职业 (Non-Combat)</h6>
                <div class="profession-grid">
                    @foreach (var prof in nonCombatProfessions)
                    {
                        var progress = character.Professions.GetValueOrDefault(prof.Id);

                        <div class="profession-card noncombat">
                            <div class="profession-header">
                                <strong>@prof.Name</strong>
                            </div>

                            @if (progress != null)
                            {
                                <div class="profession-level">
                                    等级: @progress.Level <small class="text-muted">(Max: @GameConfig.MaxProfessionLevel)</small>
                                </div>
                                <div class="profession-exp">
                                    <div class="exp-bar">
                                        <div class="exp-fill nc" style="width:@(GetExpPercentage(progress))%"></div>
                                    </div>
                                    <div class="exp-text">
                                        @progress.Experience / @progress.ExperienceToNext
                                    </div>
                                </div>
                            }

                            <div class="profession-note">
                                <small class="text-muted">未来将解锁采集 / 制作内容</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (showSwitchConfirm)
            {
                <div class="switch-confirm mt-3 alert alert-warning">
                    <p>确认切换到 <strong>@GetProfessionName(selectedProfessionId)</strong> 吗？</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-primary" @onclick="ConfirmSwitch" disabled="@isSwitching">
                            @(isSwitching ? "切换中..." : "确认")
                        </button>
                        <button class="btn btn-sm btn-secondary" @onclick="CancelSwitch">取消</button>
                    </div>
                    @if (!string.IsNullOrEmpty(switchError))
                    {
                        <div class="text-danger mt-2">@switchError</div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public CharacterData? Character { get; set; }
    [Parameter] public EventCallback<CharacterData> OnProfessionSwitched { get; set; }
    [Parameter] public bool StartCollapsed { get; set; } = true;

    private bool isCollapsed;
    private CharacterData? character;
    private List<ProfessionDef> combatProfessions = new();
    private List<ProfessionDef> nonCombatProfessions = new();
    private bool configReady;
    private bool showSwitchConfirm;
    private string selectedProfessionId = string.Empty;
    private bool isSwitching;
    private string switchError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isCollapsed = StartCollapsed;
        await GameConfig.EnsureLoadedAsync();
        combatProfessions = GameConfig.Professions.Where(p => p.Type == ProfessionType.Combat).ToList();
        nonCombatProfessions = GameConfig.Professions.Where(p => p.Type == ProfessionType.NonCombat).ToList();
        configReady = GameConfig.Professions.Any();
    }

    protected override void OnParametersSet()
    {
        character = Character;
    }

    private double GetExpPercentage(ProfessionProgress progress)
        => progress.ExperienceToNext <= 0 ? 100 : Math.Min(100, progress.Experience * 100.0 / progress.ExperienceToNext);

    private string GetProfessionName(string profId)
        => combatProfessions.FirstOrDefault(p => p.Id == profId)?.Name ?? profId;

    private void SelectProfession(string professionId)
    {
        if (character == null) return;
        if (professionId == character.ActiveCombatProfessionId) return;
        selectedProfessionId = professionId;
        showSwitchConfirm = true;
        switchError = string.Empty;
    }

    private async Task ConfirmSwitch()
    {
        if (character == null || string.IsNullOrEmpty(selectedProfessionId)) return;
        isSwitching = true;
        switchError = string.Empty;
        try
        {
            var response = await CharacterService.SwitchProfessionAsync(character.Id, selectedProfessionId);
            if (response?.Success == true && response.Character != null)
            {
                character = response.Character;
                showSwitchConfirm = false;
                if (OnProfessionSwitched.HasDelegate)
                    await OnProfessionSwitched.InvokeAsync(character);
            }
            else
                switchError = response?.Message ?? "切换失败";
        }
        catch (Exception ex)
        {
            switchError = $"切换失败: {ex.Message}";
        }
        finally
        {
            isSwitching = false;
        }
    }

    private void CancelSwitch()
    {
        showSwitchConfirm = false;
        selectedProfessionId = string.Empty;
        switchError = string.Empty;
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
}

<style>
    .profession-selector-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .ps-header {
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .ps-header .btn {
            margin-top: 0;
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .ps-body {
        padding: 20px;
    }

    .section {
        margin-bottom: 24px;
    }

        .section:last-child {
            margin-bottom: 0;
        }

    .section-title {
        color: #495057;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #dee2e6;
        font-size: .95rem;
        font-weight: 600;
        letter-spacing: .5px;
    }

    .profession-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        gap: 15px;
    }

    .profession-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 12px;
        cursor: pointer;
        transition: .2s;
        background: #fff;
        display: flex;
        flex-direction: column;
    }

        .profession-card:hover {
            border-color: #667eea;
            box-shadow: 0 2px 8px rgba(102,126,234,.2);
            transform: translateY(-2px);
        }

        .profession-card.active {
            border-color: #28a745;
            background: #f0fff4;
            box-shadow: 0 2px 8px rgba(40,167,69,.3);
        }

        .profession-card.noncombat {
            cursor: default;
            border-color: #b8c2cc;
            background: #f8f9fa;
        }

            .profession-card.noncombat:hover {
                transform: none;
                box-shadow: none;
                border-color: #b8c2cc;
            }

    .profession-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: .95rem;
    }

    .profession-level {
        font-size: .85rem;
        color: #495057;
        margin-bottom: 6px;
    }

    .profession-exp {
        margin-bottom: 8px;
    }

    .exp-bar {
        height: 8px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 4px;
    }

    .exp-fill {
        height: 100%;
        background: linear-gradient(90deg,#667eea 0%,#764ba2 100%);
        transition: width .3s;
    }

        .exp-fill.nc {
            background: linear-gradient(90deg,#17a2b8 0%,#20c997 100%);
        }

    .exp-text {
        font-size: .7rem;
        color: #6c757d;
        text-align: right;
    }

    .profession-stats-preview {
        padding-top: 8px;
        border-top: 1px solid #e9ecef;
        font-size: .7rem;
    }

    .profession-note {
        margin-top: 6px;
        font-size: .7rem;
        color: #6c757d;
    }

    .switch-confirm p {
        margin: 0 0 8px 0;
    }
</style>