@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.DTOs
@using BlazorIdle.Shared.Constants
@using BlazorIdle.Game.Config
@using BlazorIdle.Game.Purchase
@using BlazorIdle.Services
@inject IGameConfigService GameConfig
@inject IUserService UserService

<div class="unified-shop-panel">
    <div class="shop-header"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0">
            <span class="icon">🛒</span>
            商店 (Shop)
        </h5>

        <div class="d-flex align-items-center gap-3">
            @if (Character != null)
            {
                <div class="gold-balance-display">
                    <span class="gold-icon">🪙</span>
                    <span class="gold-amount">@GetGoldBalance().ToString("N0")</span>
                </div>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="shop-content" style="@(isCollapsed ? "display:none" : null)">
        @if (Character == null)
        {
            <div class="empty-state">
                <p class="text-muted mb-0">请先选择角色...</p>
            </div>
        }
        else
        {
            <!-- 商店分类标签 -->
            <div class="shop-tabs">
                <button class="shop-tab @(activeTab == "system" ? "active" : "")"
                        @onclick="SwitchToSystem">
                    <span class="tab-icon">🏛️</span>
                    <span class="tab-text">系统</span>
                </button>
                <button class="shop-tab @(activeTab == "consumable" ? "active" : "")"
                        @onclick="SwitchToConsumable">
                    <span class="tab-icon">🏪</span>
                    <span class="tab-text">消耗品</span>
                </button>
                <button class="shop-tab @(activeTab == "potion" ? "active" : "")"
                        @onclick="SwitchToPotion">
                    <span class="tab-icon">🧪</span>
                    <span class="tab-text">药水</span>
                </button>
                <button class="shop-tab @(activeTab == "food" ? "active" : "")"
                        @onclick="SwitchToFood">
                    <span class="tab-icon">🍖</span>
                    <span class="tab-text">食品</span>
                </button>
            </div>

            <!-- 消息提示区域 -->
            <div class="message-area">
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mb-3">@successMessage</div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-3">@errorMessage</div>
                }
            </div>

            <!-- 商店内容区域 -->
            <div class="shop-body">
                @if (activeTab == "system")
                {
                    @if (isLoading)
                    {
                        <div class="text-center p-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">加载中...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="shop-items-grid system-grid">
                            <div class="shop-item system-item @(shopInfo == null || !shopInfo.CanPurchase ? "sold-out" : "") @(!CanAffordSlot() ? "cannot-afford" : "")">
                                <div class="item-icon system-icon">👤</div>
                                <div class="item-info">
                                    <div class="item-name">角色槽位 +1</div>
                                    <div class="item-desc">增加一个可创建角色的槽位</div>

                                    <div class="item-meta">
                                        <span class="price">
                                            <span class="gold-icon">🪙</span>
                                            @(shopInfo?.Price.ToString("N0") ?? "5,000")
                                        </span>
                                        @if (shopInfo != null)
                                        {
                                            <span class="limit">
                                                @if (shopInfo.CanPurchase)
                                                {
                                                    <span class="remaining">剩余 @(shopInfo.MaxPurchases - shopInfo.PurchasedCount) 次</span>
                                                }
                                                else
                                                {
                                                    <span class="exhausted">已售罄</span>
                                                }
                                            </span>
                                        }
                                        <span class="current-slots">
                                            当前槽位: @(shopInfo?.CurrentSlots ?? 1)
                                        </span>
                                    </div>
                                </div>

                                <button class="btn btn-primary btn-sm purchase-btn"
                                        disabled="@(isPurchasing || shopInfo == null || !shopInfo.CanPurchase || !CanAffordSlot())"
                                        @onclick="PurchaseCharacterSlot">
                                    @if (isPurchasing && activeTab == "system")
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else if (shopInfo != null && !shopInfo.CanPurchase)
                                    {
                                        <span>已购买</span>
                                    }
                                    else if (!CanAffordSlot())
                                    {
                                        <span>金币不足</span>
                                    }
                                    else
                                    {
                                        <span>购买</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- 消耗品/药水/食品商店 -->
                    <div class="shop-items-grid">
                        @foreach (var shopItem in GetCurrentShopItems())
                        {
                            var itemDef = GameConfig.GetItem(shopItem.ItemId);
                            if (itemDef == null) continue;

                            var canAfford = CanAfford(shopItem.Price);
                            var remaining = GetRemainingPurchases(shopItem.ItemId, shopItem);
                            var isSoldOut = remaining == 0;

                            <div class="shop-item-card @(canAfford && !isSoldOut ? "affordable" : "") @GetTabColorClass()">
                                <div class="item-icon-large">@(itemDef.Icon ?? GetDefaultIcon())</div>
                                <div class="item-info">
                                    <div class="item-name">
                                        @itemDef.Name
                                        @if (itemDef.Type == ItemType.SkillBook)
                                        {
                                            <span class="badge bg-info ms-1">技能书</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(itemDef.Description))
                                    {
                                        <div class="item-desc">@itemDef.Description</div>
                                    }
                                    @if (itemDef.Metadata?.EffectDescription != null)
                                    {
                                        <div class="item-effect">
                                            <span class="effect-icon">✨</span> @itemDef.Metadata.EffectDescription
                                        </div>
                                    }
                                </div>
                                <div class="item-purchase">
                                    <div class="price-display @(canAfford ? "affordable-price" : "unaffordable-price")">
                                        <span class="price-icon">🪙</span>
                                        <span class="price-amount">@shopItem.Price.ToString("N0")</span>
                                    </div>
                                    @if (remaining >= 0)
                                    {
                                        <div class="limit-info">
                                            剩余: @remaining
                                        </div>
                                    }
                                    <button class="btn btn-sm @(canAfford && !isSoldOut ? "btn-success" : "btn-secondary")"
                                            disabled="@(!canAfford || isSoldOut || isPurchasing)"
                                            @onclick="() => PurchaseItem(shopItem)">
                                        @if (isPurchasing && currentPurchasingItemId == shopItem.ItemId)
                                        {
                                            <span>购买中...</span>
                                        }
                                        else if (isSoldOut)
                                        {
                                            <span>已售罄</span>
                                        }
                                        else if (!canAfford)
                                        {
                                            <span>金币不足</span>
                                        }
                                        else
                                        {
                                            <span>购买</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public CharacterData? Character { get; set; }

    [Parameter]
    public EventCallback OnItemPurchased { get; set; }

    [Parameter]
    public EventCallback OnSlotPurchased { get; set; }

    [Parameter]
    public bool StartCollapsed { get; set; }

    private bool isCollapsed;
    private bool isLoading = true;
    private bool isPurchasing = false;
    private string activeTab = "system";
    private string? currentPurchasingItemId = null;
    private string? errorMessage = null;
    private string? successMessage = null;

    private PurchaseService? _purchaseService;
    private AccountPurchaseState? _accountPurchaseState;
    private CharacterSlotShopInfo? shopInfo;

    // 各商店商品列表
    private List<ShopItemConfig> consumableItems = new();
    private List<ShopItemConfig> potionItems = new();
    private List<ShopItemConfig> foodItems = new();

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        isCollapsed = StartCollapsed;

        // 加载各商店配置
        LoadShopConfigs();

        // 加载账号级购买状态
        _accountPurchaseState = await UserService.GetAccountPurchaseStateAsync();

        // 加载系统商店信息
        await LoadShopInfoAsync();
    }

    protected override void OnParametersSet()
    {
        if (Character != null)
        {
            if (_accountPurchaseState != null)
            {
                _purchaseService = new PurchaseService(Character.PurchaseState, _accountPurchaseState);
            }
            else
            {
                _purchaseService = new PurchaseService(Character.PurchaseState);
            }
        }
    }

    private void LoadShopConfigs()
    {
        consumableItems = ConfigRepository.LoadConsumableShop();
        potionItems = ConfigRepository.LoadPotionShop();
        foodItems = ConfigRepository.LoadFoodShop();
    }

    private async Task LoadShopInfoAsync()
    {
        isLoading = true;
        try
        {
            shopInfo = await UserService.GetCharacterSlotShopInfoAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;

    private void SwitchToSystem() => activeTab = "system";
    private void SwitchToConsumable() => activeTab = "consumable";
    private void SwitchToPotion() => activeTab = "potion";
    private void SwitchToFood() => activeTab = "food";

    private List<ShopItemConfig> GetCurrentShopItems()
    {
        return activeTab switch
        {
            "consumable" => consumableItems,
            "potion" => potionItems,
            "food" => foodItems,
            _ => new List<ShopItemConfig>()
        };
    }

    private string GetDefaultIcon()
    {
        return activeTab switch
        {
            "consumable" => "📦",
            "potion" => "🧪",
            "food" => "🍖",
            _ => "📦"
        };
    }

    private string GetTabColorClass()
    {
        return activeTab switch
        {
            "consumable" => "consumable-theme",
            "potion" => "potion-theme",
            "food" => "food-theme",
            _ => ""
        };
    }

    private int GetGoldBalance()
    {
        if (Character == null) return 0;
        return Character.Inventory?.GetItemQuantity(ItemIds.GoldCoin) ?? 0;
    }

    private bool CanAfford(int price)
    {
        return GetGoldBalance() >= price;
    }

    private bool CanAffordSlot()
    {
        if (shopInfo == null) return false;
        return GetGoldBalance() >= shopInfo.Price;
    }

    private int GetRemainingPurchases(string itemId, ShopItemConfig shopItem)
    {
        if (_purchaseService == null || Character == null) return -1;
        if (shopItem.Limits == null) return -1;

        return _purchaseService.GetRemainingPurchases(
            itemId,
            Character.Id,
            Character.UserId.ToString(),
            shopItem.Limits);
    }

    private int GetCharacterLevel()
    {
        if (Character == null) return 1;

        string professionId = Character.ActiveCombatProfessionId;
        if (Character.Professions.TryGetValue(professionId, out var progress))
        {
            return progress.Level;
        }

        return 1;
    }

    private async Task PurchaseCharacterSlot()
    {
        if (Character == null || isPurchasing || shopInfo == null || !shopInfo.CanPurchase)
            return;

        if (!CanAffordSlot())
        {
            errorMessage = $"金币不足，需要 {shopInfo.Price:N0} 金币";
            return;
        }

        errorMessage = null;
        successMessage = null;
        isPurchasing = true;

        try
        {
            var result = await UserService.PurchaseCharacterSlotAsync(Character.Id);

            if (result?.Success == true)
            {
                successMessage = result.Message;
                Character.Inventory?.RemoveItem(ItemIds.GoldCoin, shopInfo.Price);
                await LoadShopInfoAsync();

                if (OnSlotPurchased.HasDelegate)
                {
                    await OnSlotPurchased.InvokeAsync();
                }

                _ = Task.Delay(3000).ContinueWith(async _ =>
                {
                    successMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
            else
            {
                errorMessage = result?.Message ?? "购买失败";
                _ = Task.Delay(3000).ContinueWith(async _ =>
                {
                    errorMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
        }
        finally
        {
            isPurchasing = false;
            StateHasChanged();
        }
    }

    private async Task PurchaseItem(ShopItemConfig shopItem)
    {
        if (Character == null || _purchaseService == null || isPurchasing)
            return;

        var itemDef = GameConfig.GetItem(shopItem.ItemId);
        if (itemDef == null)
            return;

        errorMessage = null;
        successMessage = null;
        isPurchasing = true;
        currentPurchasingItemId = shopItem.ItemId;

        try
        {
            var purchaseConfig = new PurchasableConfig
            {
                Id = shopItem.ItemId,
                DisplayName = itemDef.Name,
                CurrencyType = CurrencyType.Gold,
                BasePrice = shopItem.Price,
                DiscountPercent = 0,
                Limits = shopItem.Limits ?? new PurchaseLimit(),
                Unlock = null
            };

            var result = _purchaseService.Purchase(
                purchaseConfig,
                Character,
                Character.ActiveCombatProfessionId,
                GetCharacterLevel(),
                (c) => c.Inventory.AddItem(shopItem.ItemId, 1)
            );

            if (result.Success)
            {
                successMessage = $"成功购买 {itemDef.Name}（消耗 {result.SpentAmount} 🪙）";

                if (_accountPurchaseState != null && shopItem.Limits?.PerAccount > 0)
                {
                    await UserService.UpdateAccountPurchaseStateAsync(_accountPurchaseState);
                }

                if (OnItemPurchased.HasDelegate)
                {
                    await OnItemPurchased.InvokeAsync();
                }

                _ = Task.Delay(2000).ContinueWith(async _ =>
                {
                    successMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
            else
            {
                errorMessage = result.Message;

                _ = Task.Delay(3000).ContinueWith(async _ =>
                {
                    errorMessage = null;
                    await InvokeAsync(StateHasChanged);
                }, TaskScheduler.Default);
            }
        }
        finally
        {
            isPurchasing = false;
            currentPurchasingItemId = null;
            StateHasChanged();
        }
    }
}

