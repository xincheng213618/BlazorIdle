@using BlazorIdle.Shared.Models
@using BlazorIdle.Game.Config
@using BlazorIdle.Game.Consumables
@inject IGameConfigService GameConfig
@implements IDisposable

<div class="consumable-slot-panel">
    <div class="panel-header"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0">
            <span class="icon">🧪</span>
            消耗品装备 (Consumables)
        </h5>

        <div class="d-flex align-items-center gap-2">
            @if (IsInBattle)
            {
                <span class="badge bg-warning">
                    <span class="lock-icon">🔒</span> 战斗中
                </span>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="panel-body" style="@(isCollapsed ? "display:none" : null)">
        @if (Character == null)
        {
            <div class="text-muted">请先选择角色...</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert @statusAlertClass mb-3">@statusMessage</div>
            }

            <div class="slots-container">
                <!-- 药水槽位 -->
                <div class="slot-section">
                    <h6 class="slot-title">
                        <span class="badge bg-primary">药水槽位</span>
                        <span class="ms-2 small text-muted">增益效果</span>
                    </h6>
                    <div class="slot-grid">
                        @foreach (var slotId in ConsumableManager.PotionSlotIds)
                        {
                            @RenderSlot(slotId, "potion")
                        }
                    </div>
                </div>

                <!-- 食物槽位 -->
                <div class="slot-section mt-3">
                    <h6 class="slot-title">
                        <span class="badge bg-success">食物槽位</span>
                        <span class="ms-2 small text-muted">恢复效果</span>
                    </h6>
                    <div class="slot-grid">
                        @foreach (var slotId in ConsumableManager.FoodSlotIds)
                        {
                            @RenderSlot(slotId, "food")
                        }
                    </div>
                </div>
            </div>

            <!-- 物品选择弹窗 -->
            @if (showItemSelector && !string.IsNullOrEmpty(selectedSlotId))
            {
                <div class="item-selector-overlay" @onclick="CloseSelector">
                    <div class="item-selector-modal" @onclick:stopPropagation="true">
                        <div class="selector-header">
                            <h6 class="mb-0">
                                选择@(ConsumableManager.IsPotionSlot(selectedSlotId) ? "药水" : "食物")
                            </h6>
                            <button class="btn-close" @onclick="CloseSelector"></button>
                        </div>
                        <div class="selector-body">
                            @{
                                var category = ConsumableManager.GetSlotCategory(selectedSlotId) ?? "";
                                var availableItems = GetAvailableItems(category);
                            }
                            @if (availableItems.Count == 0)
                            {
                                <div class="empty-state">
                                    <p class="text-muted mb-0">
                                        暂无可用的@(category == "potion" ? "药水" : "食物")
                                    </p>
                                    <small class="text-muted">请先在商店购买</small>
                                </div>
                            }
                            else
                            {
                                <div class="item-list">
                                    @foreach (var (item, quantity) in availableItems)
                                    {
                                        var isCurrentlyEquipped = IsItemEquippedInSlot(item.Id, selectedSlotId);
                                        var isEquippedElsewhere = IsItemEquippedElsewhere(item.Id, selectedSlotId);
                                        
                                        <div class="item-option @(isCurrentlyEquipped ? "current" : "") @(isEquippedElsewhere ? "disabled" : "") @(quantity == 0 ? "out-of-stock" : "")"
                                             @onclick="@(() => SelectItem(item.Id, isEquippedElsewhere, quantity))">
                                            <div class="item-icon">@(item.Icon ?? "📦")</div>
                                            <div class="item-info">
                                                <div class="item-name">@item.Name</div>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    <div class="item-desc">@item.Description</div>
                                                }
                                                @if (item.ConsumableConfig != null)
                                                {
                                                    <div class="item-meta">
                                                        <span class="cooldown">CD: @item.ConsumableConfig.CooldownSec s</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="item-quantity">
                                                <span class="quantity-badge @(quantity == 0 ? "empty" : "")">
                                                    ×@quantity
                                                </span>
                                                @if (isCurrentlyEquipped)
                                                {
                                                    <span class="badge bg-success">已装备</span>
                                                }
                                                @if (isEquippedElsewhere)
                                                {
                                                    <span class="badge bg-secondary">已在其他槽位</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="selector-footer">
                            @if (!IsSlotEmpty(selectedSlotId))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="UnequipCurrentSlot">
                                    卸载
                                </button>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="CloseSelector">
                                取消
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    /// 当前角色数据
    /// Current character data
    /// </summary>
    [Parameter]
    public CharacterData? Character { get; set; }

    /// <summary>
    /// 是否在战斗中
    /// Whether currently in battle
    /// </summary>
    [Parameter]
    public bool IsInBattle { get; set; }

    /// <summary>
    /// 消耗品装备变更回调
    /// Consumable equipment changed callback
    /// </summary>
    [Parameter]
    public EventCallback OnConsumableEquipped { get; set; }

    /// <summary>
    /// 消耗品卸载回调
    /// Consumable unequipped callback
    /// </summary>
    [Parameter]
    public EventCallback OnConsumableUnequipped { get; set; }

    /// <summary>
    /// 初始是否折叠
    /// Initial collapsed state
    /// </summary>
    [Parameter]
    public bool StartCollapsed { get; set; }

    private ConsumableManager? _manager;
    private bool isCollapsed;
    private bool showItemSelector;
    private string? selectedSlotId;
    private string? statusMessage;
    private string statusAlertClass = "alert-info";
    private Inventory? _subscribedInventory;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        _manager = new ConsumableManager(GameConfig);
        isCollapsed = StartCollapsed;
    }

    protected override void OnParametersSet()
    {
        // 订阅库存变化
        if (!ReferenceEquals(_subscribedInventory, Character?.Inventory))
        {
            if (_subscribedInventory != null)
                _subscribedInventory.Changed -= OnInventoryChanged;
            
            if (Character?.Inventory != null)
                Character.Inventory.Changed += OnInventoryChanged;
            
            _subscribedInventory = Character?.Inventory;
        }
    }

    private void OnInventoryChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;

    private RenderFragment RenderSlot(string slotId, string category) => builder =>
    {
        var slot = GetSlotData(slotId);
        var isEquipped = slot?.IsEquipped ?? false;
        var quantity = isEquipped ? GetItemQuantity(slot!.ItemId!) : 0;
        var itemDef = isEquipped ? GameConfig.GetItem(slot!.ItemId!) : null;
        var isOutOfStock = isEquipped && quantity == 0;
        var slotNumber = slotId.EndsWith("_1") ? "1" : "2";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"consumable-slot {(isEquipped ? "equipped" : "empty")} {(isOutOfStock ? "out-of-stock" : "")} {(IsInBattle ? "locked" : "")}");
        builder.AddAttribute(2, "role", "button");
        if (!IsInBattle)
        {
            builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => OpenSelector(slotId)));
        }

        // 槽位编号
        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", $"slot-index badge {(category == "potion" ? "bg-primary" : "bg-success")}");
        builder.AddContent(6, slotNumber);
        builder.CloseElement();

        if (isEquipped && itemDef != null)
        {
            // 物品图标
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "class", $"slot-icon {category}");
            builder.AddContent(9, itemDef.Icon ?? "📦");
            builder.CloseElement();

            // 物品信息
            builder.OpenElement(10, "div");
            builder.AddAttribute(11, "class", "slot-info");
            
            builder.OpenElement(12, "div");
            builder.AddAttribute(13, "class", "slot-name");
            builder.AddContent(14, itemDef.Name);
            builder.CloseElement();

            builder.OpenElement(15, "div");
            builder.AddAttribute(16, "class", $"slot-quantity {(isOutOfStock ? "empty" : "")}");
            builder.AddContent(17, $"×{quantity}");
            builder.CloseElement();

            builder.CloseElement();

            // 卸载按钮
            if (!IsInBattle)
            {
                builder.OpenElement(18, "button");
                builder.AddAttribute(19, "class", "btn-unequip-slot");
                builder.AddAttribute(20, "onclick", EventCallback.Factory.Create(this, async () =>
                {
                    await UnequipSlot(slotId);
                }));
                builder.AddAttribute(21, "title", "卸载");
                builder.AddEventStopPropagationAttribute(22, "onclick", true);
                builder.AddContent(23, "×");
                builder.CloseElement();
            }
        }
        else
        {
            // 空槽位
            builder.OpenElement(24, "div");
            builder.AddAttribute(25, "class", "slot-empty");
            if (IsInBattle)
            {
                builder.AddContent(26, "🔒 战斗中无法修改");
            }
            else
            {
                builder.AddContent(27, $"点击装备{(category == "potion" ? "药水" : "食物")}");
            }
            builder.CloseElement();
        }

        // 锁定图标
        if (IsInBattle)
        {
            builder.OpenElement(28, "div");
            builder.AddAttribute(29, "class", "lock-overlay");
            builder.AddContent(30, "🔒");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private ConsumableSlotData? GetSlotData(string slotId)
    {
        if (Character == null || _manager == null)
            return null;
        return _manager.GetEquippedConsumable(Character, slotId);
    }

    private int GetItemQuantity(string itemId)
    {
        if (Character == null || string.IsNullOrEmpty(itemId))
            return 0;
        return Character.Inventory.GetItemQuantity(itemId);
    }

    private bool IsSlotEmpty(string slotId)
    {
        if (_manager == null || Character == null)
            return true;
        return _manager.IsSlotEmpty(Character, slotId);
    }

    private bool IsItemEquippedInSlot(string itemId, string slotId)
    {
        var slot = GetSlotData(slotId);
        return slot?.ItemId == itemId;
    }

    private bool IsItemEquippedElsewhere(string itemId, string currentSlotId)
    {
        if (Character?.EquippedConsumables == null)
            return false;
        
        var equippedSlotId = Character.EquippedConsumables.GetEquippedSlotId(itemId);
        return equippedSlotId != null && equippedSlotId != currentSlotId;
    }

    private List<(ItemDefinition Item, int Quantity)> GetAvailableItems(string category)
    {
        if (_manager == null || Character == null)
            return new List<(ItemDefinition, int)>();
        
        return _manager.GetAvailableConsumables(Character, category);
    }

    private void OpenSelector(string slotId)
    {
        if (IsInBattle) return;
        
        selectedSlotId = slotId;
        showItemSelector = true;
        ClearStatus();
    }

    private void CloseSelector()
    {
        showItemSelector = false;
        selectedSlotId = null;
    }

    private async Task SelectItem(string itemId, bool isEquippedElsewhere, int quantity)
    {
        if (IsInBattle || _manager == null || Character == null || string.IsNullOrEmpty(selectedSlotId))
            return;

        // 禁止选择已在其他槽位装备的物品
        if (isEquippedElsewhere)
        {
            ShowStatus("该物品已装备在其他槽位", "alert-warning");
            return;
        }

        // 禁止选择无库存的物品
        if (quantity <= 0)
        {
            ShowStatus("库存不足，请先购买", "alert-warning");
            return;
        }

        var result = _manager.EquipConsumable(Character, selectedSlotId, itemId, IsInBattle);
        
        if (result == ConsumableOperationResult.Success)
        {
            ShowStatus("装备成功！", "alert-success");
            CloseSelector();
            
            if (OnConsumableEquipped.HasDelegate)
                await OnConsumableEquipped.InvokeAsync();
            
            ClearStatusAfterDelay();
        }
        else
        {
            ShowStatus(GetResultMessage(result), "alert-danger");
        }

        StateHasChanged();
    }

    private async Task UnequipSlot(string slotId)
    {
        if (IsInBattle || _manager == null || Character == null)
            return;

        var result = _manager.UnequipConsumable(Character, slotId, IsInBattle);
        
        if (result == ConsumableOperationResult.Success)
        {
            ShowStatus("卸载成功！", "alert-success");
            
            if (OnConsumableUnequipped.HasDelegate)
                await OnConsumableUnequipped.InvokeAsync();
            
            ClearStatusAfterDelay();
        }
        else
        {
            ShowStatus(GetResultMessage(result), "alert-danger");
        }

        StateHasChanged();
    }

    private async Task UnequipCurrentSlot()
    {
        if (!string.IsNullOrEmpty(selectedSlotId))
        {
            await UnequipSlot(selectedSlotId);
            CloseSelector();
        }
    }

    private void ShowStatus(string message, string alertClass)
    {
        statusMessage = message;
        statusAlertClass = alertClass;
    }

    private void ClearStatus()
    {
        statusMessage = null;
    }

    private void ClearStatusAfterDelay()
    {
        _ = Task.Delay(2000).ContinueWith(async _ =>
        {
            statusMessage = null;
            await InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    private string GetResultMessage(ConsumableOperationResult result) => result switch
    {
        ConsumableOperationResult.Success => "操作成功",
        ConsumableOperationResult.ItemNotFound => "物品不存在",
        ConsumableOperationResult.NotConsumable => "物品不是消耗品",
        ConsumableOperationResult.CategoryMismatch => "物品类型与槽位不匹配",
        ConsumableOperationResult.AlreadyEquipped => "物品已装备在其他槽位",
        ConsumableOperationResult.InsufficientInventory => "库存不足",
        ConsumableOperationResult.InvalidSlotId => "无效的槽位",
        ConsumableOperationResult.LockedInBattle => "战斗中无法修改",
        ConsumableOperationResult.InvalidCharacterData => "角色数据无效",
        _ => "未知错误"
    };

    /// <summary>
    /// 公共刷新方法 - 用于外部触发UI更新
    /// Public refresh method - for external UI update trigger
    /// </summary>
    public void Refresh()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_subscribedInventory != null)
            _subscribedInventory.Changed -= OnInventoryChanged;
    }
}

<style>
    .consumable-slot-panel {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .panel-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }

    .panel-header h5 {
        color: white;
        font-weight: 600;
        margin: 0;
    }

    .panel-header .icon {
        font-size: 1.2em;
        margin-right: 8px;
    }

    .panel-header .btn {
        margin-top: 0;
        padding: .25rem .5rem;
        line-height: 1.2;
        border: 1px solid rgba(255,255,255,.5);
    }

    .panel-body {
        padding: 20px;
    }

    .slots-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .slot-section .slot-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #495057;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .slot-grid {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .consumable-slot {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        transition: border-color .15s, box-shadow .15s, background .15s;
        cursor: pointer;
        min-height: 72px;
        min-width: 200px;
        flex: 1;
        max-width: 300px;
    }

    .consumable-slot:hover:not(.locked) {
        border-color: #667eea;
        box-shadow: 0 2px 8px rgba(102,126,234,.25);
    }

    .consumable-slot.equipped {
        border-left: 4px solid #28a745;
        background: #f7fbf8;
    }

    .consumable-slot.out-of-stock {
        border-color: #dc3545;
        background: #fff5f5;
    }

    .consumable-slot.out-of-stock .slot-quantity {
        color: #dc3545;
        font-weight: bold;
    }

    .consumable-slot.locked {
        cursor: not-allowed;
        opacity: 0.7;
    }

    .slot-index {
        font-size: 0.7rem;
        padding: 6px 8px;
    }

    .slot-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .slot-icon.potion {
        background: linear-gradient(135deg, #6c63ff 0%, #a855f7 100%);
    }

    .slot-icon.food {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    }

    .slot-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .slot-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #212529;
        line-height: 1.2;
    }

    .slot-quantity {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .slot-quantity.empty {
        color: #dc3545;
        font-weight: 600;
    }

    .slot-empty {
        flex: 1;
        display: flex;
        align-items: center;
        color: #6c757d;
        font-style: italic;
        font-size: 0.9rem;
    }

    .btn-unequip-slot {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 24px;
        height: 24px;
        border: none;
        background: #f44336;
        color: #fff;
        border-radius: 50%;
        font-size: 14px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s;
    }

    .btn-unequip-slot:hover {
        background: #d32f2f;
    }

    .lock-overlay {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        font-size: 1.2em;
        opacity: 0.6;
    }

    .lock-icon {
        font-size: 0.9em;
    }

    /* 物品选择弹窗 */
    .item-selector-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .item-selector-modal {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        max-width: 450px;
        width: 90%;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #e9ecef;
    }

    .selector-header h6 {
        font-weight: 600;
        color: #212529;
    }

    .selector-body {
        padding: 16px;
        overflow-y: auto;
        flex: 1;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
    }

    .item-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .item-option {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .item-option:hover:not(.disabled):not(.out-of-stock) {
        background: #e9ecef;
        border-color: #667eea;
        transform: translateX(2px);
    }

    .item-option.current {
        border-color: #28a745;
        background: #f0fff4;
    }

    .item-option.disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .item-option.out-of-stock {
        opacity: 0.6;
        cursor: not-allowed;
        background: #fff5f5;
    }

    .item-icon {
        font-size: 2em;
        line-height: 1;
    }

    .item-info {
        flex: 1;
        min-width: 0;
    }

    .item-name {
        font-weight: 600;
        color: #212529;
    }

    .item-desc {
        font-size: 0.85em;
        color: #6c757d;
    }

    .item-meta {
        font-size: 0.8em;
        color: #868e96;
        margin-top: 2px;
    }

    .item-quantity {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    .quantity-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.85em;
    }

    .quantity-badge.empty {
        background: #dc3545;
    }

    .selector-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid #e9ecef;
    }

    .selector-footer .btn {
        margin-top: 0;
    }

    .alert {
        padding: 10px 14px;
        border-radius: 6px;
        font-size: 0.9em;
    }

    /* 响应式 */
    @@media (max-width: 600px) {
        .slot-grid {
            flex-direction: column;
        }

        .consumable-slot {
            max-width: none;
        }

        .item-selector-modal {
            width: 95%;
            max-height: 90vh;
        }
    }
</style>
