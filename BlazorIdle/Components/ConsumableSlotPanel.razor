@using BlazorIdle.Shared.Models
@using BlazorIdle.Game.Config
@using BlazorIdle.Game.Consumables
@inject IGameConfigService GameConfig
@implements IDisposable

<div class="consumable-slot-panel">
    <div class="panel-header"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0">
            <span class="icon">🧪</span>
            消耗品装备 (Consumables)
        </h5>

        <div class="d-flex align-items-center gap-2">
            @if (IsInBattle)
            {
                <span class="badge bg-warning">
                    <span class="lock-icon">🔒</span> 战斗中
                </span>
            }
            <button class="btn btn-sm btn-outline-light"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleCollapse">
                @(isCollapsed ? "展开" : "收起")
            </button>
        </div>
    </div>

    <div class="panel-body" style="@(isCollapsed ? "display:none" : null)">
        @if (Character == null)
        {
            <div class="text-muted">请先选择角色...</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert @statusAlertClass mb-3">@statusMessage</div>
            }

            <div class="slots-container">
                <!-- 药水槽位 -->
                <div class="slot-section">
                    <h6 class="slot-title">
                        <span class="badge bg-primary">药水槽位</span>
                        <span class="ms-2 small text-muted">增益效果</span>
                    </h6>
                    <div class="slot-grid">
                        @foreach (var slotId in ConsumableManager.PotionSlotIds)
                        {
                            @RenderSlot(slotId, "potion")
                        }
                    </div>
                </div>

                <!-- 食物槽位 -->
                <div class="slot-section mt-3">
                    <h6 class="slot-title">
                        <span class="badge bg-success">食物槽位</span>
                        <span class="ms-2 small text-muted">恢复效果</span>
                    </h6>
                    <div class="slot-grid">
                        @foreach (var slotId in ConsumableManager.FoodSlotIds)
                        {
                            @RenderSlot(slotId, "food")
                        }
                    </div>
                </div>
            </div>

            <!-- 物品选择弹窗 -->
            @if (showItemSelector && !string.IsNullOrEmpty(selectedSlotId))
            {
                <div class="item-selector-overlay" @onclick="CloseSelector">
                    <div class="item-selector-modal" @onclick:stopPropagation="true">
                        <div class="selector-header">
                            <h6 class="mb-0">
                                选择@(ConsumableManager.IsPotionSlot(selectedSlotId) ? "药水" : "食物")
                            </h6>
                            <button class="btn-close" @onclick="CloseSelector"></button>
                        </div>
                        <div class="selector-body">
                            @{
                                var category = ConsumableManager.GetSlotCategory(selectedSlotId) ?? "";
                                var availableItems = GetAvailableItems(category);
                            }
                            @if (availableItems.Count == 0)
                            {
                                <div class="empty-state">
                                    <p class="text-muted mb-0">
                                        暂无可用的@(category == "potion" ? "药水" : "食物")
                                    </p>
                                    <small class="text-muted">请先在商店购买</small>
                                </div>
                            }
                            else
                            {
                                <div class="item-list">
                                    @foreach (var (item, quantity) in availableItems)
                                    {
                                        var isCurrentlyEquipped = IsItemEquippedInSlot(item.Id, selectedSlotId);
                                        var isEquippedElsewhere = IsItemEquippedElsewhere(item.Id, selectedSlotId);
                                        
                                        <div class="item-option @(isCurrentlyEquipped ? "current" : "") @(isEquippedElsewhere ? "disabled" : "") @(quantity == 0 ? "out-of-stock" : "")"
                                             @onclick="@(() => SelectItem(item.Id, isEquippedElsewhere, quantity))">
                                            <div class="item-icon">@(item.Icon ?? "📦")</div>
                                            <div class="item-info">
                                                <div class="item-name">@item.Name</div>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    <div class="item-desc">@item.Description</div>
                                                }
                                                @if (item.ConsumableConfig != null)
                                                {
                                                    <div class="item-meta">
                                                        <span class="cooldown">CD: @item.ConsumableConfig.CooldownSec s</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="item-quantity">
                                                <span class="quantity-badge @(quantity == 0 ? "empty" : "")">
                                                    ×@quantity
                                                </span>
                                                @if (isCurrentlyEquipped)
                                                {
                                                    <span class="badge bg-success">已装备</span>
                                                }
                                                @if (isEquippedElsewhere)
                                                {
                                                    <span class="badge bg-secondary">已在其他槽位</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="selector-footer">
                            @if (!IsSlotEmpty(selectedSlotId))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="UnequipCurrentSlot">
                                    卸载
                                </button>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="CloseSelector">
                                取消
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 触发条件编辑弹窗 -->
            @if (showTriggerEditor && !string.IsNullOrEmpty(editingSlotId))
            {
                <div class="item-selector-overlay" @onclick="CloseTriggerEditor">
                    <div class="item-selector-modal trigger-editor-modal" @onclick:stopPropagation="true">
                        <div class="selector-header">
                            <h6 class="mb-0">⚙️ 触发条件设置</h6>
                            <button class="btn-close" @onclick="CloseTriggerEditor"></button>
                        </div>
                        <div class="selector-body">
                            @{
                                var editingSlot = GetSlotData(editingSlotId);
                                var editingItem = editingSlot?.ItemId != null ? GameConfig.GetItem(editingSlot.ItemId) : null;
                            }
                            @if (editingSlot != null && editingItem != null)
                            {
                                <div class="trigger-info mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="item-icon">@(editingItem.Icon ?? "📦")</span>
                                        <strong>@editingItem.Name</strong>
                                    </div>
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" 
                                           id="useCustomTrigger" 
                                           checked="@editingSlot.UseCustomTrigger"
                                           @onchange="@(e => OnUseCustomTriggerChanged((bool)(e.Value ?? false)))" />
                                    <label class="form-check-label" for="useCustomTrigger">
                                        使用自定义触发条件
                                    </label>
                                </div>

                                @if (!editingSlot.UseCustomTrigger)
                                {
                                    <div class="alert alert-info small">
                                        <strong>当前使用物品默认条件：</strong>
                                        @if (editingItem.ConsumableConfig?.TriggerConditions != null)
                                        {
                                            <br/>@GetConditionDescription(editingItem.ConsumableConfig.TriggerConditions)
                                        }
                                        else
                                        {
                                            <br/><text>无条件(立即触发)</text>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="condition-editor">
                                        <!-- HP低于阈值 -->
                                        <div class="condition-row">
                                            <label class="form-label small">HP低于百分比触发</label>
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control" 
                                                       min="0" max="100" step="5"
                                                       value="@GetHpBelowPctValue()"
                                                       @onchange="@(e => OnHpBelowPctChanged(e.Value?.ToString()))" 
                                                       placeholder="例: 50" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <small class="text-muted">例如: 50 表示HP低于50%时触发</small>
                                        </div>

                                        <!-- HP高于阈值 -->
                                        <div class="condition-row mt-2">
                                            <label class="form-label small">HP高于百分比触发</label>
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control"
                                                       min="0" max="100" step="5"
                                                       value="@GetHpAbovePctValue()"
                                                       @onchange="@(e => OnHpAbovePctChanged(e.Value?.ToString()))"
                                                       placeholder="例: 80" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <small class="text-muted">例如: 80 表示HP高于80%时触发</small>
                                        </div>

                                        @if (editingConditions != null)
                                        {
                                            <div class="alert alert-secondary small mt-3">
                                                <strong>当前自定义条件：</strong>
                                                <br/>@GetConditionDescription(editingConditions)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning small mt-3">
                                                未设置条件，将立即触发（冷却好就使用）
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <div class="selector-footer">
                            <button class="btn btn-primary btn-sm" @onclick="SaveTriggerConditions">
                                保存
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick="CloseTriggerEditor">
                                取消
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    /// 当前角色数据
    /// Current character data
    /// </summary>
    [Parameter]
    public CharacterData? Character { get; set; }

    /// <summary>
    /// 当前职业ID - 用于按职业保存消耗品配置
    /// Current profession ID - used to save consumable config per profession
    /// </summary>
    [Parameter]
    public string ProfessionId { get; set; } = string.Empty;

    /// <summary>
    /// 是否在战斗中
    /// Whether currently in battle
    /// </summary>
    [Parameter]
    public bool IsInBattle { get; set; }

    /// <summary>
    /// 消耗品装备变更回调
    /// Consumable equipment changed callback
    /// </summary>
    [Parameter]
    public EventCallback OnConsumableEquipped { get; set; }

    /// <summary>
    /// 消耗品卸载回调
    /// Consumable unequipped callback
    /// </summary>
    [Parameter]
    public EventCallback OnConsumableUnequipped { get; set; }

    /// <summary>
    /// 初始是否折叠
    /// Initial collapsed state
    /// </summary>
    [Parameter]
    public bool StartCollapsed { get; set; }

    /// <summary>
    /// 冷却时间回调函数 - 用于获取消耗品剩余冷却时间
    /// Cooldown time callback - used to get consumable remaining cooldown time
    /// </summary>
    [Parameter]
    public Func<string, double>? GetCooldownRemaining { get; set; }

    /// <summary>
    /// 最大冷却时间回调函数 - 用于获取消耗品最大冷却时间
    /// Max cooldown time callback - used to get consumable max cooldown time
    /// </summary>
    [Parameter]
    public Func<string, double>? GetMaxCooldown { get; set; }

    private ConsumableManager? _manager;
    private bool isCollapsed;
    private bool showItemSelector;
    private string? selectedSlotId;
    private string? statusMessage;
    private string statusAlertClass = "alert-info";
    private Inventory? _subscribedInventory;
    private CancellationTokenSource? _clearStatusCts;
    private string _previousProfessionId = string.Empty;

    // 触发条件编辑器相关变量
    // Trigger condition editor related variables
    private bool showTriggerEditor;
    private string? editingSlotId;
    private BlazorIdle.Game.Skills.SkillConditions? editingConditions;

    /// <summary>
    /// 获取当前职业的消耗品装备配置
    /// Get consumable equipment config for current profession
    /// </summary>
    private ConsumableEquipmentConfig? CurrentConsumableConfig => 
        Character?.GetConsumablesForProfession(GetEffectiveProfessionId());

    /// <summary>
    /// 获取有效的职业ID（如果参数为空则使用角色的当前战斗职业）
    /// Get effective profession ID (use character's active combat profession if parameter is empty)
    /// </summary>
    private string GetEffectiveProfessionId() => 
        !string.IsNullOrEmpty(ProfessionId) ? ProfessionId : Character?.ActiveCombatProfessionId ?? "warrior";

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        _manager = new ConsumableManager(GameConfig);
        isCollapsed = StartCollapsed;
    }

    protected override void OnParametersSet()
    {
        // 订阅库存变化
        if (!ReferenceEquals(_subscribedInventory, Character?.Inventory))
        {
            if (_subscribedInventory != null)
                _subscribedInventory.Changed -= OnInventoryChanged;
            
            if (Character?.Inventory != null)
                Character.Inventory.Changed += OnInventoryChanged;
            
            _subscribedInventory = Character?.Inventory;
        }

        // 检测职业切换
        var currentProfessionId = GetEffectiveProfessionId();
        if (_previousProfessionId != currentProfessionId)
        {
            _previousProfessionId = currentProfessionId;
            // 职业切换时，UI会自动使用新职业的消耗品配置
            StateHasChanged();
        }
    }

    private void OnInventoryChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;

    private RenderFragment RenderSlot(string slotId, string category) => builder =>
    {
        var slot = GetSlotData(slotId);
        var isEquipped = slot?.IsEquipped ?? false;
        var quantity = isEquipped ? GetItemQuantity(slot!.ItemId!) : 0;
        var itemDef = isEquipped ? GameConfig.GetItem(slot!.ItemId!) : null;
        var isOutOfStock = isEquipped && quantity == 0;
        var slotNumber = slotId.EndsWith("_1") ? "1" : "2";
        
        // 获取冷却时间信息 / Get cooldown info
        double cooldownRemaining = 0;
        double maxCooldown = 0;
        bool isOnCooldown = false;
        if (IsInBattle && isEquipped && slot?.ItemId != null)
        {
            cooldownRemaining = GetCooldownRemaining?.Invoke(slot.ItemId) ?? 0;
            maxCooldown = GetMaxCooldown?.Invoke(slot.ItemId) ?? 0;
            isOnCooldown = cooldownRemaining > 0;
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"consumable-slot {(isEquipped ? "equipped" : "empty")} {(isOutOfStock ? "out-of-stock" : "")} {(IsInBattle ? "locked" : "")} {(isOnCooldown ? "on-cooldown" : "")}");
        builder.AddAttribute(2, "role", "button");
        if (!IsInBattle)
        {
            builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => OpenSelector(slotId)));
        }

        // 槽位编号
        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", $"slot-index badge {(category == "potion" ? "bg-primary" : "bg-success")}");
        builder.AddContent(6, slotNumber);
        builder.CloseElement();

        if (isEquipped && itemDef != null)
        {
            // 物品图标
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "class", $"slot-icon {category}");
            builder.AddContent(9, itemDef.Icon ?? "📦");
            builder.CloseElement();

            // 物品信息
            builder.OpenElement(10, "div");
            builder.AddAttribute(11, "class", "slot-info");
            
            builder.OpenElement(12, "div");
            builder.AddAttribute(13, "class", "slot-name");
            builder.AddContent(14, itemDef.Name);
            builder.CloseElement();

            builder.OpenElement(15, "div");
            builder.AddAttribute(16, "class", $"slot-quantity {(isOutOfStock ? "empty" : "")}");
            builder.AddContent(17, $"×{quantity}");
            builder.CloseElement();
            
            // 战斗中显示冷却状态 / Display cooldown status during battle
            if (IsInBattle)
            {
                builder.OpenElement(18, "div");
                builder.AddAttribute(19, "class", $"slot-cooldown {(isOnCooldown ? "cooling" : "ready")}");
                if (isOnCooldown)
                {
                    builder.AddContent(20, $"CD: {cooldownRemaining:F1}s");
                }
                else
                {
                    builder.AddContent(21, "✓ 就绪");
                }
                builder.CloseElement();
            }

            builder.CloseElement();

            // 卸载按钮
            if (!IsInBattle)
            {
                builder.OpenElement(22, "button");
                builder.AddAttribute(23, "class", "btn-unequip-slot");
                builder.AddAttribute(24, "onclick", EventCallback.Factory.Create(this, async () =>
                {
                    await UnequipSlot(slotId);
                }));
                builder.AddAttribute(25, "title", "卸载");
                builder.AddEventStopPropagationAttribute(26, "onclick", true);
                builder.AddContent(27, "×");
                builder.CloseElement();

                // 触发条件设置按钮
                builder.OpenElement(35, "button");
                builder.AddAttribute(36, "class", $"btn-trigger-settings {(slot?.UseCustomTrigger == true ? "custom" : "")}");
                builder.AddAttribute(37, "onclick", EventCallback.Factory.Create(this, () => OpenTriggerEditor(slotId)));
                builder.AddAttribute(38, "title", slot?.UseCustomTrigger == true ? "自定义触发条件" : "触发条件设置");
                builder.AddEventStopPropagationAttribute(39, "onclick", true);
                builder.AddContent(40, "⚙");
                builder.CloseElement();
            }
        }
        else
        {
            // 空槽位
            builder.OpenElement(28, "div");
            builder.AddAttribute(29, "class", "slot-empty");
            if (IsInBattle)
            {
                builder.AddContent(30, "🔒 战斗中无法修改");
            }
            else
            {
                builder.AddContent(31, $"点击装备{(category == "potion" ? "药水" : "食物")}");
            }
            builder.CloseElement();
        }

        // 锁定图标
        if (IsInBattle)
        {
            builder.OpenElement(32, "div");
            builder.AddAttribute(33, "class", "lock-overlay");
            builder.AddContent(34, "🔒");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private ConsumableSlotData? GetSlotData(string slotId)
    {
        if (Character == null || _manager == null)
            return null;
        return _manager.GetEquippedConsumable(Character, slotId, GetEffectiveProfessionId());
    }

    private int GetItemQuantity(string itemId)
    {
        if (Character == null || string.IsNullOrEmpty(itemId))
            return 0;
        return Character.Inventory.GetItemQuantity(itemId);
    }

    private bool IsSlotEmpty(string slotId)
    {
        if (_manager == null || Character == null)
            return true;
        return _manager.IsSlotEmpty(Character, slotId, GetEffectiveProfessionId());
    }

    private bool IsItemEquippedInSlot(string itemId, string slotId)
    {
        var slot = GetSlotData(slotId);
        return slot?.ItemId == itemId;
    }

    private bool IsItemEquippedElsewhere(string itemId, string currentSlotId)
    {
        if (CurrentConsumableConfig == null)
            return false;
        
        var equippedSlotId = CurrentConsumableConfig.GetEquippedSlotId(itemId);
        return equippedSlotId != null && equippedSlotId != currentSlotId;
    }

    private List<(ItemDefinition Item, int Quantity)> GetAvailableItems(string category)
    {
        if (_manager == null || Character == null)
            return new List<(ItemDefinition, int)>();
        
        return _manager.GetAvailableConsumables(Character, category, GetEffectiveProfessionId());
    }

    private void OpenSelector(string slotId)
    {
        if (IsInBattle) return;
        
        selectedSlotId = slotId;
        showItemSelector = true;
        ClearStatus();
    }

    private void CloseSelector()
    {
        showItemSelector = false;
        selectedSlotId = null;
    }

    private async Task SelectItem(string itemId, bool isEquippedElsewhere, int quantity)
    {
        if (IsInBattle || _manager == null || Character == null || string.IsNullOrEmpty(selectedSlotId))
            return;

        // 禁止选择已在其他槽位装备的物品
        if (isEquippedElsewhere)
        {
            ShowStatus("该物品已装备在其他槽位", "alert-warning");
            return;
        }

        // 禁止选择无库存的物品
        if (quantity <= 0)
        {
            ShowStatus("库存不足，请先购买", "alert-warning");
            return;
        }

        var result = _manager.EquipConsumable(Character, selectedSlotId, itemId, IsInBattle, GetEffectiveProfessionId());
        
        if (result == ConsumableOperationResult.Success)
        {
            ShowStatus("装备成功！", "alert-success");
            CloseSelector();
            
            if (OnConsumableEquipped.HasDelegate)
                await OnConsumableEquipped.InvokeAsync();
            
            ClearStatusAfterDelay();
        }
        else
        {
            ShowStatus(GetResultMessage(result), "alert-danger");
        }

        StateHasChanged();
    }

    private async Task UnequipSlot(string slotId)
    {
        if (IsInBattle || _manager == null || Character == null)
            return;

        var result = _manager.UnequipConsumable(Character, slotId, IsInBattle, GetEffectiveProfessionId());
        
        if (result == ConsumableOperationResult.Success)
        {
            ShowStatus("卸载成功！", "alert-success");
            
            if (OnConsumableUnequipped.HasDelegate)
                await OnConsumableUnequipped.InvokeAsync();
            
            ClearStatusAfterDelay();
        }
        else
        {
            ShowStatus(GetResultMessage(result), "alert-danger");
        }

        StateHasChanged();
    }

    private async Task UnequipCurrentSlot()
    {
        if (!string.IsNullOrEmpty(selectedSlotId))
        {
            await UnequipSlot(selectedSlotId);
            CloseSelector();
        }
    }

    private void ShowStatus(string message, string alertClass)
    {
        statusMessage = message;
        statusAlertClass = alertClass;
    }

    private void ClearStatus()
    {
        statusMessage = null;
    }

    private void ClearStatusAfterDelay()
    {
        _clearStatusCts?.Cancel();
        _clearStatusCts = new CancellationTokenSource();
        _ = ClearStatusWithCancellation(_clearStatusCts.Token);
    }

    private async Task ClearStatusWithCancellation(CancellationToken ct)
    {
        try
        {
            await Task.Delay(2000, ct);
            if (!ct.IsCancellationRequested)
            {
                statusMessage = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Expected when component is disposed or new message shown
        }
    }

    private string GetResultMessage(ConsumableOperationResult result) => result switch
    {
        ConsumableOperationResult.Success => "操作成功",
        ConsumableOperationResult.ItemNotFound => "物品不存在",
        ConsumableOperationResult.NotConsumable => "物品不是消耗品",
        ConsumableOperationResult.CategoryMismatch => "物品类型与槽位不匹配",
        ConsumableOperationResult.AlreadyEquipped => "物品已装备在其他槽位",
        ConsumableOperationResult.InsufficientInventory => "库存不足",
        ConsumableOperationResult.InvalidSlotId => "无效的槽位",
        ConsumableOperationResult.LockedInBattle => "战斗中无法修改",
        ConsumableOperationResult.InvalidCharacterData => "角色数据无效",
        _ => "未知错误"
    };

    #region 触发条件编辑器 / Trigger Condition Editor

    private void OpenTriggerEditor(string slotId)
    {
        editingSlotId = slotId;
        var slot = GetSlotData(slotId);
        if (slot?.UseCustomTrigger == true && slot.CustomTriggerConditions != null)
        {
            // 复制现有自定义条件以便编辑
            editingConditions = new BlazorIdle.Game.Skills.SkillConditions
            {
                HpBelowPct = slot.CustomTriggerConditions.HpBelowPct,
                HpAbovePct = slot.CustomTriggerConditions.HpAbovePct,
                RequireBuffId = slot.CustomTriggerConditions.RequireBuffId,
                ForbidBuffId = slot.CustomTriggerConditions.ForbidBuffId
            };
        }
        else
        {
            editingConditions = null;
        }
        showTriggerEditor = true;
    }

    private void CloseTriggerEditor()
    {
        showTriggerEditor = false;
        editingSlotId = null;
        editingConditions = null;
    }

    private void OnUseCustomTriggerChanged(bool useCustom)
    {
        if (string.IsNullOrEmpty(editingSlotId)) return;
        var slot = GetSlotData(editingSlotId);
        if (slot == null) return;

        slot.UseCustomTrigger = useCustom;
        if (useCustom && editingConditions == null)
        {
            editingConditions = new BlazorIdle.Game.Skills.SkillConditions();
        }
        StateHasChanged();
    }

    private void OnHpBelowPctChanged(string? value)
    {
        EnsureEditingConditions();
        if (double.TryParse(value, out var pct) && pct >= 0 && pct <= 100)
        {
            editingConditions!.HpBelowPct = pct;
        }
        else
        {
            editingConditions!.HpBelowPct = null;
        }
        StateHasChanged();
    }

    private void OnHpAbovePctChanged(string? value)
    {
        EnsureEditingConditions();
        if (double.TryParse(value, out var pct) && pct >= 0 && pct <= 100)
        {
            editingConditions!.HpAbovePct = pct;
        }
        else
        {
            editingConditions!.HpAbovePct = null;
        }
        StateHasChanged();
    }

    private void EnsureEditingConditions()
    {
        if (editingConditions == null)
        {
            editingConditions = new BlazorIdle.Game.Skills.SkillConditions();
        }
    }

    private string GetHpBelowPctValue()
    {
        return editingConditions?.HpBelowPct?.ToString() ?? "";
    }

    private string GetHpAbovePctValue()
    {
        return editingConditions?.HpAbovePct?.ToString() ?? "";
    }

    private async Task SaveTriggerConditions()
    {
        if (string.IsNullOrEmpty(editingSlotId) || Character == null) return;

        var slot = GetSlotData(editingSlotId);
        if (slot == null) return;

        // 更新槽位的自定义条件
        if (slot.UseCustomTrigger)
        {
            // 检查是否有有效条件，如果所有条件都为空则设为null
            if (editingConditions != null && 
                !editingConditions.HpBelowPct.HasValue &&
                !editingConditions.HpAbovePct.HasValue &&
                string.IsNullOrEmpty(editingConditions.RequireBuffId) &&
                string.IsNullOrEmpty(editingConditions.ForbidBuffId))
            {
                slot.CustomTriggerConditions = null;
            }
            else
            {
                slot.CustomTriggerConditions = editingConditions;
            }
        }
        else
        {
            slot.CustomTriggerConditions = null;
        }

        // 触发保存回调
        if (OnConsumableEquipped.HasDelegate)
        {
            await OnConsumableEquipped.InvokeAsync();
        }

        ShowStatus("触发条件已保存", "alert-success");
        ClearStatusAfterDelay();
        CloseTriggerEditor();
    }

    private string GetConditionDescription(BlazorIdle.Game.Skills.SkillConditions? conditions)
    {
        if (conditions == null)
            return "无条件（冷却好就触发）";

        var parts = new List<string>();

        if (conditions.HpBelowPct.HasValue)
            parts.Add($"HP < {conditions.HpBelowPct.Value}%");

        if (conditions.HpAbovePct.HasValue)
            parts.Add($"HP > {conditions.HpAbovePct.Value}%");

        if (!string.IsNullOrEmpty(conditions.RequireBuffId))
            parts.Add($"需要Buff: {conditions.RequireBuffId}");

        if (!string.IsNullOrEmpty(conditions.ForbidBuffId))
            parts.Add($"禁止Buff: {conditions.ForbidBuffId}");

        if (conditions.EnemyCountAbove.HasValue)
            parts.Add($"敌人数 ≥ {conditions.EnemyCountAbove.Value}");

        if (conditions.EnemyCountBelow.HasValue)
            parts.Add($"敌人数 ≤ {conditions.EnemyCountBelow.Value}");

        if (conditions.AllyHpBelowPct.HasValue)
            parts.Add($"队友HP < {conditions.AllyHpBelowPct.Value}%");

        return parts.Count > 0 ? string.Join(" 且 ", parts) : "无条件（冷却好就触发）";
    }

    #endregion

    /// <summary>
    /// 公共刷新方法 - 用于外部触发UI更新
    /// Public refresh method - for external UI update trigger
    /// </summary>
    public void Refresh()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        _clearStatusCts?.Cancel();
        _clearStatusCts?.Dispose();
        if (_subscribedInventory != null)
            _subscribedInventory.Changed -= OnInventoryChanged;
    }
}

