@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Services
@inject IGameConfigService GameConfig
@inject ICharacterAttributeService AttributeService
@inject IProfessionAttributeService ProfessionService
@inject ICharacterService CharacterService
@implements IDisposable

<div class="character-detail-card">
    <div class="cd-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">📊</span>
            角色详情 @(character != null ? $"- {character.Name}" : "")
        </h5>
        <button class="btn btn-sm btn-outline-light"
                @onclick:stopPropagation="true"
                @onclick="ToggleCollapse">
            @(isCollapsed ? "展开" : "收起")
        </button>
    </div>

    <div class="cd-body" style="@(isCollapsed ? "display:none" : null)">
        @if (character == null)
        {
            <div class="text-muted">请先选择一个角色...</div>
        }
        else if (isLoading)
        {
            <div class="text-muted">加载配置中...</div>
        }
        else if (calculatedAttrs == null)
        {
            <div class="text-muted">无法计算属性...</div>
        }
        else
        {
            <div class="section">
                <h6 class="section-title">基础属性 (Base Attributes)</h6>
                <div class="stats-grid">
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">@GetMainStatName():</span>
                        <span class="stat-value stat-main">@GetMainStatTotal()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">耐力:</span>
                        <span class="stat-value">@GetStaminaTotal()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">急速等级:</span>
                        <span class="stat-value">@GetHasteRating()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击等级:</span>
                        <span class="stat-value">@GetCritRating()</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">战斗属性 (Combat Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">当前职业:</span>
                        <span class="stat-value">@professionName ⭐ Lv.@currentLevel</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">最大生命值:</span>
                        <span class="stat-value">@character.MaxHp</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">攻击伤害:</span>
                        <span class="stat-value">@character.DamagePerAttack</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">基础攻速:</span>
                        <span class="stat-value">@character.AttackRateAPS.ToString("F2") 次/秒</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击率:</span>
                        <span class="stat-value">@character.CritChancePercent.ToString("F1")% <span class="stat-cap">/ 60%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">急速:</span>
                        <span class="stat-value">@character.HastePercent.ToString("F1")% <span class="stat-cap">/ 40%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击倍率:</span>
                        <span class="stat-value">@character.CritMultiplier.ToString("F1")x</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">伤害浮动:</span>
                        <span class="stat-value">±@((character.VariancePct * 100).ToString("F0"))%</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">技能属性 (Skill Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">技能伤害:</span>
                        <span class="stat-value">@character.SpecialDamage</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">技能间隔:</span>
                        <span class="stat-value">@character.SpecialIntervalSec.ToString("F1") 秒</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">复活时间:</span>
                        <span class="stat-value">@character.ReviveSec.ToString("F1") 秒</span>
                    </div>
                </div>
            </div>

            <div class="section section-dps">
                <h6 class="section-title">输出统计 (DPS Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">期望伤害:</span>
                        <span class="stat-value">@expectedDamage.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">生效攻速:</span>
                        <span class="stat-value">@effectiveAPS.ToString("F2") APS</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">普攻DPS:</span>
                        <span class="stat-value stat-highlight">@basicDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">技能DPS:</span>
                        <span class="stat-value">@skillDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">总DPS:</span>
                        <span class="stat-value stat-total">@totalDPS.ToString("F1")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public CharacterData? Character { get; set; }
    [Parameter] public bool StartCollapsed { get; set; } = true;

    private bool isCollapsed;
    private CharacterData? character;
    private bool isLoading;
    private CalculatedAttributes? calculatedAttrs;
    private string professionName = "";
    private int currentLevel = 1;
    private double expectedDamage;
    private double effectiveAPS;
    private double basicDPS;
    private double skillDPS;
    private double totalDPS;

    protected override async Task OnInitializedAsync()
    {
        isCollapsed = StartCollapsed;
        await GameConfig.EnsureLoadedAsync();
        CharacterService.SelectedCharacterChanged += OnCharacterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        character = Character;
        await RefreshAttributesAsync();
    }

    private async Task RefreshAttributesAsync()
    {
        if (character == null) { calculatedAttrs = null; return; }

        try
        {
            isLoading = true;
            calculatedAttrs = await AttributeService.CalculateAttributesAsync(character);
            if (calculatedAttrs != null)
            {
                var config = await ProfessionService.GetConfigAsync(character.ActiveCombatProfessionId);
                professionName = config?.Name ?? character.ActiveCombatProfessionId;

                if (character.Professions.TryGetValue(character.ActiveCombatProfessionId, out var progress))
                    currentLevel = progress.Level;

                expectedDamage = AttributeCalculator.CalculateExpectedHitDamage(calculatedAttrs);
                effectiveAPS = AttributeCalculator.CalculateEffectiveAPS(calculatedAttrs);
                basicDPS = AttributeCalculator.CalculateBasicDPS(calculatedAttrs);
                skillDPS = AttributeCalculator.CalculateSkillDPS(calculatedAttrs);
                totalDPS = AttributeCalculator.CalculateTotalDPS(calculatedAttrs);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error calculating attributes: {ex.Message}");
            calculatedAttrs = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetMainStatName() => calculatedAttrs?.MainStatName ?? "主属性";
    private int GetMainStatTotal() => calculatedAttrs?.MainStatTotal ?? 0;
    private int GetStaminaTotal() => calculatedAttrs?.StaminaTotal ?? 0;
    private int GetHasteRating() => calculatedAttrs?.HasteRating ?? 0;
    private int GetCritRating() => calculatedAttrs?.CritRating ?? 0;

    private async void OnCharacterChanged(CharacterData? newCharacter)
    {
        character = newCharacter;
        await RefreshAttributesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
    public void Dispose() => CharacterService.SelectedCharacterChanged -= OnCharacterChanged;
}

<style>
    .character-detail-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .cd-header {
        background: linear-gradient(135deg,#764ba2 0%,#667eea 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .cd-header .btn {
            margin-top: 0;
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .cd-body {
        padding: 20px;
    }

    .section {
        margin-bottom: 24px;
    }

    .section-title {
        color: #495057;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #dee2e6;
        font-size: .95rem;
        font-weight: 600;
        letter-spacing: .5px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        gap: 12px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .stat-label {
        color: #6c757d;
        font-size: .9rem;
    }

    .stat-value {
        font-weight: 600;
        color: #212529;
    }

    .highlight-stat {
        background: linear-gradient(135deg,rgba(255,215,0,.1),rgba(255,215,0,.05));
        border-left: 3px solid #FFD700;
    }

    .stat-main {
        color: #FFD700;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .stat-highlight {
        color: #FF6347;
        font-weight: 700;
    }

    .stat-total {
        color: #FF4500;
        font-size: 1.2rem;
        font-weight: 800;
    }

    .stat-cap {
        color: #999;
        font-size: .85rem;
        margin-left: 4px;
    }

    .section-dps {
        background: rgba(255,99,71,.05);
        border-radius: 8px;
        border: 1px solid rgba(255,99,71,.2);
    }

        .section-dps .section-title {
            color: #FF6347;
        }
</style>