@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Services
@inject IGameConfigService GameConfig
@inject ICharacterAttributeService AttributeService
@inject IProfessionAttributeService ProfessionService
@inject ICharacterService CharacterService
@implements IDisposable

<div class="character-detail-card">
    <div class="cd-header">
        <h5 class="mb-0">
            <span class="me-2">📊</span>
            角色详情 @(character != null ? $"- {character.Name}" : "")
        </h5>
    </div>

    <div class="cd-body">
        @if (character == null)
        {
            <div class="text-muted">请先选择一个角色...</div>
        }
        else if (isLoading)
        {
            <div class="text-muted">加载配置中...</div>
        }
        else if (calculatedAttrs == null)
        {
            <div class="text-muted">无法计算属性...</div>
        }
        else
        {
            <!-- 基础属性部分 -->
            <div class="section">
                <h6 class="section-title">基础属性 (Base Attributes)</h6>
                <div class="stats-grid">
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">@GetMainStatName():</span>
                        <span class="stat-value stat-main">@GetMainStatTotal()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">耐力:</span>
                        <span class="stat-value">@GetStaminaTotal()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">急速等级:</span>
                        <span class="stat-value">@GetHasteRating()</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击等级:</span>
                        <span class="stat-value">@GetCritRating()</span>
                    </div>
                </div>
            </div>

            <!-- 战斗属性 -->
            <div class="section">
                <h6 class="section-title">战斗属性 (Combat Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">职业:</span>
                        <span class="stat-value">@professionName ⭐ Lv.@currentLevel</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">最大生命值:</span>
                        <span class="stat-value">@character.MaxHp</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">攻击伤害:</span>
                        <span class="stat-value">@character.DamagePerAttack</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">基础攻速:</span>
                        <span class="stat-value">@character.AttackRateAPS.ToString("F2") 次/秒</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击率:</span>
                        <span class="stat-value">@character.CritChancePercent.ToString("F1")% <span class="stat-cap">/ 60%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">急速:</span>
                        <span class="stat-value">@character.HastePercent.ToString("F1")% <span class="stat-cap">/ 40%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">暴击倍率:</span>
                        <span class="stat-value">@character.CritMultiplier.ToString("F1")x</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">伤害浮动:</span>
                        <span class="stat-value">±@((character.VariancePct * 100).ToString("F0"))%</span>
                    </div>
                </div>
            </div>

            <!-- 技能属性 -->
            <div class="section">
                <h6 class="section-title">技能属性 (Skill Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">技能伤害:</span>
                        <span class="stat-value">@character.SpecialDamage</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">技能间隔:</span>
                        <span class="stat-value">@character.SpecialIntervalSec.ToString("F1") 秒</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">复活时间:</span>
                        <span class="stat-value">@character.ReviveSec.ToString("F1") 秒</span>
                    </div>
                </div>
            </div>

            <!-- DPS统计 -->
            <div class="section section-dps">
                <h6 class="section-title">输出统计 (DPS Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">期望伤害:</span>
                        <span class="stat-value">@expectedDamage.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">生效攻速:</span>
                        <span class="stat-value">@effectiveAPS.ToString("F2") APS</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">普攻DPS:</span>
                        <span class="stat-value stat-highlight">@basicDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">技能DPS:</span>
                        <span class="stat-value">@skillDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">总DPS:</span>
                        <span class="stat-value stat-total">@totalDPS.ToString("F1")</span>
                    </div>
                </div>
            </div>

            <!-- 战斗职业列表 -->
            <div class="section">
                <h6 class="section-title">战斗职业 (Combat Professions)</h6>
                <div class="profession-list">
                    @foreach (var prof in combatProfessions)
                    {
                        var progress = character.Professions.GetValueOrDefault(prof.Id);
                        var isActive = character.ActiveCombatProfessionId == prof.Id;
                        
                        <div class="profession-detail @(isActive ? "active" : "")">
                            <div class="prof-name">
                                @prof.Name
                                @if (isActive)
                                {
                                    <span class="badge bg-success ms-2">激活</span>
                                }
                            </div>
                            @if (progress != null)
                            {
                                <div class="prof-progress">
                                    <span>等级 @progress.Level <small class="text-muted">(Max: @GameConfig.MaxProfessionLevel)</small></span>
                                    <span class="exp-info">经验: @progress.Experience / @progress.ExperienceToNext</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" 
                                         role="progressbar" 
                                         style="width: @(GetExpPercentage(progress))%">
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 非战斗职业列表 -->
            <div class="section">
                <h6 class="section-title">非战斗职业 (Non-Combat Professions)</h6>
                <div class="profession-list">
                    @foreach (var prof in nonCombatProfessions)
                    {
                        var progress = character.Professions.GetValueOrDefault(prof.Id);
                        
                        <div class="profession-detail">
                            <div class="prof-name">@prof.Name</div>
                            @if (progress != null)
                            {
                                <div class="prof-progress">
                                    <span>等级 @progress.Level <small class="text-muted">(Max: @GameConfig.MaxProfessionLevel)</small></span>
                                    <span class="exp-info">经验: @progress.Experience / @progress.ExperienceToNext</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" 
                                         role="progressbar" 
                                         style="width: @(GetExpPercentage(progress))%">
                                    </div>
                                </div>
                            }
                            <div class="prof-note">
                                <small class="text-muted">未来将解锁采集点和配方</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public CharacterData? Character { get; set; }

    private CharacterData? character;
    private List<ProfessionDef> combatProfessions = new();
    private List<ProfessionDef> nonCombatProfessions = new();
    private bool isLoading = false;
    
    // 计算属性
    private CalculatedAttributes? calculatedAttrs;
    private string professionName = "";
    private int currentLevel = 1;
    
    // DPS统计
    private double expectedDamage = 0;
    private double effectiveAPS = 0;
    private double basicDPS = 0;
    private double skillDPS = 0;
    private double totalDPS = 0;

    protected override async Task OnInitializedAsync()
    {
        await GameConfig.EnsureLoadedAsync();
        combatProfessions = GameConfig.Professions
            .Where(p => p.Type == ProfessionType.Combat)
            .ToList();
        nonCombatProfessions = GameConfig.Professions
            .Where(p => p.Type == ProfessionType.NonCombat)
            .ToList();
        
        // Subscribe to character change events for real-time updates
        CharacterService.SelectedCharacterChanged += OnCharacterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        character = Character;
        await RefreshAttributesAsync();
    }

    private async Task RefreshAttributesAsync()
    {
        if (character == null)
        {
            calculatedAttrs = null;
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            // 计算属性
            calculatedAttrs = await AttributeService.CalculateAttributesAsync(character);

            if (calculatedAttrs != null)
            {
                // 获取职业名称
                var config = await ProfessionService.GetConfigAsync(character.ActiveCombatProfessionId);
                professionName = config?.Name ?? GetProfessionName(character.ActiveCombatProfessionId);

                // 获取当前等级
                if (character.Professions.TryGetValue(character.ActiveCombatProfessionId, out var progress))
                {
                    currentLevel = progress.Level;
                }

                // 计算DPS统计
                expectedDamage = AttributeCalculator.CalculateExpectedHitDamage(calculatedAttrs);
                effectiveAPS = AttributeCalculator.CalculateEffectiveAPS(calculatedAttrs);
                basicDPS = AttributeCalculator.CalculateBasicDPS(calculatedAttrs);
                skillDPS = AttributeCalculator.CalculateSkillDPS(calculatedAttrs);
                totalDPS = AttributeCalculator.CalculateTotalDPS(calculatedAttrs);
            }
        }
        catch (Exception ex)
        {
            // Log error but don't crash the component
            System.Diagnostics.Debug.WriteLine($"Error calculating attributes: {ex.Message}");
            calculatedAttrs = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public async Task RefreshAsync()
    {
        await RefreshAttributesAsync();
    }

    private double GetExpPercentage(ProfessionProgress progress)
    {
        if (progress.ExperienceToNext <= 0) return 100;
        return Math.Min(100, (progress.Experience * 100.0) / progress.ExperienceToNext);
    }

    private string GetProfessionName(string profId)
    {
        var prof = combatProfessions.FirstOrDefault(p => p.Id == profId) 
                   ?? nonCombatProfessions.FirstOrDefault(p => p.Id == profId);
        return prof?.Name ?? profId;
    }

    // Attribute display helpers
    private string GetMainStatName()
    {
        if (calculatedAttrs == null) return "主属性";
        return !string.IsNullOrEmpty(calculatedAttrs.MainStatName) 
            ? calculatedAttrs.MainStatName 
            : "主属性";
    }

    private int GetMainStatTotal()
    {
        return calculatedAttrs?.MainStatTotal ?? 0;
    }

    private int GetStaminaTotal()
    {
        return calculatedAttrs?.StaminaTotal ?? 0;
    }

    private int GetHasteRating()
    {
        return calculatedAttrs?.HasteRating ?? 0;
    }

    private int GetCritRating()
    {
        return calculatedAttrs?.CritRating ?? 0;
    }

    // Event handler for character changes (e.g., from level-ups during combat)
    private async void OnCharacterChanged(CharacterData? newCharacter)
    {
        character = newCharacter;
        await RefreshAttributesAsync();
        await InvokeAsync(StateHasChanged);
    }

    // IDisposable implementation
    public void Dispose()
    {
        // Unsubscribe from events to prevent memory leaks
        CharacterService.SelectedCharacterChanged -= OnCharacterChanged;
    }
}

<style>
    .character-detail-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .cd-header {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        color: #fff;
        padding: 12px 16px;
    }

    .cd-body {
        padding: 20px;
    }

    .section {
        margin-bottom: 24px;
    }

    .section:last-child {
        margin-bottom: 0;
    }

    .section-title {
        color: #495057;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #dee2e6;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .stat-value {
        font-weight: 600;
        color: #212529;
    }

    .profession-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .profession-detail {
        padding: 12px;
        background: #f8f9fa;
        border-radius: 6px;
        border: 1px solid #dee2e6;
    }

    .profession-detail.active {
        background: #f0fff4;
        border-color: #28a745;
    }

    .prof-name {
        font-weight: 600;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
    }

    .prof-progress {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 6px;
    }

    .exp-info {
        font-size: 0.8rem;
    }

    .prof-note {
        margin-top: 6px;
    }

    /* New attribute system styles */
    .highlight-stat {
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(255, 215, 0, 0.05));
        border-left: 3px solid #FFD700;
    }

    .stat-main {
        color: #FFD700;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .stat-highlight {
        color: #FF6347;
        font-weight: 700;
    }

    .stat-total {
        color: #FF4500;
        font-size: 1.2rem;
        font-weight: 800;
    }

    .stat-cap {
        color: #999;
        font-size: 0.85rem;
        margin-left: 4px;
    }

    .section-dps {
        background: rgba(255, 99, 71, 0.05);
        border-radius: 8px;
        border: 1px solid rgba(255, 99, 71, 0.2);
    }

    .section-dps .section-title {
        color: #FF6347;
    }
</style>
