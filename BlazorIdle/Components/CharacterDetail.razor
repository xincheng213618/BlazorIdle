@using BlazorIdle.Shared.Models
@using BlazorIdle.Shared.Game
@using BlazorIdle.Game.Config
@using BlazorIdle.Game.Combat
@using BlazorIdle.Game.Professions
@using BlazorIdle.Services
@inject IGameConfigService GameConfig
@inject ICharacterAttributeService AttributeService
@inject IProfessionAttributeService ProfessionService
@inject ICharacterService CharacterService
@implements IDisposable

<div class="character-detail-card">
    <div class="cd-header d-flex align-items-center justify-content-between"
         role="button"
         @onclick="ToggleCollapse"
         aria-expanded="@(!isCollapsed)">
        <h5 class="mb-0 text-white d-flex align-items-center">
            <span class="me-2">📊</span>
            角色详情 @(character != null ? $"- {character.Name}" : "")
        </h5>
        <button class="btn btn-sm btn-outline-light"
                @onclick:stopPropagation="true"
                @onclick="ToggleCollapse">
            @(isCollapsed ? "展开" : "收起")
        </button>
    </div>

    <div class="cd-body" style="@(isCollapsed ? "display:none" : null)">
        @if (character == null)
        {
            <div class="text-muted">请先选择一个角色...</div>
        }
        else if (isLoading)
        {
            <div class="text-muted">加载配置中...</div>
        }
        else if (calculatedAttrs == null)
        {
            <div class="text-muted">无法计算属性...</div>
        }
        else
        {
            <div class="section">
                <h6 class="section-title">职业信息 (Profession Info)</h6>
                <div class="stats-grid">
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">当前职业:</span>
                        <span class="stat-value stat-main">@professionName</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">职业等级:</span>
                        <span class="stat-value">Lv.@currentLevel</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">职业描述:</span>
                        <span class="stat-value">@professionDescription</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">汇总属性 (Final Stats) <small class="text-muted">= 职业基础 + 装备加成</small></h6>
                <div class="stats-grid">
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">⚔️ 最终攻击力:</span>
                        <span class="stat-value stat-main">@finalStats.AttackFinal</span>
                    </div>
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">❤️ 最大生命值:</span>
                        <span class="stat-value stat-main">@finalMaxHp</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">⚡ 最终攻速:</span>
                        <span class="stat-value">@finalAttackRate.ToString("F2") 次/秒</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">🎯 暴击率:</span>
                        <span class="stat-value">@finalStats.CritChancePercent.ToString("F1")% <span class="stat-cap">/ @combatCaps.CritChancePct%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">💥 暴击伤害加成:</span>
                        <span class="stat-value">+@finalStats.CritDamageBonusPercent.ToString("F1")% <span class="stat-cap">/ @combatCaps.CritDamageBonusPct%</span></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">💨 急速:</span>
                        <span class="stat-value">@finalStats.HastePercent.ToString("F1")% <span class="stat-cap">/ @combatCaps.HastePct%</span></span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">战斗加成 (Combat Bonuses)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">攻击加成%:</span>
                        <span class="stat-value">+@finalStats.AttackPercent.ToString("F1")%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">特攻加成%:</span>
                        <span class="stat-value">+@finalStats.SpecialAttackPercent.ToString("F1")%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">生命加成%:</span>
                        <span class="stat-value">+@finalStats.HPPercent.ToString("F1")%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">减伤%:</span>
                        <span class="stat-value">@finalStats.DamageReductionPercent.ToString("F1")%</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">态势与追击 (Stance & Chase)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">🔥 盛体态势:</span>
                        <span class="stat-value">@finalStats.FortifyMaxPercent.ToString("F1")% <small class="text-muted">(HP≥75%)</small></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">💧 背水意志:</span>
                        <span class="stat-value">@finalStats.BackwaterMaxPercent.ToString("F1")% <small class="text-muted">(HP≤50%)</small></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">追击%:</span>
                        <span class="stat-value">+@finalStats.ChasePercent.ToString("F1")%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">克制追击%:</span>
                        <span class="stat-value">+@finalStats.KenChasePercent.ToString("F1")%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">固定追击:</span>
                        <span class="stat-value">+@finalStats.ChaseFlat</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="section-title">其他属性 (Other Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">伤害浮动:</span>
                        <span class="stat-value">±@((professionBaseStats.Variance * 100).ToString("F0"))%</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">复活时间:</span>
                        <span class="stat-value">@professionBaseStats.ReviveSec.ToString("F1") 秒</span>
                    </div>
                </div>
            </div>

            <div class="section section-dps">
                <h6 class="section-title">输出统计 (DPS Stats)</h6>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-label">期望伤害:</span>
                        <span class="stat-value">@expectedDamage.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">生效攻速:</span>
                        <span class="stat-value">@effectiveAPS.ToString("F2") APS</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">普攻DPS:</span>
                        <span class="stat-value stat-highlight">@basicDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">技能DPS:</span>
                        <span class="stat-value">@skillDPS.ToString("F1")</span>
                    </div>
                    <div class="stat-item highlight-stat">
                        <span class="stat-label">总DPS:</span>
                        <span class="stat-value stat-total">@totalDPS.ToString("F1")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public CharacterData? Character { get; set; }
    [Parameter] public bool StartCollapsed { get; set; } = true;

    private bool isCollapsed;
    private CharacterData? character;
    private bool isLoading;
    private CalculatedAttributes? calculatedAttrs;
    private string professionName = "";
    private string professionDescription = "";
    private int currentLevel = 1;
    private double expectedDamage;
    private double effectiveAPS;
    private double basicDPS;
    private double skillDPS;
    private double totalDPS;
    
    // 新属性系统
    private CombatStats finalStats = new();
    private int finalMaxHp = 0;
    private double finalAttackRate = 0;
    private ProfessionBaseStats professionBaseStats = new();
    private CombatCapsConfig combatCaps = new();

    protected override async Task OnInitializedAsync()
    {
        isCollapsed = StartCollapsed;
        await GameConfig.EnsureLoadedAsync();
        combatCaps = CombatConfigRepository.LoadCombatCaps();
        CharacterService.SelectedCharacterChanged += OnCharacterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        character = Character;
        await RefreshAttributesAsync();
    }

    private async Task RefreshAttributesAsync()
    {
        if (character == null) { calculatedAttrs = null; return; }

        try
        {
            isLoading = true;
            
            // 获取职业配置
            var profConfig = ProfessionStatsRepository.Shared.GetProfession(character.ActiveCombatProfessionId);
            professionName = profConfig?.Name ?? character.ActiveCombatProfessionId;
            professionDescription = profConfig?.Description ?? "";
            professionBaseStats = profConfig?.BaseStats ?? ProfessionBaseStats.CreateDefault();
            
            if (character.Professions.TryGetValue(character.ActiveCombatProfessionId, out var progress))
                currentLevel = progress.Level;

            // 使用新的 CharacterStatsCalculator 计算最终属性
            var calculator = CharacterStatsCalculator.CreateDefault();
            finalStats = calculator.CalculateFinalStats(character.ActiveCombatProfessionId, null); // TODO: 传入装备配置
            finalMaxHp = calculator.CalculateFinalMaxHp(character.ActiveCombatProfessionId, null);
            finalAttackRate = calculator.CalculateFinalAttackRate(character.ActiveCombatProfessionId, null);

            // 计算旧系统属性（用于DPS计算的兼容）
            calculatedAttrs = await AttributeService.CalculateAttributesAsync(character);
            if (calculatedAttrs != null)
            {
                expectedDamage = AttributeCalculator.CalculateExpectedHitDamage(calculatedAttrs);
                effectiveAPS = AttributeCalculator.CalculateEffectiveAPS(calculatedAttrs);
                basicDPS = AttributeCalculator.CalculateBasicDPS(calculatedAttrs);
                skillDPS = AttributeCalculator.CalculateSkillDPS(calculatedAttrs);
                totalDPS = AttributeCalculator.CalculateTotalDPS(calculatedAttrs);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error calculating attributes: {ex.Message}");
            calculatedAttrs = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async void OnCharacterChanged(CharacterData? newCharacter)
    {
        character = newCharacter;
        await RefreshAttributesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
    public void Dispose() => CharacterService.SelectedCharacterChanged -= OnCharacterChanged;
}

<style>
    .character-detail-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .cd-header {
        background: linear-gradient(135deg,#764ba2 0%,#667eea 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .cd-header .btn {
            margin-top: 0;
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .cd-body {
        padding: 20px;
    }

    .section {
        margin-bottom: 24px;
    }

    .section-title {
        color: #495057;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #dee2e6;
        font-size: .95rem;
        font-weight: 600;
        letter-spacing: .5px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        gap: 12px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .stat-label {
        color: #6c757d;
        font-size: .9rem;
    }

    .stat-value {
        font-weight: 600;
        color: #212529;
    }

    .highlight-stat {
        background: linear-gradient(135deg,rgba(255,215,0,.1),rgba(255,215,0,.05));
        border-left: 3px solid #FFD700;
    }

    .stat-main {
        color: #FFD700;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .stat-highlight {
        color: #FF6347;
        font-weight: 700;
    }

    .stat-total {
        color: #FF4500;
        font-size: 1.2rem;
        font-weight: 800;
    }

    .stat-cap {
        color: #999;
        font-size: .85rem;
        margin-left: 4px;
    }

    .section-dps {
        background: rgba(255,99,71,.05);
        border-radius: 8px;
        border: 1px solid rgba(255,99,71,.2);
    }

        .section-dps .section-title {
            color: #FF6347;
        }
</style>