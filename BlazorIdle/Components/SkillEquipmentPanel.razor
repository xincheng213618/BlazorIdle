    }

    .skill-item-main {
        flex: 1;
        min-width: 0;
    }

    .skill-item-name {
        font-weight: 500;
        color: #333;
        font-size: 0.9rem;
        margin-bottom: 2px;
    }

    .skill-item-info {
        font-size: 0.75rem;
        color: #666;
    }

    .skill-item-status {
        flex-shrink: 0;
    }

    .no-skills-message {
        text-align: center;
