        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .se-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: #fff;
        padding: 12px 16px;
        cursor: pointer;
    }

        .se-header .btn {
            margin-top: 0;
            padding: .25rem .5rem;
            line-height: 1.2;
            border: 1px solid rgba(255,255,255,.5);
        }

    .se-body {
        padding: 20px;
    }

    /* 分栏布局 */
    .se-split {
        display: flex;
        gap: 16px;
        min-height: 400px;
    }

    .se-left {
        width: 38%;
        min-width: 280px;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px;
        background: #fcfcfd;
        display: flex;
        flex-direction: column;
        max-height: 70vh;
        overflow: hidden;
    }

    .se-right {
        flex: 1;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 16px;
        background: #fff;
        overflow-y: auto;
        max-height: 70vh;
    }

    /* Left panel scrolling */
    .skill-categories {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    /* Category tabs */
    .category-tabs {
        display: flex;
        gap: 8px;
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fcfcfd;
        padding-bottom: 8px;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .cat-tab {
        flex: 1;
        padding: 8px 12px;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .cat-tab:hover {
            border-color: #2196F3;
