        display: flex;
        align-items: center;
        gap: 8px;
    }

    .skill-icon-small {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }

        .skill-icon-small.passive {
            background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
        }

    .skill-name-small {
        flex: 1;
        font-weight: 500;
        color: #333;
        font-size: 0.9rem;
    }

    .btn-unequip {
